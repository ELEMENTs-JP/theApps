@using theInfrastructure
@inject ISqlDatabaseService sql

<div class="border rounded-2 p-3 my-3">
    <h4 class="border-bottom fw-bold">Erstellen</h4>
    <div class="row p-1 align-items-center">
        <div class="col-3 p-1">
            <strong>Title</strong>
        </div>
        <div class="col-6 p-1">
            <input class="form-control" @bind="@Title" />
        </div>
        <div class="col-3 p-1">
            <button class="btn btn-primary" @onclick="@( async e => { await Context.Create(this.Title); await Context.Search(); })">
                erstellen
            </button>
        </div>
    </div>
</div>



@if (Context.Items.Any())
{
    <div class="border rounded-2 p-3 my-3">
        <div class="row g-0">
            <div class="col">
                <h4 class="border-bottom fw-bold">Items</h4>
            </div>
            <div class="col-auto px-2">
                <button class="btn btn-primary" @onclick="Load">laden</button>
            </div>
        </div>

        <div class="row p-1 align-items-center">
            <div class="col-6 p-1 ms-auto me-auto">
                <input class="form-control" @bind="@Matchcode" @oninput="Load" />
            </div>
        </div>

        @foreach (IDTO dto in Context.Items)
        {
            <div class="row p-1 border-bottom align-items-center">
                <div class="col-auto p-1">
                    <button class="btn btn-primary" @onclick="@( async e => { await Select(dto); })">...</button>
                </div>
                <div class="col-auto p-1">
                    @dto.ID.ToSecureString()
                </div>
                <div class="col p-1">
                    <input class="form-control form-control-flush" @bind="@dto.Title" />
                </div>
                <div class="col-auto p-1">
                    <button class="btn btn-sm"
                            @onclick="@( async e => { await Context.Update(dto); await Context.Search(); })">
                        Update
                    </button>
                </div>
                @if (Context.Item != null && Context.Item.GUID != dto.GUID)
                {
                    <div class="col-auto p-1">
                        <button class="btn btn-sm" @onclick="@( async e => { await Assign(dto); })">Assign</button>
                    </div>
                }
                <div class="col-auto p-1">
                    <button class="btn btn-sm" @onclick="@( async e => { await Context.Delete(dto); await Context.Search(); })">X</button>
                </div>
            </div>
        }
    </div>
}

@if (Context.Item != null)
{
    <div class="border rounded-2 p-3 my-3">

        <h4 class="border-bottom fw-bold">Bearbeiten</h4>
        <div class="row p-1 align-items-center">
            <div class="col-4 p-1">
                <input class="form-control" @bind="@Context.Item.Title" />
            </div>
            <div class="col-2 p-1">
                <input class="form-control"
                       @bind:get="@(Context.Item["Title"].ToString() ?? string.Empty)"
                       @bind:set="@(val => Context.Item["Title"] = val)" />
            </div>
            <div class="col-2 p-1">
                <input class="form-control"
                       @bind:get="@(Context.Item["Description"].ToString() ?? string.Empty)"
                       @bind:set="@(val => Context.Item["Description"] = val)" />
            </div>
            <div class="col-2 p-1">
                <input class="form-control"
                       @bind:get="@(Context.Item["Status"].ToString() ?? string.Empty)"
                       @bind:set="@(val => Context.Item["Status"] = val)" />
            </div>
            <div class="col-2 p-1">
                    <button class="btn btn-primary" @onclick="@(async e => {
                                await Context.Update(Context.Item);
                                await Context.Search();
                            })">
                    Speichern
                </button>
            </div>
        </div>
    </div>
}


@if (RelatedItems.Any())
{
    <div class="border rounded-2 p-3 my-3">

        <h4 class="border-bottom fw-bold">Related Items</h4>
        @foreach (IDTO dto in RelatedItems)
        {
            <div class="row p-1 border-bottom align-items-center">
                <div class="col-auto p-1">
                    @dto.ID.ToSecureString()
                </div>
                <div class="col p-1">
                    <input class="form-control form-control-flush" @bind="@dto.Title" />
                </div>
                <div class="col-auto p-1">
                    <button class="btn btn-sm"
                            @onclick="@(async e => {
                                await Context.Update(dto);
                                await Context.Search();
                            })">
                        Update
                    </button>
                </div>
                <div class="col-auto p-1">
                    <button class="btn btn-sm" @onclick="@( async e => { await Remove(dto); })">Remove</button>
                </div>
                <div class="col-auto p-1">
                    <button class="btn btn-sm" @onclick="@(async e => {
                                await Context.Delete(dto);
                                await Context.Search();
                            })">
                        X
                    </button>
                </div>
            </div>
        }
    </div>
}


@code
{
    [Parameter]
    public IQueryContext Context { get; set; }

    List<IDTO> RelatedItems { get; set; } = new();

    private string Title { get; set; }
    private string Matchcode { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        Context = new QueryContext(sql);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            await Context.Search();
            this.StateHasChanged();
        }
    }

    private async Task Select(IDTO dto)
    {
        Context.Item = dto;
        await LoadRelatedItems();
    }

    private async Task Load()
    {
        await Context.Search();    
    }

    private async Task LoadRelatedItems()
    {
        RelatedItems.Clear();

        if (Context.Item != null)
        {
            IQueryParameter query = new QueryParameter();
            IQueryResult result = await sql.GetRelatedItems(Context.Item);
            RelatedItems = result.Items;
        }
    }
    private async Task Assign(IDTO dto)
    {
        if (Context.Item != null)
        {
            IQueryResult result = await sql.Assign(Context.Item, dto);
            await LoadRelatedItems();
        }
    }
    private async Task Remove(IDTO dto)
    {
        if (Context.Item != null)
        {
            IQueryResult result = await sql.Remove(Context.Item, dto);
            await LoadRelatedItems();
        }
    }
}
