@using theComponents.Edit
@inject ISqlDatabaseService sql

@if (ItemType != null)
{
    @if (Context != null)
    {
        <EditArea ItemType="@this.ItemType" ID="@ID" />

        <div class="my-3"></div>

        <div class="row g-2">
            @foreach (string group in ItemTypeGroups)
            {
                <div class="@( ((ItemTypeGroups.Count() == 1) ? " col-12 " : " col-xl-6 col-12 ") )">
                    <RelatedItemsComp Title="@group" ItemTypes="@( ItemTypes.Where(se => se.Group == group).ToList())"
                                      RelatedItem="@RelatedItem" />
                </div>
            }
        </div>
    }
}



@code {

    [Parameter]
    public string ID { get; set; } = string.Empty;

    [Parameter]
    public IItemType ItemType { get; set; } = null;

    private List<IItemType> ItemTypes { get; set; } = new();
    private List<string> ItemTypeGroups { get; set; } = new();

    private IQueryContext Context { get; set; } = null;
    private IQueryContext RelatedContext { get; set; } = null;
    private IDTO RelatedItem { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (ItemType != null)
        {
            ItemTypes = await ItemType.GetItemTypes();
            ItemTypeGroups = ItemTypes.Select(se => se.Group).Distinct().ToList();
        }

        if (!string.IsNullOrEmpty(this.ID))
        {
            Context = new QueryContext(sql);
            Context.ItemType = ItemType;
            await Context.Load(this.ID);

            RelatedItem = Context.Item;
        }
    }
}
