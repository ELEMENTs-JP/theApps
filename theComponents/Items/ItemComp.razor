@using theComponents.Edit
@inject ISqlDatabaseService sql

@if (ItemType != null)
{
    @if (Context != null)
    {


        <div class="row g-0">
            <div class="col-7 p-2">
                <EditArea ItemType="@this.ItemType" ID="@ID" />
            </div>
            <div class="col-5 p-2">

         
                            <RelatedItemsComp ItemTypes="@( ItemTypes.FirstOrDefault(se => se.Key == AssociationTyp.Parents).Value.ToList())"
                                    RelatedItem="@RelatedItem" Association="AssociationTyp.Parents" />
                <div class="my-3"></div>
            
                            <RelatedItemsComp ItemTypes="@( ItemTypes.FirstOrDefault(se => se.Key == AssociationTyp.Parallels).Value.ToList())"
                                              RelatedItem="@RelatedItem" Association="AssociationTyp.Parallels" />
                <div class="my-3"></div>
          
                            <RelatedItemsComp ItemTypes="@( ItemTypes.FirstOrDefault(se => se.Key == AssociationTyp.Related).Value.ToList())"
                                              RelatedItem="@RelatedItem" Association="AssociationTyp.Related" />
              

            </div>
        </div>

        <div class="row g-0">
            <div class="col-7 p-2">
          
                            <RelatedItemsComp ItemTypes="@( ItemTypes.FirstOrDefault(se => se.Key == AssociationTyp.Children).Value.ToList())"
                                              RelatedItem="@RelatedItem" Association="AssociationTyp.Children" />
               
                                              <div class="my-3"></div>
           
                            <RelatedItemsComp ItemTypes="@( ItemTypes.FirstOrDefault(se => se.Key == AssociationTyp.Default).Value.ToList())"
                                              RelatedItem="@RelatedItem" Association="AssociationTyp.Default" />
                 
            </div>
            <div class="col-5 p-2">
              
            </div>
        </div>

     
    }
}



@code {

    [Parameter]
    public string ID { get; set; } = string.Empty;


    private IDTO RelatedItem { get; set; }

    [Parameter]
    public IItemType ItemType { get; set; } = null;

    private List<KeyValuePair<AssociationTyp, List<IItemType>>> ItemTypes { get; set; } = new();
    private List<string> ItemTypeGroups { get; set; } = new();

    private IQueryContext Context { get; set; } = null;
    private IQueryContext RelatedContext { get; set; } = null;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (ItemType != null)
        {
            // Clear 
            ItemTypes.Clear();

            // List 
            List<IItemType> its = await ItemType.GetItemTypes(AssociationTyp.Default);
            ItemTypes.Add(new KeyValuePair<AssociationTyp, List<IItemType>>(AssociationTyp.Default, its));

            its = await ItemType.GetItemTypes(AssociationTyp.Children);
            ItemTypes.Add(new KeyValuePair<AssociationTyp, List<IItemType>>(AssociationTyp.Children, its));

            its = await ItemType.GetItemTypes(AssociationTyp.Parallels);
            ItemTypes.Add(new KeyValuePair<AssociationTyp, List<IItemType>>(AssociationTyp.Parallels, its));

            its = await ItemType.GetItemTypes(AssociationTyp.Parents);
            ItemTypes.Add(new KeyValuePair<AssociationTyp, List<IItemType>>(AssociationTyp.Parents, its));

            its = await ItemType.GetItemTypes(AssociationTyp.Related);
            ItemTypes.Add(new KeyValuePair<AssociationTyp, List<IItemType>>(AssociationTyp.Related, its));
        }

        if (!string.IsNullOrEmpty(this.ID))
        {
            Context = new QueryContext(sql);
            Context.ItemType = ItemType;
            await Context.Load(this.ID);

            RelatedItem = Context.Item;
        }
    }
}
