@using theComponents.Add
@using theControls.Calendar
@using theControls.Elements
@inherits BaseList

<div class="bg-surface p-2 rounded-2">

    <div class="row d-flex align-items-center px-2 pb-2">

        <div class="col-auto">
            <div class="hover pointer rounded-2 p-1"
                 @onclick="PreMonth">
                <i class="ti ti-chevron-left text-muted"></i>
            </div>
        </div>

        <div class="col-auto px-2">
            <strong class="fw-bold">@(CurrentDate.Date.ToString("MMMM") + " " + CurrentDate.Date.Year.ToSecureString())</strong>
        </div>
        <div class="col-auto">
            <div class="hover pointer rounded-2 p-1"
                 @onclick="NextMonth">
                <i class="ti ti-chevron-right text-muted"></i>
            </div>
        </div>

        @if (DateTime.Now.Date != CurrentDate.Date)
        {
            <div class="col-auto px-2">
                <div class="hover pointer rounded-2 p-1"
                     @onclick="SetToday">
                    <small class="text-muted">Heute</small>
                </div>
            </div>
        }

        @if (RelatedContent.HasContent())
        {
            @RelatedContent
        }

        <div class="col-auto ms-auto px-2">
            <AddArea ItemType="@ItemType" />
        </div>
    </div>

    <div class="row g-0 seven-cols border-top">

        <div class="col-md-1 p-2 border-bottom border-end fw-bold border-start">Mo</div>
        <div class="col-md-1 p-2 border-bottom border-end fw-bold">Di</div>
        <div class="col-md-1 p-2 border-bottom border-end fw-bold">Mi</div>
        <div class="col-md-1 p-2 border-bottom border-end fw-bold">Do</div>
        <div class="col-md-1 p-2 border-bottom border-end fw-bold">Fr</div>
        <div class="col-md-1 p-2 border-bottom border-end fw-bold">Sa</div>
        <div class="col-md-1 p-2 border-bottom border-end fw-bold">So</div>
    </div>

    <div class="row g-0 seven-cols border-start">

        @foreach (DateTime date in DatesInMonth)
        {
            if (date.DayOfWeek == DayOfWeek.Saturday || date.DayOfWeek == DayOfWeek.Sunday)
            {
                // Samstag // Sonntag
                <div class="col-md-1 p-2 border-bottom border-end border-hover">
                    <CalendarDayComp OnItemAdded="OnItemAdded"
                                     OnItemDeleted="OnItemDeleted"
                                     Date="@date" Context="@Context" ItemType="@ItemType" />
                </div>
            }
            else if (date.Month != CurrentDate.Month)
            {
                // anderer Monat
                <div class="col-md-1 p-2 border-bottom border-end border-hover">
                    <CalendarDayComp OnItemAdded="OnItemAdded"
                                     OnItemDeleted="OnItemDeleted"
                                     Date="@date" Context="@Context" ItemType="@ItemType" />
                </div>
            }
            else
            {
                // aktueller Monat
                <div class="col-md-1 p-2 border-bottom border-end border-hover" style="@ControlStyle">
                    <CalendarDayComp OnItemAdded="OnItemAdded"
                                     OnItemDeleted="OnItemDeleted"
                                     Date="@date" Context="@Context" ItemType="@ItemType" />
                </div>
            }
        }

    </div>
</div>

@code {

    private string ControlStyle = "";

    [Parameter]
    public DateTime CurrentDate { get; set; } = DateTime.Now.Date;

    [Parameter]
    public List<IDTO> Store { get; set; } = new List<IDTO>();

    private List<DateTime> DatesInMonth = new List<DateTime>();

    [Parameter]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public RenderFragment RelatedContent { get; set; }


    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        DatesInMonth = Helper.GetDates(CurrentDate.Year, CurrentDate.Month);
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }

    [Parameter]
    public EventCallback<IDTO> OnItemAdded { get; set; }

    [Parameter]
    public EventCallback<IDTO> OnItemDeleted { get; set; }

    [Parameter]
    public EventCallback<DateTime> OnNextMonth { get; set; }
    [Parameter]
    public EventCallback<DateTime> OnSetToday { get; set; }
    [Parameter]
    public EventCallback<DateTime> OnPreMonth { get; set; }

    private async Task NextMonth()
    {
        CurrentDate = CurrentDate.AddMonths(1);

        DatesInMonth = Helper.GetDates(CurrentDate.Year, CurrentDate.Month);

        await OnNextMonth.InvokeAsync(CurrentDate);
    }
    private async Task PreMonth()
    {
        CurrentDate = CurrentDate.AddMonths(-1);

        DatesInMonth = Helper.GetDates(CurrentDate.Year, CurrentDate.Month);

        await OnPreMonth.InvokeAsync(CurrentDate);
    }
    private async Task SetToday()
    {
        CurrentDate = DateTime.Now.Date;

        DatesInMonth = Helper.GetDates(CurrentDate.Year, CurrentDate.Month);

        await OnSetToday.InvokeAsync(CurrentDate);
    }

}
