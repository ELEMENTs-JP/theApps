@using theComponents.Add
@using theControls.Add
@using theControls.Connect
@using theControls.Layout
@using theControls.List
@using theControls.Tables
@inject ISqlDatabaseService sql

@if (RelatedItem != null)
{
    <Frame Border="true" Rounded="true">
        <Header>
            @if (ItemType != null)
            {
                <h3 class="h3">@ItemType.Name</h3>
            }
        </Header>
        <Related>
            <div class="hstack">
                <ConnectComp ItemType="@ItemType" RelatedItem="@RelatedItem" />
                <div class="vr mx-2"></div>
                <AddArea ItemType="@ItemType" RelatedItem="@RelatedItem" />
            </div>
        </Related>
        <Content>
            <ItemsList ItemType="@ItemType" RelatedItem="@RelatedItem" />
        </Content>
    </Frame>
}

 

@code {


    [Parameter]
    public IItemType ItemType { get; set; }

    [Parameter]
    public IDTO RelatedItem { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            // this.StateHasChanged();
        }
    }
}
