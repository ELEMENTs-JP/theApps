@using theControls.Input

<DropDown Label="Währung" Items="Items" 
    Value="@( Text )" ValueChanged="@( e => { Value = e;  } )"
        ItemChanged="@( async e => { await ValueChanged.InvokeAsync(e); } )" />

@code {

    List<IDTO> Items { get; set; } = new();
    string Text { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        Items.Clear();
        Items.Add(new DTO { ID = "EUR", Title = "EUR" });
        Items.Add(new DTO { ID = "USD", Title = "USD" });
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        Text = string.Empty;

        if (Items == null)
            return;

        IDTO se = Items.Where(se => se.ID == Value).FirstOrDefault();
        if (se == null)
            return;

        Text = se.Title;    
    }

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<IDTO> ValueChanged { get; set; }
 }
