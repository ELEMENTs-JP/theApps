    // new("Afrika", "https://www.tagesschau.de/ausland/afrika/index~rss2.xml"),
    // new("Asien", "https://www.tagesschau.de/ausland/asien/index~rss2.xml"),
    // new("Ozeanien", "https://www.tagesschau.de/ausland/ozeanien/index~rss2.xml"),
    // new("Verbraucher", "https://www.tagesschau.de/wirtschaft/verbraucher/index~rss2.xml"),
