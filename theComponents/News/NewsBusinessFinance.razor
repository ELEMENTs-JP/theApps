@using System.Xml.Linq
@using System.Globalization
@inject IHttpClientFactory HttpClientFactory
@inherits BaseCtl
@implements IWidget

<div class="container my-2">
  
    @if (isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Lade Nachrichten aus @currentSourcesCount Quellen...</p>
        </div>
    }

    @if (filteredArticles != null)
    {
        <div class="my-2">
            <div class="d-flex justify-content-between align-items-center my-2">
                <h1 class="">@selectedTheme?.Name</h1>
     
            </div>

            <div class="list-group list-group-flush border-top overflow-y-auto" style="max-height:32rem;">
                @foreach (var item in filteredArticles)
                {
                    <div class="row g-0 p-2 border-bottom align-items-center hover pointer "
                        @onclick="@( async e => { await OpenInNewTab(item.Link); })">
                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                        {
                            <div class="col-auto me-3" style="width: 90px;">
                                <div class="ratio ratio-4x3">
                                    <img src="@item.ImageUrl"
                                         class="rounded object-fit-cover"
                                         alt="@item.Title"
                                         loading="lazy" />
                                </div>
                            </div>
                        }

                        <div class="col">
                            <div class="d-flex align-items-center mb-1">
                                <span class="badge @GetSourceBadgeClass(item.Source) me-2">@item.Source</span>
                                <span class="text-muted small">@item.PublishDate.ToString("dd.MM. HH:mm") Uhr</span>
                            </div>
                            <h4 class="mb-1 fw-bold text-primary text-truncate">@item.Title</h4>
                            <p class="mb-0 small text-muted text-truncate">@item.Description</p>
                        </div>
                       
                    </div>
                }
            </div>
        </div>
    }
</div>

<div class="my-5"></div>

@code {

    [Parameter]
    public IDTO Item { get; set; }

    [Parameter] public string FilterTerm { get; set; } = "";

    private bool isLoading = false;
    private int currentSourcesCount = 0;
    private List<RssItem> allDownloadedItems = new();
    private List<RssItem>? filteredArticles;
    private ThemeOption? selectedTheme;

    protected override async Task OnInitializedAsync()
    {
        selectedTheme = themes.First();
        await LoadAllFeeds();
    }

    private async Task OnThemeChanged(ChangeEventArgs e)
    {
        var themeName = e.Value?.ToString();
        selectedTheme = themes.FirstOrDefault(t => t.Name == themeName);
        await LoadAllFeeds();
    }

    private async Task LoadAllFeeds()
    {
        if (selectedTheme == null)
            return;

        isLoading = true;
        allDownloadedItems.Clear();
        currentSourcesCount = selectedTheme.Sources.Count;

        // Parallelisiertes Laden aller Quellen eines Themas
        var tasks = selectedTheme.Sources.Select(source => FetchRssFeed(source.Url, source.ProviderName));
        await Task.WhenAll(tasks);

        ApplyFilter();
        isLoading = false;
    }

    private async Task FetchRssFeed(string url, string provider)
    {
        try
        {
            var client = HttpClientFactory.CreateClient();
            var xmlString = await client.GetStringAsync(url);
            var doc = XDocument.Parse(xmlString);

            // Wir suchen nach 'item' (RSS) ODER 'entry' (Atom)
            var items = doc.Descendants().Where(x => x.Name.LocalName == "item" || x.Name.LocalName == "entry")
                      .Select(x => new RssItem
                      {
                          Title = x.Elements().FirstOrDefault(e => e.Name.LocalName == "title")?.Value ?? "",
                          Link = x.Elements().FirstOrDefault(e => e.Name.LocalName == "link")?.Value
                                 ?? x.Elements().FirstOrDefault(e => e.Name.LocalName == "link")?.Attribute("href")?.Value ?? "",
                          Description = x.Elements().FirstOrDefault(e => e.Name.LocalName == "description" || e.Name.LocalName == "summary")?.Value ?? "",
                          PublishDate = ParseDate(x.Elements().FirstOrDefault(e => e.Name.LocalName == "pubDate"
                                                                  || e.Name.LocalName == "published"
                                                                  || e.Name.LocalName == "updated")?.Value),
                          Source = provider,

                          // Bild-URLs aus <enclosure>, <media:content> oder <media:thumbnail> extrahieren:
                          ImageUrl = x.Elements().FirstOrDefault(e => e.Name.LocalName == "enclosure" && e.Attribute("type")?.Value.StartsWith("image/") == true)?.Attribute("url")?.Value
                                     ?? x.Elements().FirstOrDefault(e => e.Name.LocalName == "content" && e.Attribute("url")?.Value != null)?.Attribute("url")?.Value
                                     ?? x.Elements().FirstOrDefault(e => e.Name.LocalName == "thumbnail")?.Attribute("url")?.Value ?? ""
                      });

            lock (allDownloadedItems)
            {
                foreach (var item in items)
                {
                    if (!allDownloadedItems.Any(i => i.Link == item.Link))
                        allDownloadedItems.Add(item);
                }
            }
        }
        catch (Exception ex) { Console.WriteLine($"Fehler bei {provider}: {ex.Message}"); }
    }

    private void ApplyFilter()
    {
        var query = allDownloadedItems.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(FilterTerm))
        {
            query = query.Where(i => i.Title.Contains(FilterTerm, StringComparison.OrdinalIgnoreCase) ||
                                     i.Description.Contains(FilterTerm, StringComparison.OrdinalIgnoreCase));
        }

        // Zentrales Sortieren: Neueste zuerst
        filteredArticles = query.OrderByDescending(i => i.PublishDate).ToList();
    }

    private DateTime ParseDate(string? dateStr)
    {
        if (DateTime.TryParse(dateStr, CultureInfo.InvariantCulture, DateTimeStyles.None, out var dt))
            return dt;
        return DateTime.Now;
    }

    private string GetSourceBadgeClass(string provider) => provider.ToLower() switch
    {
        "tagesschau" => "bg-dark text-white",
        "n-tv" => "bg-danger text-white",
        "welt" => "bg-info text-white",
        "Euronews" => "bg-blue text-white",
        "ZDF" => "bg-warning text-dark",
        "Phoenix" => "bg-warning text-white",
        _ => "bg-secondary text-white"
    };

    public class RssItem
    {
        public string Title { get; set; } = "";
        public string Link { get; set; } = "";
        public string Description { get; set; } = "";
        public DateTime PublishDate { get; set; }
        public string Source { get; set; } = "";
        public string ImageUrl { get; set; } = ""; // Neues Feld für das Vorschaubild
    }

    // --- Struktur für die Erweiterbarkeit ---

    public record NewsSource(string ProviderName, string Url);
    public record ThemeOption(string Name, List<NewsSource> Sources);

    private List<ThemeOption> themes = new()
    {
        new ThemeOption("Wirtschaft & Finanzen", new() {
            new NewsSource("Tagesschau", "https://www.tagesschau.de/wirtschaft/index~rss2.xml"),
            new NewsSource("n-tv", "https://www.n-tv.de/wirtschaft/rss"),
            new NewsSource("Welt", "https://www.welt.de/feeds/section/wirtschaft.rss"),
            new NewsSource("ZDF", "https://www.zdf.de/rss/zdf/nachrichten"),
            new NewsSource("Euronews", "https://de.euronews.com/rss?format=mrss&level=theme&name=business"),
            new NewsSource("Handelsblatt", "https://www.handelsblatt.com/contentexport/feed/wirtschaft"),
            new NewsSource("CNBC", "https://search.cnbc.com/rs/search/view.xml?partnerId=2000&keywords=business"),
            new NewsSource("Yahoo Finance", "https://finance.yahoo.com/news/rssindex"),
            new NewsSource("Market Watch", "http://feeds.marketwatch.com/marketwatch/topstories/"),
            new NewsSource("Manager Magazin", "https://www.manager-magazin.de/finanzen/index.rss"),
            new NewsSource("FAZ", "https://www.faz.net/rss/aktuell/finanzen/"),

            // 10 neue spezifische Finanz- und Aktien-Quellen:
            new NewsSource("Börse Online", "https://www.boerse-online.de/rss/spartoem"),
            new NewsSource("DER AKTIONÄR", "https://www.deraktionaer.de/aktien/rss"),
            new NewsSource("Wallstreet Online", "https://www.wallstreet-online.de/rss/nachrichten.xml"),
            new NewsSource("Finanzen.net", "https://www.finanzen.net/rss/news"),
            new NewsSource("Finanznachrichten.de", "https://www.finanznachrichten.de/rss-nachrichten-aktien"),
            new NewsSource("Seeking Alpha", "https://seekingalpha.com/feed.xml"),
