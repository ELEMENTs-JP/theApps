@inherits BaseCtl


<Frame CSS="@CSS">
    <Header>
        <Header PreTitle="DESK" Title="Mission Control" PostTitle=""
                Description="@ItemType.Description" />
    </Header>
    <Related>
        <div class="d-flex">
            <div class="flex-fill">
            </div>
            <div class="flex-fill">
            </div>
        </div>
    </Related>
    <Content>

        @if (Items != null && Items.Any())
        {
            @foreach (int year in Years)
            {
                <VerticalPath Style="max-width:3rem !important;">
                    <Head>
                        <h3 class="h3 fw-bold">@year.ToSecureString()</h3>
                    </Head>
                    <Content>
                        @foreach (IDTO item in Items)
                        {
                            <ListItem Item="@item" ItemType="@ItemType" ExtendedView="true"></ListItem>
                        }
                    </Content>
                </VerticalPath>
            }
        }

    </Content>
</Frame>



@code {

    [Parameter]
    public IDTO Item { get; set; }

    private IItemType ItemType { get; set; } = new ItemType_TimeFrame();

    List<IDTO> Items { get; set; } = new();
    List<int> Years { get; set; } = new();

    [Parameter]
    public string CSS { get; set; } = "rounded-2 p-2";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            await Init();
            StateHasChanged();
        }
    }

    private async Task Init()
    {
        IQueryParameter qp = QueryParameter.Default(".");
        qp.MasterGUID = sql.MasterGUID;
        qp.ItemType = ItemType.Name;

        IQueryResult result = await sql.GetItems(qp);
        Items = result.Items;

        Years.Clear();
        Years = Items.Select(se => se["Year"].ToSecureInt()).Distinct().OrderBy(y => y).ToList();
    }
}
