@page "/Login"
@using Microsoft.AspNetCore.Components.Forms
@using theControls.Input
@using theControls.Layout
@layout EmptyLayout
@inject NavigationManager nm


<div class="container mt-5">
    <div class="card mx-auto" style="max-width: 400px;">
        <div class="card-body">
            <h2 class="h2 text-center fw-bold">Anmeldung</h2>
            <div class="hr-text">Geschäftsaccount</div>
            <form action="/api/auth/login" method="post">
                <AntiforgeryToken />
                <div class="mb-3">
                    <label class="form-label">Mail</label>
                    <input type="text" name="username" class="form-control" />
                </div>
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                    <label class="form-label">Passwort</label>
                    <a href="/requestnewpwd" class="ms-auto">neues Passwort anfordern</a>
                    <input type="password" name="password" class="form-control w-100" />
                </div>

                <div class="d-flex flex-row align-items-center ps-1">
                    <label class="form-check">
                        <input type="checkbox" name="remember" class="form-check-input" />
                        <span class="form-check-label">Anmeldung erinnern</span>
                    </label>
                    <button type="submit" class="btn btn-sm btn-primary ms-auto">Login</button>
                </div>  
            </form>

         
            @if (nm.Uri.Contains("error"))
            {
                <div class="alert alert-danger mt-3">Zugriff verweigert!</div>
            }
        </div>

       
    </div>
    <div class="d-flex justify-content-center align-items-center">

  
     
    </div>
</div>



