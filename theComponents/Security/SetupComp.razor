@page "/Setup"
@using Microsoft.AspNetCore.Components.Forms
@using theControls.Layout
@layout EmptyLayout
@inject NavigationManager nm


<div class="container mt-5">
    <div class="card mx-auto" style="max-width: 400px;">
        <div class="card-body">
            <h4>Setup</h4>
            <form action="/api/auth/setup" method="post">
                <AntiforgeryToken />

                <div class="mb-3">
                    <label>Mandant</label>
                    <input type="text" name="principal" class="form-control" />
                </div>
                <div class="mb-3">
                    <label>Benutzername</label>
                    <input type="text" name="username" class="form-control" />
                </div>
                <div class="mb-3">
                    <label>Passwort</label>
                    <input type="password" name="password" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary w-100">Setup</button>
            </form>

            @if (nm.Uri.Contains("error"))
            {
                <div class="alert alert-danger mt-3">Zugriff verweigert!</div>
            }
        </div>
    </div>
</div>



