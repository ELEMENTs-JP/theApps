@using theControls.Icons
@inject ISecurityService sec


@if(sec.User != null)
{
    <div class="d-flex flex-row bg-surface p-2 align-items-center  border-bottom border-start border-end">
        <SymbolIcon Symbol="Icon.User" />
        
        <span class="px-2">
            @sec.User.Title
        </span>
        
        @if (IsAdmin)
        {
            <SymbolIcon Symbol="Icon.Admin" Color="var(--tblr-red)" Title="Nutzer ist Administrator" />
        }
    </div>
}



@code {

    bool IsAdmin { get; set; } = false;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (sec.User != null)
        {
            IsAdmin = sec.User["IsAdmin"].ToSecureBool();
        }
    }


}
