@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="clock-container border border-transparent rounded p-3 d-flex justify-content-center align-items-center w-100 h-100 bg-body text-body" @ref="_clockContainer">
    <div class="clock-face position-relative">
        <div class="clock-marks">
            @for (int i = 0; i < 60; i++)
            {
                <div class="clock-mark @(i % 5 == 0 ? "hour-mark" : "minute-mark")" style="--angle: @(i * 6)deg;"></div>
            }
        </div>
        <div class="hand hour-hand" @ref="_hourHand"></div>
        <div class="hand minute-hand" @ref="_minuteHand"></div>
        <div class="hand second-hand bg-danger" @ref="_secondHand"></div>
        <div class="clock-center bg-danger"></div>
    </div>
</div>

@code {

    [Parameter]
    public IDTO Item { get; set; }

    private ElementReference _clockContainer;
    private ElementReference _hourHand;
    private ElementReference _minuteHand;
    private ElementReference _secondHand;
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/theComponents/DateTime/ClockComp.razor.js");
            await _module.InvokeVoidAsync("initClock", _clockContainer, _hourHand, _minuteHand, _secondHand);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stopClock", _clockContainer);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Ignorieren bei getrennter Verbindung
            }
        }
    }
}