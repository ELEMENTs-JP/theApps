@using theControls.Add
@using theControls.Icons
@using theControls.Input
@using theControls.Modal
@inject ISqlDatabaseService sql
@inject IMessagingBusService msg


@implements IAsyncDisposable

@if (ItemType != null)
{
    <ModalForm @key="@(new Guid().ToSecureString())" Title="neuen Eintrag erstellen"
               ShowTitleInButton="false"
               ButtonText="Neu"
               OnBeforeOK="BeforeOK"
               OnOKClicked="@( async e => { await OnOK(); } )">
        <Icon>
            <SymbolIcon Symbol="Icon.Neu" CSS="me-2 float-start" />
        </Icon>
        <ChildContent>
            <div class="d-flex flex-row border-bottom mb-3">
                <div class="vstack p-2 px-3">
                    <div class="text-secondary fw-bold">@ItemType.Name</div>
                    <small class="text-muted small">Erstellt einen neuen: @ItemType.Name</small>
                </div>
                @if (RelatedItem != null)
                {
                    <div class="vr"></div>
                    <div class="vstack p-2 px-3">
                        <div class="text-secondary fw-bold">@RelatedItem.Title</div>
                        <small class="text-muted small">Verbundener Eintrag vom Typ: @RelatedItem.ItemType</small>
                    </div>
                }
                <div class="flex-fill vstack p-2 px-3">
                </div>
            </div>

            <div class="row g-0">

                @if (!string.IsNullOrEmpty(Message))
                {
                    <div class="col-12 p-2">
                        <div class="alert alert-danger p-2 m-2">@Message</div>
                    </div>
                }

                <div class="col-12 p-2">
                    <TextBox Label="Titel" Value="@Title" Description="Titel des Datensatzes"
                             ValueChanged="@( async e => { Title = e; await SearchForDuplicates(); })" />
                </div>

             

                @foreach (IField field in ItemType.GetFields().Result.Where(s => s.Typ != FieldTyp.HR))
                {
                    <div class="col-12">
                        <AddBox Field="@field" CssClass="" Border="false"
                                ValueChanged="@( async e => { await OnChange(field, e); })" />
                    </div>
                }

                @if (RelatedItem != null)
                {
                    <div class="col-12 p-2">
                        <DropDown Value="@Association" 
                            Label="Zuordnung"  Description="Legt den Typ der Verbindung fest"
                                  Items="@( Helper.GetDefaultAssociations() )"
                                ValueChanged="@( async e => { Association = e;  })" />
                    </div>
                }
            </div>
        </ChildContent>
    </ModalForm>
}

@code {

    [Parameter]
    public IItemType ItemType { get; set; }

    [Parameter]
    public IDTO RelatedItem { get; set; }

    private IQueryContext Context { get; set; }

    // Fields
    private string Title { get; set; } = string.Empty;
    private string Association { get; set; } = string.Empty;
    private string Message { get; set; } = string.Empty;

    private List<IDataValue> Values { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (ItemType != null)
        {
            Context = new QueryContext(sql);
            Context.ItemType = this.ItemType;
        }
    }

    private async Task SearchForDuplicates()
    {
        Message = string.Empty;

        if (Context == null)
            return;

        //
        Context.Matchcode = this.Title;
        await Context.Search();

        IDTO item = Context.Items.Where(se => se.Title == this.Title).FirstOrDefault();
        if (item != null)
        {
            // Message
            Message = string.Format("Datensatz: {0} existiert bereits", Context.Matchcode);
        }

        await Task.CompletedTask;
    }

    private async Task<bool> BeforeOK()
    {
        if (string.IsNullOrEmpty(Title))
        {
            msg.Publish("Notwendige Felder", BusAction.Info, "Titel muss gesetzt sein.");
            return false;
        }

        if (RelatedItem != null)
        {
            if (string.IsNullOrEmpty(this.Association))
            {
                msg.Publish("Notwendige Felder", BusAction.Info, "Assoziation muss gesetzt sein.");
                return false;
            }
        }

        List<IField> necessaryFields = (await ItemType.GetFields()).Where(se => se.IsNecessary).ToList();
        if (necessaryFields.Count() >= 1)
        {
            if (Values.Count() == 0)
            {
                string info = "Die folgenden Felder sind notwendig: ";

                foreach (IField field in necessaryFields)
                {
                    info += " " + field.Title;
                }

                msg.Publish("Notwendige Felder", BusAction.Info, info);

                return false;
            }

            foreach (IField field in necessaryFields)
            {
                IDataValue? dv = Values.FirstOrDefault(se => se.Field.Column == field.Column);
                if (dv != null)
                {
                    if (dv.Value == string.Empty)
                    {
                        msg.Publish("Notwendiges Feld", BusAction.Info, "Das Feld: " + dv.Field.Title + " enthält keinen Wert.");
                        return false;
                    }
                }
            }

        }

        return true;
    }

    private async Task OnOK()
    {
        if (Context == null)
            return;

        if (string.IsNullOrEmpty(this.Association))
        {
            return;
        }

        // Erstellen
        Guid ID = await Context.Create(Title);

        // Laden
        await Context.Load(ID.ToSecureString());

        // Fields
        foreach (IDataValue dv in Values)
        {
            Context.Item[dv.Field.Column] = dv.Value.ToSecureString();
        }

        // Update
        await Context.Update(Context.Item);

        // Related Item
        if (RelatedItem != null)
        {
            AssociationTyp typ = this.Association.ToEnum<AssociationTyp>();
            if (typ == AssociationTyp.Parents)
            {
                await sql.Assign(Context.Item, RelatedItem, Association);
            }
            else
            {
                // Related = Parent, Context.Item = Child 
                await sql.Assign(RelatedItem, Context.Item, Association);
            }
        }

        // Clean
        Title = string.Empty;
        Values.Clear();

        // Message
        AppMessage am = new AppMessage("ID", BusAction.Refresh, "Datensatz erzeugt");
        msg.Publish(am);

        // Visual Update
        await InvokeAsync(this.StateHasChanged);
    }
    private async Task OnChange(IField field, string Value)
    {
        IDataValue val = new DataValue(field, Value);
        Values.AddOrUpdate(val);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            ItemType = null;
            RelatedItem = null;

            if (Context != null)
            {
                ((IDisposable)Context).Dispose();
                Context = null;
            }

        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : DISPOSE : BoardComp : " + ex.Message);
        }
    }
}
