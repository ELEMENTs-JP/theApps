@page "/Item/{IT}/{ID}"

@using theComponents.Items
@using theControls.Add
@using theControls.Edit
@using theControls.Layout
@using theControls.Tables
@using theDatabase
@using theInfrastructure

@inject ISqlDatabaseService sql



    @if (ItemType != null)
    {
        @if (Context != null)
        {
            <EditArea ItemType="@this.ItemType" ID="@ID" />

            @foreach (IItemType it in this.ItemType.ItemTypes)
            {
                <div class="my-3"></div>
                <RelatedItemsComp ItemType="@it" RelatedItem="@Context.Item" />
            }
        }
    }



@code {

    [Parameter]
    public string ID { get; set; } = string.Empty;

    [Parameter]
    public string IT { get; set; } = string.Empty;

    private IItemType ItemType { get; set; } = null;

    private IQueryContext Context { get; set; } = null;
    private IQueryContext RelatedContext { get; set; } = null;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (!string.IsNullOrEmpty(this.IT))
        {
            ItemType = new Factory(sql).BuildItemType(this.IT);
        }

        if (!string.IsNullOrEmpty(this.ID))
        {
            Context = new QueryContext(sql);
            Context.ItemType = ItemType;
            await Context.Load(this.ID);
        }
    }

}
