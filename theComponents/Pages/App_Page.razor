@page "/App/{ID}"
@inherits BaseCtl

<PageTitle>the App | Application</PageTitle>

@if (appService.App != null)
{
    <div class="container-flex">

        <Header PreTitle="Application" Title="@appService.App.Name" PostTitle="" Border="true" />

        <div class="row g-0">
            <div class="col-7 p-2">
        
            </div>
            <div class="col-5 p-2">
            </div>
        </div>

        <div class="row g-0">
        
            @foreach (ComponentDefinition def in Components)
            {
                <div class="@def.CSS">
                    <DynamicComponent @key="def.ClassName" Type="@Helper.SpecificType(def.Namespace, def.ClassName)" 
                                        Parameters="@def.Parameters" />
                </div>
            }

        </div>

    </div>
}


@code {

    [Parameter]
    public string ID { get; set; } = string.Empty;

    private List<ComponentDefinition> Components { get; set; } = new List<ComponentDefinition>();

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (!string.IsNullOrEmpty(this.ID))
        {
            if (appService.App != null)
            {
                Components = await appService.App.GetDashboardComponents();
            }
        }
    }
}
