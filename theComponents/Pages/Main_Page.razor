@page "/Main/{ItemType}"
@page "/Canvas/{ItemType}"
@using System.ComponentModel

@implements IAsyncDisposable
@inherits BaseCtl

<PageTitle>the App | Canvas</PageTitle>

@if (appService.App != null && appService.Item != null && InternalItemType != null)
{
    <div class="container-flex">


        <div class="row g-0">
            <div class="col-12 col-lg-7 p-2">
                <div class="my-3"></div>
                <EditArea ItemType="@InternalItemType" ID="@appService.Item.GUID.ToSecureString()" />


                <AssociatedItems Item="@appService.Item" CSS="my-3" />
            </div>
            <div class="col-12 col-lg-5 p-2">

            </div>
        </div>

    </div>
}
else
{
<div class="container p-5">
    <h1 class="h1">Bitte wählen Sie einen Haupteintrag.</h1>
</div>    
}


@code {

    [Parameter]
    public string ItemType { get; set; } = string.Empty;

    private IItemType InternalItemType { get; set; } = null;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        InternalItemType = await new Factory(sql).BuildItemType(ItemType);

        appService.PropertyChanged += AppService_PropertyChanged;
    }

    // Property Changed
    private void AppService_PropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName == "Item")
        {
            this.StateHasChanged();
        }
    }

    // Dispose
    public async ValueTask DisposeAsync()
    {
        try
        {
            appService.PropertyChanged -= AppService_PropertyChanged;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : DISPOSE : BoardComp : " + ex.Message);
        }
    }
}
