@page "/FINDits/{ID}"
@using theControls.Finder
@inject ISqlDatabaseService sql

<PageTitle>FINDits | the App Plattform</PageTitle>


<div class="container-flex">

    <FinderComp Item="@Item" />

</div>


@code {

    [Parameter]
    public string ID { get; set; }

    private IDTO Item { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        IQueryParameter qp = QueryParameter.Default(".");
        qp.MasterGUID = sql.MasterGUID;
        qp.ItemType = "Query";
        qp.GUID = ID.ToSecureGUID();

        IQueryResult result = await sql.GetItem(qp);
        Item = result.Items.FirstOrDefault();

    }

}
