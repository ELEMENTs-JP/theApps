@page "/Security/{Typ}"
@page "/Security/{Typ}/{Token}"
@layout EmptyLayout

@inject ISqlDatabaseService sql

<PageTitle>the App | Anmeldung und Registrierung</PageTitle>

<div class="container-flex">

    @if (Typ.ToLowerInvariant() == "Login".ToLowerInvariant())
    {
        @if (sql.DatabaseExists)
        {
            <LoginComp />
        }
        else
        {
            <SetupComp />
        }
    }
    @if (Typ.ToLowerInvariant() == "Register".ToLowerInvariant())
    {
        @if (sql.DatabaseExists)
        {
            <RegisterComp />
        }
        else
        {
            <SetupComp />
        }
    }
    @if (Typ.ToLowerInvariant() == "RequestNewPwd".ToLowerInvariant())
    {
        <RequestNewPwdComp />    
    }
    @if (Typ.ToLowerInvariant() == "RequestAccess".ToLowerInvariant())
    {
        <RequestAccessComp />    
    }
    @if (Typ.ToLowerInvariant() == "SetNewPwd".ToLowerInvariant())
    {
        <SetNewPwdComp Token="@Token" />
    }
    @if (Typ.ToLowerInvariant() == "Setup".ToLowerInvariant())
    {
        <SetupComp />
    }

</div>


@code {

    [Parameter]
    public string Typ { get; set; } = string.Empty;

    [Parameter]
    public string Token { get; set; } = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        string val = Typ;
    }

}
