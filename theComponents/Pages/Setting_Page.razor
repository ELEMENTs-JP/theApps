@page "/Setting"

@using theComponents.CMS
@using theComponents.Items
@using theControls.Add
@using theControls.Container
@using theControls.Edit
@using theControls.Input
@using theControls.Layout
@using theControls.Tables
@using theControls.Text
@using theDatabase
@using theDatabase.Controls
@using theInfrastructure

@inject ISqlDatabaseService sql
@inject IAppService apps
@inject ILocalizationService loc
@inject ISecurityService sec

<PageTitle>the App | Einstellungen</PageTitle>


<div class="container">

    @if (loc.Configuration != null)
    {
        <TabsFrame Title="Einstellungen" Orientation=" Orientation.Vertical" FrameCSS=" row g-0 w-100" >
            <HeaderContent>
                <TabsItem ID="@( ID + "1")" Title="Einstellungen" IsActive="true" Layout="TabsLayout.Buttons" />
                <TabsItem ID="@( ID + "2")" Title="Datenbank" Layout="TabsLayout.Buttons" />
                <TabsItem ID="@( ID + "3")" Title="Dateien" Layout="TabsLayout.Buttons" />
                <TabsItem ID="@( ID + "4")" Title="Features" Layout="TabsLayout.Buttons" />
                <TabsItem ID="@( ID + "5")" Title="Sicherheit" Layout="TabsLayout.Buttons" />
            </HeaderContent>
            <ChildContent>
                <TabsPanel ID="@( ID + "1")" IsActive="true">

                    <div class="border-bottom pb-2 mb-2">
                        <h1 class="h1 w-100">Allgemeine Einstellungen</h1>
                    </div>
                    <div class="row">
                        <div class="col-12 col-md-4 col-lg-4 px-2">
                            <TextBox Label="Titel" Value="@sec.Configuration.Title"
                                     ValueChanged="@(e =>
                                 {
                                     sec.Configuration.Title = e;
                                     sec.Configuration.Save();
                                 })" />

                          

                        </div>
                        <div class="col-12 col-md-4 col-lg-4 px-2 border-start border-end">
                            <ThemeSwitch />
                            <div class="border-bottom my-3"></div>
                            <CheckBox Label="Akzente" Value="@apps.Configuration.Akzente.ToSecureString()"
                                      ValueChanged="@(e =>
                                  {
                                                              apps.Configuration.Akzente = e.ToSecureBool();
                                                              apps.Configuration.Save();
                                  })" />
                            <div class="my-3"></div>
                            <TextBox Label="Hintergrundbild" Value="@apps.Configuration.Background" Type="FieldTyp.Url"
                                     ValueChanged="@(e =>
                                 {
                                                             apps.Configuration.Background = e;
                                                             apps.Configuration.Save();
                                 })" />
                            <div class="border-bottom my-3"></div>
                            <CheckBox Label="Hintergrund Blur Effekt" Value="@apps.Configuration.Blur.ToSecureString()"
                                      ValueChanged="@(e =>
                                  {
                                                              apps.Configuration.Blur = e.ToSecureBool();
                                                              apps.Configuration.Save();
                                  })" />

                            <div class="border-bottom my-3"></div>
                            <CheckBox Label="Vordergrund Glass Effekt" Value="@apps.Configuration.Glass.ToSecureString()"
                                      ValueChanged="@(e =>
                                  {
                                                              apps.Configuration.Glass = e.ToSecureBool();
                                                              apps.Configuration.Save();
                                  })" />
                        </div>
                        <div class="col-12 col-md-4 col-lg-4 px-2">
                            <LanguageSelector Value="@loc.Configuration.Sprache"
                                              ValueChanged="@(e =>
                                          {
                                              loc.Configuration.Sprache = e.ID;
                                              loc.Configuration.Save();
                                          })" />
                            <div class="border-bottom my-2"></div>
                            <CurrencySelector Value="@loc.Configuration.Currency"
                                              ValueChanged="@(e =>
                                          {
                                              loc.Configuration.Currency = e.ID;
                                              loc.Configuration.Save();
                                          })" />
                        </div>
                    </div>
                </TabsPanel>

                <TabsPanel ID="@( ID + "2")">
                    <div class="border-bottom pb-2 mb-2">
                        <h1 class="h1 w-100">Datenbank</h1>
                    </div>
                    <DatabaseSetup />
                </TabsPanel>

                <TabsPanel ID="@( ID + "3")">

                    <div class="border-bottom pb-2 mb-2">
                        <h1 class="h1 w-100">Speicher und Dateien</h1>
                    </div>
                    <div class="row">

                        <div class="col-12">

                            <CheckBox Label="Datei Uploads" Value="@sec.Configuration.AllowFileUploads.ToSecureString()"
                                      ValueChanged="@(e =>
                                                          {
                                                              sec.Configuration.AllowFileUploads = e.ToSecureBool();
                                                              sec.Configuration.Save();
                                                          })" />
                            <div class="my-2"></div>
                            <TextBox Label="Max. Dateigröße" Type="FieldTyp.Integer"
                                     Value="@sec.Configuration.MaxFileSizeInMB.ToSecureString()"
                                     ValueChanged="@(e =>
                                                         {
                                                             sec.Configuration.MaxFileSizeInMB = e.ToSecureInt();
                                                             sec.Configuration.Save();
                                                         })" />
                        </div>


                    </div>
                </TabsPanel>

                <TabsPanel ID="@( ID + "4")">

                    <div class="border-bottom pb-2 mb-2">
                        <h1 class="h1 w-100">Features</h1>
                    </div>

                    <FeaturesComp />

                </TabsPanel>

                <TabsPanel ID="@( ID + "5")">

                    <div class="border-bottom pb-2 mb-2">
                        <h1 class="h1 w-100">Sicherheit</h1>
                    </div>

                    <div class="row">
                        <div class="col-4">
                            <div class="border-bottom pb-2 mb-2">
                                <h3 class="h3 w-100">Anmeldung</h3>
                            </div>

                            <CheckBox Label="Fokus auf Username" Value="@sec.Configuration.FocusOnLogin.ToSecureString()"
                                      ValueChanged="@(e => { sec.Configuration.FocusOnLogin = e.ToSecureBool();
                                                              sec.Configuration.Save(); })" />
                            <div class="border-bottom my-3"></div>
                        </div>

                        <div class="col-4 border-start border-end">
                            <div class="border-bottom pb-2 mb-2">
                                <h3 class="h3 w-100">Registrierung</h3>
                            </div>

                            <CheckBox Label="Fokus auf Username" Value="@sec.Configuration.FocusOnRegister.ToSecureString()"
                                      ValueChanged="@(e =>
                                  {
                                      sec.Configuration.FocusOnRegister = e.ToSecureBool();
                                      sec.Configuration.Save();
                                  })" />
                            <div class="border-bottom my-3"></div>
                        </div>

                        <div class="col-4">
                            <div class="border-bottom pb-2 mb-2">
                                <h3 class="h3 w-100">Passwort</h3>
                            </div>

                        </div>
                    </div>

                </TabsPanel>
            </ChildContent>
        </TabsFrame>
    }

</div>



@code {

    private string ID = "" + Guid.NewGuid();


    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }

}
