@page "/Setting"

@using theComponents.CMS
@using theComponents.Items
@using theControls.Add
@using theControls.Container
@using theControls.Edit
@using theControls.Input
@using theControls.Layout
@using theControls.Tables
@using theControls.Text
@using theDatabase
@using theDatabase.Controls
@using theInfrastructure

@inject ISqlDatabaseService sql
@inject IAppService apps
@inject ILocalizationService loc
@inject ISecurityService sec

<PageTitle>the App | Einstellungen</PageTitle>


<div class="container-flex">

    @if (loc.Configuration != null)
    {
        <TabsFrame Title="Einstellungen" Orientation=" Orientation.Vertical" FrameCSS=" row g-0 w-100" >
            <HeaderContent>
                <TabsItem ID="@( ID + "1")" Title="Einstellungen" IsActive="true" Layout="TabsLayout.Buttons" />
                <TabsItem ID="@( ID + "2")" Title="Datenbank" Layout="TabsLayout.Buttons" />
                <TabsItem ID="@( ID + "3")" Title="Features" Layout="TabsLayout.Buttons" />
            </HeaderContent>
            <ChildContent>
                <TabsPanel ID="@( ID + "1")" IsActive="true">

                    <div class="row overflow-y-auto">
                        <div class="col-12 col-md-4 col-lg-4 px-2">
                            <TextBox Label="Titel" Value="@sec.Configuration.Title"
                                     ValueChanged="@(e =>
                                 {
                                     sec.Configuration.Title = e;
                                     sec.Configuration.Save();
                                 })" />

                            <div class="border-bottom my-2"></div>
                            <CheckBox Label="Datei Uploads" Value="@sec.Configuration.AllowFileUploads.ToSecureString()"
                                      ValueChanged="@(e =>
                                  {
                                      sec.Configuration.AllowFileUploads = e.ToSecureBool();
                                      sec.Configuration.Save();
                                  })" />
                            <div class="my-2"></div>
                            <TextBox Label="Max. Dateigröße" Type="FieldTyp.Integer"
                                     Value="@sec.Configuration.MaxFileSizeInMB.ToSecureString()"
                                     ValueChanged="@(e =>
                                 {
                                     sec.Configuration.MaxFileSizeInMB = e.ToSecureInt();
                                     sec.Configuration.Save();
                                 })" />

                        </div>
                        <div class="col-12 col-md-4 col-lg-4 px-2 border-start border-end">
                            <ThemeSwitch />
                            <div class="border-bottom my-2"></div>
                            <CheckBox Label="Akzente" Value="@sec.Configuration.Akzente.ToSecureString()"
                                      ValueChanged="@(e =>
                                  {
                                      sec.Configuration.Akzente = e.ToSecureBool();
                                      sec.Configuration.Save();
                                  })" />
                            <div class="my-2"></div>
                            <TextBox Label="Hintergrundbild" Value="@sec.Configuration.Background" Type="FieldTyp.Url"
                                     ValueChanged="@(e =>
                                 {
                                     sec.Configuration.Background = e;
                                     sec.Configuration.Save();
                                 })" />
                        </div>
                        <div class="col-12 col-md-4 col-lg-4 px-2">
                            <LanguageSelector Value="@loc.Configuration.Sprache"
                                              ValueChanged="@(e =>
                                          {
                                              loc.Configuration.Sprache = e.ID;
                                              loc.Configuration.Save();
                                          })" />
                            <div class="border-bottom my-2"></div>
                            <CurrencySelector Value="@loc.Configuration.Currency"
                                              ValueChanged="@(e =>
                                          {
                                              loc.Configuration.Currency = e.ID;
                                              loc.Configuration.Save();
                                          })" />
                        </div>
                    </div>
                </TabsPanel>

                <TabsPanel ID="@( ID + "2")">
                    <DatabaseSetup />
                </TabsPanel>

                <TabsPanel ID="@( ID + "3")">
                    <FeaturesComp />
                </TabsPanel>
            </ChildContent>
        </TabsFrame>
    }

</div>



@code {

    private string ID = "" + Guid.NewGuid();


    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }

}
