@page "/Setting"

@using theComponents.Items
@using theControls.Add
@using theControls.Container
@using theControls.Edit
@using theControls.Input
@using theControls.Layout
@using theControls.Tables
@using theControls.Text
@using theDatabase
@using theInfrastructure

@inject ISqlDatabaseService sql
@inject IAppService apps




<div class="container-flex">

    <ControlHeader Title="Einstellungen" Border="true" />

    @if (Configuration != null)
    {
        <TabsFrame Orientation="Orientation.Vertical" FrameCSS=" row g-0 w-100">
            <HeaderContent>
                <TabsItem ID="@( ID + "1")" Title="Einstellungen" IsActive="true" Layout="TabsLayout.Buttons" />
                <TabsItem ID="@( ID + "2")" Title="Anschrift" Layout="TabsLayout.Buttons" IsVisible="false" />
                <TabsItem ID="@( ID + "3")" Title="Shop" Layout="TabsLayout.Buttons" IsVisible="false" />
            </HeaderContent>
            <ChildContent>
                <TabsPanel ID="@( ID + "1")" IsActive="true">

                    <div class="row">
                        <div class="col-4 px-2">
                            <TextBox Label="Titel" Value="@Configuration.Title"
                                     ValueChanged="@(e => { Configuration.Title = e;
                                        Serializer.Save<SystemConfiguration>(Configuration, "system.config"); })" />
                        </div>
                        <div class="col-4 px-2 border-start border-end">
                            <ThemeSwitch />
                            <hr />
                            <CheckBox Label="Akzente" Value="@Configuration.Akzente.ToSecureString()" 
                                      ValueChanged="@(e => { Configuration.Akzente = e.ToSecureBool();
                                        Serializer.Save<SystemConfiguration>(Configuration, "system.config"); })" />
                        </div>
                        <div class="col-4 px-2">
                            <LanguageSelector Value="@Configuration.Sprache" 
                                ValueChanged="@(  e => { Configuration.Sprache = e.ID;
                                    Serializer.Save<SystemConfiguration>(Configuration, "system.config"); })" />
                        </div>
                    </div>
                </TabsPanel>

                <TabsPanel ID="@( ID + "2")">

                </TabsPanel>

                <TabsPanel ID="@( ID + "3")">

                </TabsPanel>
            </ChildContent>
        </TabsFrame>
    }

</div>



@code {

    private string ID = "" + Guid.NewGuid();

    private SystemConfiguration Configuration { get; set; } = null;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        Configuration = Serializer.Load<SystemConfiguration>("system.config");
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }

}
