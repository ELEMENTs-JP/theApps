@page "/Setting"
@using theControls.CMS
@using theControls.Database
@using theControls.KI



@inject ISqlDatabaseService sql
@inject IAppService apps
@inject ILocalizationService loc
@inject ISecurityService sec
@inject IMessagingBusService msg

<PageTitle>the App | Einstellungen</PageTitle>


<div class="container">

    @if (loc.Configuration != null)
    {
        <TabsFrame Title="Einstellungen" Orientation=" Orientation.Vertical" FrameCSS=" row g-0 w-100">
            <HeaderContent>
                <TabsItem ID="@( ID + "1")" Title="Einstellungen" IsActive="true" Layout="TabsLayout.Buttons" />
                <TabsItem ID="@( ID + "2")" Title="Datenbank" Layout="TabsLayout.Buttons" />
                <TabsItem ID="@( ID + "3")" Title="Dateien" Layout="TabsLayout.Buttons" />
                <TabsItem ID="@( ID + "4")" Title="Features" Layout="TabsLayout.Buttons" />
                <TabsItem ID="@( ID + "5")" Title="Sicherheit" Layout="TabsLayout.Buttons" />
                <TabsItem ID="@( ID + "6")" Title="Apps" Layout="TabsLayout.Buttons" />
                <TabsItem ID="@( ID + "7")" Title="SMTP" Layout="TabsLayout.Buttons" />
                <TabsItem ID="@( ID + "8")" Title="Testdaten" Layout="TabsLayout.Buttons" />
                <TabsItem ID="@( ID + "9")" Title="KI" Layout="TabsLayout.Buttons" />
            </HeaderContent>
            <ChildContent>
                <TabsPanel ID="@( ID + "1")" IsActive="true">
                    <SystemSettings />
                </TabsPanel>

                <TabsPanel ID="@( ID + "2")">
                    <DatabaseComp />
                </TabsPanel>

                <TabsPanel ID="@( ID + "3")">
                    <FilesConfigComp />
                </TabsPanel>

                <TabsPanel ID="@( ID + "4")">
                    <FeaturesComp />
                </TabsPanel>

                <TabsPanel ID="@( ID + "5")">
                    <SecurityConfigComp />
                </TabsPanel>

                <TabsPanel ID="@( ID + "6")">
                    <AppAsFeature />
                </TabsPanel>

                <TabsPanel ID="@( ID + "7")">
                    <SmtpConfig />
                </TabsPanel>

                <TabsPanel ID="@( ID + "8")">
                    <CreateTestData />
                </TabsPanel>

                <TabsPanel ID="@( ID + "9")">
                    <KI_Settings />
                </TabsPanel>

            </ChildContent>
        </TabsFrame>
    }
</div>


@code {

    private string ID = "Settings_" + Guid.NewGuid();

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }
   
}
