@page "/{Typ}/{IT}"
@inject ISqlDatabaseService sql

<PageTitle>the App | Items</PageTitle>

<div class="container-flex">

    @if (ItemType != null)
    {
        @if (ItemType.Typ == ItemTypeTyp.Hierarchy)
        {
            <HierarchyComp ItemType="@ItemType" />
        }
        else if (ItemType.Typ == ItemTypeTyp.Appointment)
        {
            <CalendarComp ItemType="@ItemType" />
        }
        else if (ItemType.Typ == ItemTypeTyp.Folder)
        {
            <FoldersComp ItemType="@ItemType" />
        }
        else if (ItemType.Typ == ItemTypeTyp.File ||
                    ItemType.Typ == ItemTypeTyp.Audio ||
                    ItemType.Typ == ItemTypeTyp.Image ||
                    ItemType.Typ == ItemTypeTyp.Video)
        {
            <FilesComp ItemType="@ItemType" />
        }
        else
        {
            <ItemsComp ItemType="@ItemType" />
        }
    }
    
</div>

@code {

    [Parameter]
    public string Typ { get; set; } = string.Empty;

    [Parameter]
    public string IT { get; set; } = string.Empty;

    private IItemType? ItemType { get; set; } = null;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        
        if (!string.IsNullOrEmpty(this.IT))
        {
            if (this.IT.SplitGetFirst(".").IsValidGuid())
                return;

            Factory f = new Factory(sql);
            ItemType = await f.BuildItemType(this.IT);
        }

    }

}
