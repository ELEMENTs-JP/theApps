@page "/Items/{IT}"
@using theComponents.Items
@using theControls.Add
@using theControls.Layout
@using theControls.Tables
@using theDatabase
@using theInfrastructure

@inject ISqlDatabaseService sql



    <ItemsComp ItemType="@ItemType" />



@code {

    [Parameter]
    public string IT { get; set; } = string.Empty;

    private IItemType ItemType { get; set; } = null;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        Factory f = new Factory(sql);
        ItemType = await f.BuildItemType(IT);
    }

}
