@inject IAppService apps
@inject NavigationManager nm
@inject IMessagingBusService msg

@foreach (IItemType it in ItemTypes)
{
    <div class="pointer hover rounded-2 p-2 fw-bold" 
            @onclick="@( async e => {  await NavigateToItemType(it); })">
        @it.ToString()
    </div>
}

@code {

    List<IItemType> ItemTypes { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        ItemTypes.Clear();
        IApp? app = apps.AllApps.Where(se => se.Name == "RUNer").FirstOrDefault();
        if (app != null)
        {
            ItemTypes.AddRange(app.GetItemTypes().Result);
        }

    }

    private async Task NavigateToItemType(IItemType it)
    {
        await apps.SetItemType(it);

        nm.NavToLibrary(it.Name, it.Typ);

        // // Refresh
        // msg.Publish(new AppMessage("ItemType", BusAction.Refresh));
        // Refresh
        msg.Publish(new AppMessage("App", BusAction.Refresh));

    }
}
