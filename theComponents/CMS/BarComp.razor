@inject IAppService apps
@inject NavigationManager nm

@foreach (IItemType it in ItemTypes)
{
    <div class="pointer hover rounded-2 p-2 fw-bold" 
            @onclick="@( e => {  nm.NavToLibrary(it.Name, it.Typ); })">
        @it.ToString()
    </div>
}




@code {

    List<IItemType> ItemTypes { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        ItemTypes.Clear();
        IApp app = apps.AllApps.Where(se => se.Name == "Task").FirstOrDefault();
        if (app != null)
        {
            ItemTypes.AddRange(app.GetItemTypes().Result);
        }

    }

}
