@using theControls.Icons
@using theInfrastructure
@inject IAppService app
@inject NavigationManager nm
@inject IMessagingBusService msg
@inject ISecurityService sec
@implements IAsyncDisposable

<div class="p-3">

    @* --- App selektiert --- *@
    @if (app.App != null)
    {
        <div class="row g-0 rounded-2 hover pointer p-2 m-2"
             @onclick="@( async e => { app.App = null; app.ItemType = null; app.Page = null; nm.NavigateTo("/", false); })">
            <div class="col-auto pe-2"><SymbolIcon Symbol="Icon.Home" /></div>
            <div class="col fw-bold"> Home</div>
            <div class="col-12 text-muted">zurück zum Start</div>
        </div>

        <div class="my-3"></div>

        <div class="selected pointer p-2 m-2"
             @onclick="@( async e => { await OnAppSelect(app.App); })">
            <div class="fw-bold">
                @app.App.ToString()
            </div>
            @if (!string.IsNullOrEmpty(app.App.Description))
            {
                <small class="text-muted">
                    @app.App.Description.ToString()
                </small>
            }
        </div>
    }

    
    @* --- keine App --- *@
    @if (app.App == null)
    {
        @foreach (string group in app.AllApps.Where(se => se.IsNavigation == true && se.IsActive == true).Select(se => se.Group).Distinct())
        {
            <div class="text-muted small fw-bold ps-2 mt-2">@group</div>
            <div class="row g-0">
                @foreach (IApp _app in app.AllApps.Where(se => se.Group == group && se.IsNavigation == true && se.IsActive == true))
                {
                    @if (sec.HasAppPermission(_app).Result)
                    {
                        <div class="col-12 p-1">
                            <div class="rounded-2 hover pointer p-1 px-2 fw-bold @( GetSelection(_app) )"
                                    @onclick="@( async e => { await OnAppSelect(_app); })">
                                @_app.ToString()
                            </div>
                        </div>
                    }
                }
            </div>
        }
    }

    @* --- App INHALT --- *@
    @if (app.App != null)
    {
        @if (CurrentItemTypes.Count() >= 1)
        {
            <div class="border-top my-3"></div>
            <div class="text-muted small fw-bold ps-2">Listen</div>
            <div class="row g-0">
                @foreach (IItemType it in CurrentItemTypes.Where(se => se.IsNavigation == true))
                {
                    <div class="col-12 p-1">
                        <div class="rounded-2 hover pointer p-1 px-2 fw-bold @( GetSelection(it) )"
                             @onclick="@( async e => { await OnItemType(it); })">
                            @it.ToString()
                        </div>
                    </div>

                    @foreach (IItemType child in it.GetItemTypes(AssociationTyp.Children).Result.Where(se => se.InSubNavigation == true))
                    {
                        <div class="col-12 p-1 ">
                            <div class="rounded-2 hover pointer p-1 px-2 ps-4 text-secondary @( GetSelection(child) )"
                                 @onclick="@( async e => { await OnItemType(child); })">
                                @child.ToString()
                            </div>
                        </div>
                    }
                }
            </div>
        }

        @if (CurrentPages.Count() >= 1)
        {
            <div class="border-top my-3"></div>
            <div class="text-muted small fw-bold ps-2">Pages</div>
            <div class="row g-0">
                @foreach (IDTO _page in CurrentPages)
                {
                    <div class="col-12 p-1">
                        <div class="rounded-2 hover pointer p-1 px-2 fw-bold @( GetSelection(_page) )"
                             @onclick="@( async e => { await OnPage(_page); })">
                            @_page.Title
                        </div>
                    </div>
                }
            </div>
        }

    }
</div>

@code {

    private List<IItemType> CurrentItemTypes { get; set; } = new();
    private List<IDTO> CurrentPages { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        msg.OnMessage += OnMessage;
    }
    public async void OnMessage(AppMessage message)
    {
        if (message.Id == "App")
        {
            if (message.Action == BusAction.Refresh)
            {
                CurrentItemTypes.Clear();
                CurrentPages.Clear();

                if (app.App != null)
                {
                    CurrentItemTypes = await app.App.GetItemTypes(AssociationTyp.Children);
                    CurrentPages = await app.App.GetPages(AssociationTyp.Children);
                }

                await InvokeAsync(StateHasChanged);
            }
        }
    }


    // Structure

    private async Task OnAppSelect(IApp _app)
    {
        await app.SetApp(_app);

        // CurrentItemTypes = await app.App.GetItemTypes(AssociationTyp.Children);
        // CurrentPages = await app.App.GetPages();

        nm.NavToApp(_app.Name);

        // Refresh
        msg.Publish(new AppMessage("App", BusAction.Refresh));

        await Task.CompletedTask;
    }
    private async Task OnItemType(IItemType it)
    {
        await app.SetItemType(it);
        nm.NavToLibrary(it.Name, it.Typ);

        // App Selection 
        await app.AppByItemType(it);

        // Refresh
        msg.Publish(new AppMessage("ItemType", BusAction.Refresh));

        await Task.CompletedTask;
    }
    private async Task OnPage(IDTO page)
    {
        await app.SetPage(page);
        nm.NavigateTo("/Page/" + page.GUID, false);

        // Refresh
        msg.Publish(new AppMessage("Page", BusAction.Refresh));

        await Task.CompletedTask;
    }
    private string GetSelection(IApp _app)
    {
        if (app.App == null)
            return string.Empty;

        if (app.App.Name == _app.Name)
            return " selected ";

        return string.Empty;
    }
    private string GetSelection(IItemType it)
    {
        if (app.ItemType == null)
            return string.Empty;

        if (app.ItemType.Name == it.Name)
            return " selected ";

        return string.Empty;
    }
    private string GetSelection(IDTO dto)
    {
        if (app.Page == null)
            return string.Empty;

        if (app.Page.Title == dto.Title)
            return " selected ";

        return string.Empty;
    }

  

    public async ValueTask DisposeAsync()
    {
        try
        {
            msg.OnMessage -= OnMessage;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : DISPOSE : BoardComp : " + ex.Message);
        }
    }

    private readonly List<string> PreferredGroupOrder = new()
    {
        "Strategy",
        "Main",
        "Tools",
        "Admin"
    };
}
