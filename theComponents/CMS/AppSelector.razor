@using theInfrastructure
@inject IAppService app
@inject NavigationManager nm

<div class="border-top border-bottom p-2">

    <div class="text-muted small fw-bold ps-2">Apps</div>
    <div class="row g-0">
        @foreach (IApp app in app.AllApps)
        {
            <div class="col-12 p-1">
                <div class="rounded-2 hover pointer p-1 px-2 fw-bold" 
                @onclick="@( async e => { await OnAppSelect(app); })">
                    @app.Name
                </div>
            </div>
        }
    </div>

    <div class="text-muted small fw-bold ps-2">Listen</div>
    <div class="row g-0">
        @foreach (IItemType it in this.ItemTypes)
        {
            <div class="col-12 p-1">
                <div class="rounded-2 hover pointer p-1 px-2 fw-bold" 
                @onclick="@( async e => { await OnItemType(it); })">
                    @it.Name
                </div>
            </div>
        }
    </div>
</div>

@code {

    private List<IItemType> ItemTypes { get; set; } = new();

    private async Task OnAppSelect(IApp _app)
    {
        app.App = _app;

        ItemTypes.Clear();
        ItemTypes.AddRange(app.App.ItemTypes);

        await Task.CompletedTask;    
    }

    private async Task OnItemType(IItemType it)
    {
        nm.NavigateTo("/Items/" + it.Name, false);

        await Task.CompletedTask;
    }

}
