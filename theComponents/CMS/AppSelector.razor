@using theInfrastructure
@inject IAppService app
@inject NavigationManager nm
@inject IMessagingBusService msg
@implements IAsyncDisposable

<div class="p-3">

    @if (app.App != null)
    {
        <div class="border rounded-2 hover pointer p-2 m-2"
             @onclick="@( async e => { app.App = null; nm.NavigateTo("/", false); })">
            <span class="fw-bold">Home</span>
        </div>

        <div class="my-3"></div>

        <div class="border rounded-2 hover pointer p-2 m-2" 
             @onclick="@( async e => { await OnAppSelect(app.App); })">
            <span class="fw-bold">
                @app.App.ToString()
            </span>
        </div>
    }

    @if (app.App == null)
    {
        @foreach (string group in app.AllApps.Where(se => se.IsNavigation == true && se.IsActive == true).Select(se => se.Group).Distinct())
        {
            <div class="text-muted small fw-bold ps-2 mt-2">@group</div>
            <div class="row g-0">
                @foreach (IApp _app in app.AllApps.Where(se => se.Group == group && se.IsNavigation == true && se.IsActive == true))
                {
                    <div class="col-12 p-1">
                        <div class="rounded-2 hover pointer p-1 px-2 fw-bold @( GetSelection(_app) )"
                             @onclick="@( async e => { await OnAppSelect(_app); })">
                            @_app.ToString()
                        </div>
                    </div>
                }
            </div>
        }
    }

    @if (app.App != null)
    {
        <div class="border-top my-3"></div>
        <div class="text-muted small fw-bold ps-2">Listen</div>
        <div class="row g-0">
            @foreach (IItemType it in app.App.GetItemTypes().Result)
            {
                <div class="col-12 p-1">
                    <div class="rounded-2 hover pointer p-1 px-2 fw-bold @( GetSelection(it) )"
                         @onclick="@( async e => { await OnItemType(it); })">
                        @it.ToString()
                    </div>
                </div>

                @foreach (IItemType child in it.GetItemTypes().Result)
                {
                    <div class="col-12 p-1 ">
                        <div class="rounded-2 hover pointer p-1 px-2 ps-4 text-secondary @( GetSelection(child) )"
                             @onclick="@( async e => { await OnItemType(child); })">
                            @child.ToString()
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

@code {

    private List<IItemType> ItemTypes { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        msg.OnMessage += OnMessage;
    }
    public async void OnMessage(AppMessage message)
    {
        if (message.Id == "App")
        {
            if (message.Action == BusAction.Refresh)
            {
                await InvokeAsync(StateHasChanged);
            }            
        }
    }

    private async Task OnAppSelect(IApp _app)
    {
        await app.SetApp(_app);

        nm.NavToApp(_app.Name);

        // Refresh 
        msg.Publish(new AppMessage("App", BusAction.Refresh));

        await Task.CompletedTask;
    }

    private async Task OnItemType(IItemType it)
    {
        await app.SetItemType(it);
        nm.NavToLibrary(it.Name);

        // Refresh
        msg.Publish(new AppMessage("ItemType", BusAction.Refresh));

        await Task.CompletedTask;
    }
    private string GetSelection(IApp _app)
    {
        if (app.App == null)
            return string.Empty;

        if (app.App.Name == _app.Name)
            return " selected ";

        return string.Empty;
    }
    private string GetSelection(IItemType it)
    {
        if (app.ItemType == null)
            return string.Empty;

        if (app.ItemType.Name == it.Name)
            return " selected ";

        return string.Empty;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            msg.OnMessage -= OnMessage;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : DISPOSE : BoardComp : " + ex.Message);
        }
    }

}
