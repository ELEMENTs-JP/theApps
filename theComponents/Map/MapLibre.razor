
@implements IWidget



@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="border rounded p-2 my-2">
    <div id="@_mapContainerId" style="width: 100%; height: 700px;" class="rounded"></div>
</div>

@code {

    [Parameter]
    public IDTO Item { get; set; }
  
    private readonly string _mapContainerId = $"map-{Guid.NewGuid():N}";
    private IJSObjectReference? _jsModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var assemblyName = GetType().Assembly.GetName().Name;
            _jsModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", $"./_content/{assemblyName}/Map/MapLibre.razor.js");
            await _jsModule.InvokeVoidAsync("initMap", _mapContainerId);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule is not null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("destroyMap", _mapContainerId);
                await _jsModule.DisposeAsync();
            }
            catch
            {
                // Cleanup exception suppression
            }
        }
    }
}