@page "/"
@using theComponents.Apps._99_RUNer

@inject ISecurityService sec

<div class="container">

    <div class="d-flex justify-content-between border-bottom">
        <Header PreTitle="Dashboard" Title="the App" PostTitle="the App Plattform" Border="false" Orientation="Orientation.Left" />
        <Header PreTitle="Willkommen" Title="@user" PostTitle="@post" Border="false" Orientation="Orientation.Right" />
    </div>

    <div class="row g-0">
        <div class="col-12 p-2">

            <MinimumItemComp />

            <TabsFrame Orientation="Orientation.Center" FrameCSS="w-100" BackgroundCSS="glass">
                <HeaderContent>
                    <TabsItem ID="@( ID + "1")" Title="Business" IsActive="true" Layout="TabsLayout.Buttons" />
                    <TabsItem ID="@( ID + "2")" Title="Personal" Layout="TabsLayout.Buttons" />
                </HeaderContent>

                <ChildContent>
                    <TabsPanel ID="@( ID + "1")" IsActive="true">

            
                            <CompanyDashboard/> 

                            <MissionControl CSS="bg-surface rounded-2 p-2" />

                    </TabsPanel>
                    <TabsPanel ID="@( ID + "2")">

                        @*        <PersonalDashboard /> *@

                    </TabsPanel>
                </ChildContent>
            </TabsFrame>

        </div>

    </div>


</div>

@code {

    private string ID = "" + Guid.NewGuid();

    string user = string.Empty;
    string post = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (sec.User != null)
        {
            user = sec.User.Title;
        }
        post = DateTime.Now.ToLongDateString();
    }

}