@page "/"
@using theControls.Edit
@using theControls.Input
@using theControls.Text
@inject ISecurityService sec



<div class="container">

    <ControlHeader PreTitle="Dashboard" Title="the App" PostTitle="the App Plattform" Border="true"
                   PreRelated="Willkommen"  Related="@user"  PostRelated="@post"  />
    

</div>

@code {

    string user = string.Empty;
    string post = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (sec.User != null)
        {
            user = sec.User.Title;
        }
        post = DateTime.Now.ToLongDateString();
    }

}