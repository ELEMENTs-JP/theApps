@page "/"
@using theComponents.Dashboard
@using theControls.Container
@using theControls.Edit
@using theControls.Input
@using theControls.Text
@inject ISecurityService sec



<div class="container">

    <ControlHeader PreTitle="Dashboard" Title="the App" PostTitle="the App Plattform" Border="true"
                   PreRelated="Willkommen"  Related="@user"  PostRelated="@post"  />
    

    <TabsFrame Orientation="Orientation.Center" FrameCSS="w-100" BackgroundCSS="glass">
        <HeaderContent>
            <TabsItem ID="@( ID + "1")" Title="Business" IsActive="true" Layout="TabsLayout.Buttons" />
            <TabsItem ID="@( ID + "2")" Title="Personal" Layout="TabsLayout.Buttons" />
        </HeaderContent>
    
             <ChildContent>
            <TabsPanel ID="@( ID + "1")" IsActive="true">

                     <CompanyDashboard/>
                 
                </TabsPanel>
                <TabsPanel ID="@( ID + "2")">

                    <PersonalDashboard />
                 
                </TabsPanel>
             </ChildContent>
    </TabsFrame>

</div>

@code {

    private string ID = "" + Guid.NewGuid();

    string user = string.Empty;
    string post = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (sec.User != null)
        {
            user = sec.User.Title;
        }
        post = DateTime.Now.ToLongDateString();
    }

}