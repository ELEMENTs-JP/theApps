@using theApp.Components.Layout
@using theControls.Layout
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <ResourcePreloader />
    
    
    <CssScriptLoader Position="LoadingPosition.Head" />
    
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["tabler-ext.css"]" />
    <link rel="stylesheet" href="@Assets["theApp.styles.css"]" />
    
    <ImportMap />
    
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
 
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />

    <CssScriptLoader Position="LoadingPosition.Body" />

    <script src="@Assets["_framework/blazor.web.js"]"></script>
    
</body>

</html>
