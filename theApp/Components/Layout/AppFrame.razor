@using Microsoft.AspNetCore.Components.Authorization
@using theComponents.CMS
@using theComponents.Security
@using theControls.Add
@using theControls.Modal

@inject ISqlDatabaseService sql
@inherits LayoutComponentBase

<AppLayout>
    <Header>
        <AddArea ItemType="@ItemType" />
        <div class="ms-auto me-auto"></div>
        <SystemPopup />
    </Header>
    <Menu>
        <AppSelector />
    </Menu>
    <Body>
        @Body
    </Body>
</AppLayout>

@code {

    IItemType ItemType { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        Factory f = new Factory(sql);
        ItemType = await f.BuildItemType("Task");
    }


}