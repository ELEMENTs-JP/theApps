@using theComponents.CMS
@using theControls.Add
@using theControls.Modal

@inject ISqlDatabaseService sql
@inherits LayoutComponentBase

<div class="frame">
    <div class="sidebar">
        <Sidebar>
            <MenuContent>
                <AppSelector />
            </MenuContent>
        </Sidebar>
    </div>

    <main class="w-100 d-flex flex-column">
        <div class="header hstack px-3">

            <AddArea ItemType="@ItemType" />

            <div class="ms-auto me-auto"></div>
            <a href="/Setup">Database</a>
            <div class="ms-auto"></div>
            <ThemeSwitch />
        </div>

        <div class="p-3 scrollable flex-fill">
            @Body
        </div>
        <div class="footer">

        </div>
    </main>
</div>



<StaticPositionContainer Position="@StaticPosition.MessageBox">

    <InfoBox FrameCSS="m-2" CloseAfterSeconds="true" Seconds="5"
             ShowCloseButton="true" />

</StaticPositionContainer>

@code {

    IItemType ItemType { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        Factory f = new Factory(sql);
        ItemType = await f.BuildItemType("Task");
    }


}