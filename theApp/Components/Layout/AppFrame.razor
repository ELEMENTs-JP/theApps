@using theComponents.CMS
@using theControls.Add
@using theControls.Modal

@inherits LayoutComponentBase

<div class="frame">
    <div class="sidebar">
        <Sidebar>
            <MenuContent>
                <AppSelector />
            </MenuContent>
        </Sidebar>
    </div>

    <main class="w-100 vstack">
        <div class="header hstack px-3">
            <AddArea ItemType="@( new Factory().BuildItemType("Task"))" />

            <div class="ms-auto me-auto"></div>
            <a href="/Setup">Database</a>
            <div class="ms-auto"></div>
            <ThemeSwitch />
        </div>

        <article class="p-3 bg-cover">
            @Body
        </article>
        <div class="footer">

        </div>
    </main>
</div>



<StaticPositionContainer Position="@StaticPosition.MessageBox">

    <InfoBox FrameCSS="m-2" CloseAfterSeconds="true" Seconds="5"
             ShowCloseButton="true" />

</StaticPositionContainer>

