@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Sections
@using theControls.Add
@using theControls.Input
@using theControls.Modal

@inject ILocalizationService loc
@inject ISqlDatabaseService sql
@inherits LayoutComponentBase
@inject IJSRuntime js

<AppLayout>
    <Header>
        <AddArea ItemType="@ItemType" />
        <div class="ms-auto me-auto"></div>
        <SystemPopup />
    </Header>
    <Menu>
        <MenuComp/>
    </Menu>
    <Navigation>
        <AppSelector />
    </Navigation>
    <Body>
        @Body

      @*   <SectionOutlet SectionId="Sections.ModalOutlet" /> *@
    </Body>
    <Bar>
        <BarComp />
    </Bar>
</AppLayout>



@code {

    IItemType ItemType { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        Factory f = new Factory(sql);
        ItemType = await f.BuildItemType("Task");
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();


    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            if (!string.IsNullOrEmpty(loc.Configuration.Background))
            {
                await js.InvokeVoidAsync("setBodyBackground", loc.Configuration.Background);
            }
        }
    }
    private async Task ChangeBackground()
    {

        
    }
}