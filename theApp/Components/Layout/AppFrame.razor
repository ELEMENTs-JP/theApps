@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Sections
@using theControls.Add
@using theControls.Input
@using theControls.Modal
@using theControls.Search

@inject ILocalizationService loc
@inject ISecurityService sec
@inject ISqlDatabaseService sql
@inherits LayoutComponentBase
@inject IJSRuntime js
@inject IAppService app

<AppLayout>
    <Header>
        <div class="px-1"></div>
        <SearchComp />
        <AddArea ItemType="@ItemType" />
        <div class="mx-auto"></div>
        <SystemPopup />
    </Header>
    <Menu>
        <MenuComp />
    </Menu>
    <Navigation>
        <AppSelector />
    </Navigation>
    <Body>
        @Body

        @*   <SectionOutlet SectionId="Sections.ModalOutlet" /> *@
    </Body>
    <Bar>
        <BarComp />
    </Bar>
</AppLayout>



@code {

    IItemType ItemType { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        Factory f = new Factory(sql);
        ItemType = await f.BuildItemType("Task");
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();


    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            // Default == Mandant
            string wallpaper = app.Configuration.Background;

            if (sec.User != null)
            {
                string userBG = sec.User["Wallpaper"].ToSecureString();
                if (!string.IsNullOrEmpty(userBG))
                {
                    wallpaper = userBG;
                }
            }

            await js.InvokeVoidAsync("setBodyBackground", wallpaper);

            bool IsClassActive = app.Configuration.Blur.ToSecureBool();
            await js.InvokeVoidAsync("toggleClass", "blur", IsClassActive);

        }
    }
    private async Task ChangeBackground()
    {

        
    }
}