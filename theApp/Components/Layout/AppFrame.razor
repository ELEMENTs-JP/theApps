@using theControls.Finder
@inherits LayoutComponentBase
@inject ILocalizationService loc
@inject ISecurityService sec
@inject ISqlDatabaseService sql
@inject IJSRuntime js
@inject IAppService app
@inject NavigationManager nm

<AppLayout>
    <Header>
        <div class="px-1"></div>
        <SearchComp />
        <div class="px-5  d-none d-xl-block">
      
            <FinderPopup />

        </div>
        <AddArea ItemType="@ItemType" />
        <div class="mx-auto"></div>
        <SystemPopup />
    </Header>
    <Menu>
        <MenuComp />
    </Menu>
    <Navigation>
        <AppSelector />
    </Navigation>
    <Body>
        @Body

        @*   <SectionOutlet SectionId="Sections.ModalOutlet" /> *@
    </Body>
    <Bar>
        <BarComp />
    </Bar>
</AppLayout>



@code {

    IItemType ItemType { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        Factory f = new Factory(sql);
        ItemType = await f.BuildItemType("Task");
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();


    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            // Default == Mandant
            string wallpaper = app.Configuration.Background;

            if (sec.User != null)
            {
                string userBG = sec.User["Wallpaper"].ToSecureString();
                if (!string.IsNullOrEmpty(userBG))
                {
                    wallpaper = userBG;
                }
            }

            await js.InvokeVoidAsync("setBodyBackground", wallpaper);

            bool IsClassActive = app.Configuration.Blur.ToSecureBool();
            await js.InvokeVoidAsync("toggleClass", "blur", IsClassActive);

        }
    }
    private async Task ChangeBackground()
    {

        
    }
}