@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Sections
@using theControls.Add
@using theControls.Input
@using theControls.Modal

@inject ISqlDatabaseService sql
@inherits LayoutComponentBase

<AppLayout>
    <Header>
        <AddArea ItemType="@ItemType" />
        <div class="ms-auto me-auto"></div>
        <SystemPopup />
    </Header>
    <Menu>
        <MenuComp/>
    </Menu>
    <Navigation>
        <AppSelector />
    </Navigation>
    <Body>
        @Body

      @*   <SectionOutlet SectionId="Sections.ModalOutlet" /> *@
    </Body>
    <Bar>
        <BarComp />
    </Bar>
</AppLayout>



@code {

    IItemType ItemType { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        Factory f = new Factory(sql);
        ItemType = await f.BuildItemType("Task");
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        
    }


}