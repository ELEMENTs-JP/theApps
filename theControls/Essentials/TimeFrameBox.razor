@if (Item != null)
{
    <div class="@CSS @SpaceCSS w-100"
         style="border-left: 3px solid #fff;">
        <div class="row g-0">
            <div class="col px-1">
                <strong>@Item.Title</strong>
            </div>
        </div>
        <div class="row g-0 text-secondary">
            <div class="col px-1 text-muted truncate-text text-nowrap">
                <strong>Start</strong> @Item["Start"].ToSecureDateTime().ToShortDateString()
            </div>
            <div class="col px-1 text-muted truncate-text text-nowrap">
                <strong>Ende</strong> @Item["Ende"].ToSecureDateTime().ToShortDateString()
            </div>
            @if (ShowBudget)
            {
                <div class="col px-1 text-muted truncate-text text-nowrap">
                    <strong>Budget</strong> @Item["Budget"].ToFormat(FieldTyp.Money)
                </div>
            }
        </div>
    </div>
}




@code {

    [Parameter]
    public IDTO Item { get; set; }

    [Parameter]
    public EventCallback<IDTO> OnClick { get; set; }

    [Parameter]
    public string CSS { get; set; } = " hover pointer ";

    [Parameter]
    public string SpaceCSS { get; set; } = " p-2 py-1 mx-2 ";

    [Parameter]
    public bool ShowBudget { get; set; } = true;
}
