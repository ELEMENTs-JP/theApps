
<div class="d-flex align-items-center flex-nowrap">
    <SymbolIcon Symbol="@( Priority.IconByPriority(Value))"
                Color="@( Priority.ColorByPriority(ID) )" />

    <div class="px-1">
        @Value
    </div>

</div>

@code {

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public string ID { get; set; } = string.Empty;

}
