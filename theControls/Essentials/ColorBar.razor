@if (Item != null)
{
    <div class="d-flex align-items-center py-1">
        <div class="px-2" style="">
            <div style="width: 20px; height: 20px; border-radius: 50%; border:1px solid #fff; background-color:@Item.ID"></div>
        </div>
        <div class="flex-fill px-1">
            @Item.Title
        </div>
    </div>
}


@code {

    [Parameter]
    public IDTO Item { get; set; }

}
