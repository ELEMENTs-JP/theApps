@inject IAppService app


@if (Image != null)
{
    @if (FileExt.IsValidImageExtension())
    {
        <div class="position-relative mt-2">
            <div style="display: grid; grid-template-columns: repeat(12, 1fr); grid-template-rows: repeat(12, 1fr);aspect-ratio: 1 / 1; width: 100%;"
                    class="w-100">
            <div style="grid-column: 1 / 13; grid-row: 1 / 13;">
                <!-- Bild-DIV -->
                <div id="@( "user_image_relative_" + ID )"
                     class="border rounded-2 overflow-hidden bg-surface align-items-center"
                     style="@(MinStyle + " " + app.Configuration.GetAkzentStyle())">

                    <div class="@( ImageCSS  + " row col-auto mx-auto position-relative" )"
                         style="@(ImageStyle + " " + BackgroundColor +
                                                                            " background-image: url(" + this.Base64String + "); " )">
                    </div>
                </div>

            </div>
            <div style="grid-column: 12 / 13; grid-row: 1 / 2;" class="p-2">
                <!-- Modal-DIV -->
                <div class="p-1 rounded-2">
                    <ModalForm Size="ModalFormSize.Full"
                               ContentCSS="p-0 m-0" ModalCSS="modal-dialog modal-dialog-centered">
                        <Icon>
                            <SymbolIcon Symbol="Icon.Max" Color="#777" />
                        </Icon>
                        <ChildContent>
                            <div class="@( ImageCSS  + " row col-auto mx-auto " )"
                                 style="@(FullSizeImageStyle + " " + BackgroundColor +
                                                                                                                                                                                                                    " background-image: url(" + this.Base64String + "); " )">
                            </div>
                        </ChildContent>
                    </ModalForm>
                </div>


            </div>
        </div>
        </div>

    }
}

@code {


    [Parameter]
    public IDTO Image { get; set; }

    private string ID = "" + Guid.NewGuid();

    // Image
    private string Base64String { get; set; } = "";

    string FileExt { get; set; } = string.Empty;

    [Parameter]
    public string ImageCSS { get; set; } = "  ";

    [Parameter]
    public string ImageStyle { get; set; } = "height:32rem; width:100%; background-size: cover; background-position: center center; background-repeat: no-repeat;";

    [Parameter]
    public string FullSizeImageStyle { get; set; } = "width: 100%; height: stretch; display: block; background-size: cover; background-position: center center; background-repeat: no-repeat;";

    [Parameter]
    public string MinStyle { get; set; } = "min-height: 32px; min-width:32px;";

    string BackgroundColor { get; set; } = "  ";

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (Image == null)
            return;

        this.FileExt = Image["FileExtension"].ToSecureString();

        this.Base64String = await Helper.ToBase64String(Image);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {

        }
    }


 
  
}
