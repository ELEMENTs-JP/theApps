@inject IAppService app


<div class="@app.Configuration.GetGlassClass()  row g-0 p-2 rounded-2  @( ((Border) ? " border-bottom " : "")  )">
    <div class="col-auto p-1">
        @if (!string.IsNullOrEmpty(PreTitle))
        {
            <div class="page-pretitle">
                @PreTitle
            </div>
        }

        @if (!string.IsNullOrEmpty(Title))
        {
            <h1 class="h1">
                @Title
            </h1>
        }

        @if (!string.IsNullOrEmpty(SubTitle))
        {
            <div class="text-muted"
                 style="max-width:15rem;" title="@SubTitle">
                @SubTitle
            </div>
        }

        @if (!string.IsNullOrEmpty(PostTitle))
        {
            <div class="text-muted text-truncate"
                 style="max-width:15rem;" title="@PostTitle">
                @PostTitle
            </div>
        }
    </div>
    <div class="col p-1">
    </div>
    <div class="col-auto text-end p-1">
        @if (!string.IsNullOrEmpty(PreRelated))
        {
            <div class="page-pretitle">
                @PreRelated
            </div>
        }

        @if (!string.IsNullOrEmpty(Related))
        {
            <h1 class="h1">
                @Related
            </h1>
        }

        @if (!string.IsNullOrEmpty(PostRelated))
        {
            <span class="text-muted">
                @PostRelated
            </span>
        }
    </div>

    @if (!string.IsNullOrEmpty(Description))
    {
        <div class="col-12 px-1 text-muted truncate-text pe-5">
            @Description
        </div>
    }
</div>


@code {

    [Parameter]
    public string Description { get; set; } = string.Empty;

    [Parameter]
    public string PreTitle { get; set; } = string.Empty;

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string SubTitle { get; set; } = string.Empty;

    [Parameter]
    public string PostTitle { get; set; } = string.Empty;

    [Parameter]
    public string PreRelated { get; set; } = string.Empty;

    [Parameter]
    public string Related { get; set; } = string.Empty;

    [Parameter]
    public string PostRelated { get; set; } = string.Empty;

    [Parameter]
    public bool Border { get; set; } = false;

}
