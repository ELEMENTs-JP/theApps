@inherits BaseCtl
@implements IAsyncDisposable

@if (Messages != null && Messages.Count > 0)
{
    <div class="@CSS" style="@Style">

        <div class="p-2 d-flex align-items-center">
            <h1 class="h1 fw-light flex-fill px-1">Benachrichtigungen</h1>
            <div class="p-2 m-1 hover pointer rounded" @onclick="@Hide">
                <i class="ti ti-x"></i>
            </div>
        </div>

        @foreach (IDTO m in Messages)
        {
            <div class="border rounded-2 p-2 bg-surface m-2">
                <div class="d-flex">
                    <div class="p-1 fw-bold flex-fill">@m.Title</div>
                    <div class="p-1 hover pointer rounded" @onclick="@( e => { Remove(m); } )">
                        <i class="ti ti-x"></i>
                    </div>
                </div>
                <div class="p-1">@m.Content</div>
                <div class="px-1 text-muted small">
                    @m["DateTime"].ToSecureString()
                </div>
            </div>
        }
    </div>
}

@code {

    [Parameter]
    public List<IDTO> Messages { get; set; } = new();

    string Style = "";
    string CSS = "";

    [Parameter]
    public int Seconds { get; set; } = 5;

    // Init
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        msg.OnMessage += OnMessageIncome;
        notify.OnNotify += OnNotification;
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();


    }

    // Calls
    private async void OnNotification(IDTO item, NotificationType typ, IDTO user)
    {
        if (item == null)
            return;

        if (typ == NotificationType.Update)
        {
            IQueryResult result = await sql.GetRelatedItems(sec.User, "Notification", AssociationTyp.Related);

            IDTO? fav = result.Items.Find(se =>
                se["GUID"] == item.GUID.ToSecureString() &&
                se["Update"] == "true".ToSecureString() &&
                se["ItemType"] == item.ItemType.ToSecureString());
            if (fav != null)
            {
                DTO msg = new();
                msg.Title = "Benachrichtigung";
                msg.Content = item.Title + " wurde von " + user.Title + " aktualisiert.";
                msg["DateTime"] = DateTime.Now.ToShortDateString() + " - " + DateTime.Now.ToShortTimeString();
                Messages.Add(msg);

                // Style
                UpdateStyle();

                await InvokeAsync(StateHasChanged);
                // await HideInfoAfterDelay();
            }
        }

        if (typ == NotificationType.Delete)
        {
            IQueryResult result = await sql.GetRelatedItems(sec.User, "Notification", AssociationTyp.Related);

            IDTO? fav = result.Items.Find(se =>
                se["GUID"] == item.GUID.ToSecureString() &&
                se["Delete"] == "true".ToSecureString() &&
                se["ItemType"] == item.ItemType.ToSecureString());
            if (fav != null)
            {
                DTO msg = new();
                msg.Title = "Benachrichtigung";
                msg.Content = item.Title + " wurde von " + user.Title + " aktualisiert.";
                msg["DateTime"] = DateTime.Now.ToShortDateString() + " - " + DateTime.Now.ToShortTimeString();
                Messages.Add(msg);

                // Style
                UpdateStyle();

                await InvokeAsync(StateHasChanged);
                // await HideInfoAfterDelay();
            }
        }
    }
    private async void OnMessageIncome(AppMessage msg)
    {


        if (msg.Action == BusAction.Info)
        {
            DTO info = new();
            info.Title = "Information";
            info.Content = msg.Payload.ToSecureString();
            info["DateTime"] = DateTime.Now.ToShortDateString() + " - " + DateTime.Now.ToShortTimeString();
            Messages.Add(info);

            // Style
            UpdateStyle();

            await InvokeAsync(StateHasChanged);
            // await HideInfoAfterDelay();
        }
    }

    private async void UpdateStyle()
    {
        if (Messages.Count == 0)
        {
            Hide();
        }
        else
        {
            Show();
        }
    }
    private async void Show()
    {
        Style = "position: fixed; top:10px; right:10px; width: 18vw; height: calc(100vh - 20px); z-index: 1000;";
        CSS = " glass rounded-2 ";

        await HideInfoAfterDelay();
    }
    private async void Hide()
    {
        Style = "";
        CSS = "";
    }
    private async void Remove(IDTO m)
    {
        Messages.Remove(m);
    }
    private async Task HideInfoAfterDelay()
    {
        await Task.Delay(TimeSpan.FromSeconds(Seconds));
        Hide();
        await InvokeAsync(StateHasChanged);
    }

    // Dispose
    public async ValueTask DisposeAsync()
    {
        try
        {
            msg.OnMessage -= OnMessageIncome;
            notify.OnNotify -= OnNotification;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : DISPOSE : BoardComp : " + ex.Message);
        }
    }

}
