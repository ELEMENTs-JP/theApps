@using theInfrastructure


@if (Item != null)
{
    <div @key="@Item.GUID" id="@Item.GUID" 
        class="drag row g-0 align-items-center my-1 hover border rounded">
        <div class="col-auto p-2 grab hover" style="cursor:move;">
            ...
        </div>
        <div class="col p-2">
            @Item.Title
        </div>
        <div class="col-auto p-2">
            @Item["Sort"].ToSecureString()
        </div>
    </div>
}

@code {

    

    [Parameter]
    public string Zone { get; set; } = string.Empty;

    [Parameter]
    public IDTO Item { get; set; }

 

}
