
<div class="row g-0 flex-shrink-0 border rounded pointer hover p-2" 
     @onclick="@( async e => { await OnClick.InvokeAsync(Item); })">

    @if (Item.Icon != Icon.NULL)
    {
        <div class="col-auto pe-3">
             <SymbolIcon Symbol="@Item.Icon" />
         </div>
    }

    <div class="col pe-2">
        @Item.Name
     </div>
</div>

@code {

    [Parameter]
    public DragDropElement Item { get; set; }

    [Parameter]
    public EventCallback<DragDropElement> OnClick { get; set; }
}
