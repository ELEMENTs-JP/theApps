@using theInfrastructure

@if (Item != null)
{
    <div @key="@( "lr-" + Item.GUID.ToSecureString())" 
            id="@Item.GUID.ToSecureString()" 
                class="row g-2 my-2">

        @foreach (Column column in Columns)
        {
            <div class="col-@column.Width">

                <DragDropContainer Entries="Widgets" Zone="@column.Zone" 
                                   DragEnd="@( async e => { await DragEnd.InvokeAsync(e);  } )">
                    <ItemTemplate Context="ctl">
                        <Widget @key="@ctl.GUID" Item="@ctl" />
                    </ItemTemplate>
                </DragDropContainer>



            </div>
        }

    </div>
}



@code {

    // Fields
    string drop = "dropControls";

    // External 
    [Parameter]
    public IDTO Item { get; set; }

    [Parameter]
    public List<IDTO> Controls { get; set; } = new();

    // Internal 
    List<Column> Columns { get; set; } = new List<Column>();
    List<IDTO> Widgets { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();


    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (Item != null)
        {
            await MapColumns();
            await MapControls();
        }
    }

    private async Task MapColumns()
    {
        string typ = Item["Typ"].ToSecureString();

        switch (typ)
        {
            case "12":
                {
                    Columns = new List<Column> { new Column { Width = 12, Zone = "12-" + Item.GUID } };
                    break;    
                }
            case "66":
                {
                    Columns = new List<Column> { 
                            new Column { Width = 6, Zone = "6L-" + Item.GUID },
                                new Column { Width = 6, Zone = "6R-" + Item.GUID }, };
                    break;
                }
            case "444":
                {
                    Columns = new List<Column> { 
                            new Column { Width = 4, Zone = "4L-" + Item.GUID }, 
                            new Column { Width = 4, Zone = "4M-" + Item.GUID }, 
                            new Column { Width = 4, Zone = "4R-" + Item.GUID }, };
                    break;
                }
            case "363":
                {
                    Columns = new List<Column> {
                            new Column { Width = 3, Zone = "3L-" + Item.GUID },
                            new Column { Width = 6, Zone = "6M-" + Item.GUID },
                            new Column { Width = 3, Zone = "3R-" + Item.GUID }, };
                    break;
                }
            case "57":
                {
                    Columns = new List<Column> { 
                            new Column { Width = 5, Zone = "5L-" + Item.GUID },
                                new Column { Width = 7, Zone = "7R-" + Item.GUID }, };
                    break;
                }
            case "75":
                {
                    Columns = new List<Column> {
                            new Column { Width = 7, Zone = "7L-" + Item.GUID },
                                new Column { Width = 5, Zone = "5R-" + Item.GUID }, };
                    break;
                }
            default:
                {
                    Columns = new List<Column> { new Column { Width = 12, Zone = "12-Default-" + Item.GUID } };
                    break;    
                }
        }

        await Task.CompletedTask;
    }
    private async Task MapControls()
    {
        this.Widgets.Clear();

        foreach (IDTO ctl in Controls)
        {
            // string NS = ctl["Namespace"].ToSecureString();
            // string CL = ctl["Klasse"].ToSecureString();
            // string Zone = ctl["Zone"].ToSecureString();
            // string Sort = ctl["Sort"].ToSecureString();

            // DragDropElement dde = new();
            // dde.ID = ctl.GUID.ToSecureString();
            // dde.Zone = Zone;
            // dde.Sort = Sort.ToSecureInt();

            // // Control 
            // dde.Control = new();
            // dde.Control.Name = ctl.Title;
            // dde.Control.Namespace = NS;
            // dde.Control.ClassName = CL;

            // Add 
            this.Widgets.Add(ctl);
        }
    }

    [Parameter]
    public EventCallback<List<IDTO>> DragEnd { get; set; }
}
