@using System.Text.Json
@using Microsoft.JSInterop
@using theControls.DragDrop
@using theControls.Input
@using theControls.Layout
@using theControls.Modal
@using theControls.Text
@using theInfrastructure
@inject IJSRuntime JS

@if (Item != null)
{
    <Frame Border="true" Rounded="true">
        <Header>
            <ControlHeader PreTitle="Page" Title="@Item.Title" PostTitle="" />
        </Header>
        <Related>
            <div class="hstack gap-3">
                <ModalForm Title="Einstellungen">
                    <ChildContent>
                        <div class="row">
                            <div class="col-12 px-2">
                                <TextBox Label="Titel" Value="@Item.Title"
                                         ValueChanged="@(e =>  { Item.Title = e; })" />
                                <div class="border-bottom my-2"></div>
                            </div>
                        </div>
                    </ChildContent>
                </ModalForm>

                <DragDropDesigner Entries="@Rows" Definitions="@LayoutDefinitions"
                                  Zone="Layout" DragEnd="@( async e => { Rows = e;  })" />

                <DragDropDesigner Title="Steuerelemente" Entries="@Controls" Definitions="@ControlDefinitions"
                                  Zone="Controls" DragEnd="@( async e => { Controls = e;  })" HasBackdrop="false" ReAssignZones="true" />
            </div>
        </Related>
        <Content>
            <div data-zone="Page" class="bg-surface rounded-2 p-2">
                @foreach (DragDropElement entry in Rows)
                {
                    <LayoutRow @key="@entry.ID" Item="@entry" Controls="@this.Controls" />
                }
            </div>
        </Content>
    </Frame>

}



@code {

    [Parameter]
    public IDTO Item { get; set; }

    [Parameter]
    public List<DragDropElement> Rows { get; set; } = new();
    List<DragDropElement> LayoutDefinitions { get; set; } = new();

    [Parameter]
    public List<DragDropElement> Controls { get; set; } = new();

    List<DragDropElement> ControlDefinitions { get; set; } = new();

    // CTR
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        LayoutDefinitions.Add(new DragDropElement()
        {
            Name = "12",
            Typ = "12",
            Columns = new List<Column>
            {
                new Column { Width = 12 }
            }
        });
        LayoutDefinitions.Add(new DragDropElement()
        {
            Name = "66",
            Typ = "66",
            Columns = new List<Column>
            {
                new Column { Width = 6 },
                new Column { Width = 6 },
            }
        });
        LayoutDefinitions.Add(new DragDropElement()
        {
            Name = "444",
            Typ = "444",
            Columns = new List<Column>
            {
                new Column { Width = 4 },
                new Column { Width = 4 },
                new Column { Width = 4 },
            }
        });


        ControlDefinitions.Add(new DragDropElement() { Name = "the Date" });
        ControlDefinitions.Add(new DragDropElement() { Name = "the Time" });
        ControlDefinitions.Add(new DragDropElement() { Name = "the Address" });
        ControlDefinitions.Add(new DragDropElement() { Name = "the City" });
    }

}
