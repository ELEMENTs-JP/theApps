@using System.Text.Json
@using Microsoft.JSInterop
@using theInfrastructure
@using theControls.DragDrop
@inject IJSRuntime JS
@inject ISqlDatabaseService sql


<div class="@( drop + Zone ) DefaultDragDropZone position-relative @CSS"
     data-zone="@Zone" style="min-height:5rem;">

    @if (!string.IsNullOrEmpty(this.Title))
    {
        <div class="py-2"></div>
        <div class="position-absolute top-0 start-0 px-3 py-2">
            <div class="fw-bold small text-secondary">
                @this.Title
            </div>
        </div>
    }

    @* --- Beachte: Empty == Default --- Direkt im Getter des Modell von tbl_CON_Content --- 
        .ToValueIfNullOrEmpty(Zone)
        .ToValueIfNullOrEmpty("1")
    *@
    @foreach (IDTO entry in Entries.Where(se => se[ZoneProperty].ToSecureString() == this.Zone)
                                    .OrderBy(se => se[SortProperty].ToSecureInt()))
    {
        if (ItemTemplate != null)
        {
            @ItemTemplate(entry)
        }
    }

</div>

@code {

    // Fields
    string drop = "drop";

    [Parameter]
    public RenderFragment<IDTO>? ItemTemplate { get; set; }

    [Parameter]
    public string Zone { get; set; } = string.Empty;

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string ZoneProperty { get; set; } = "Zone";

    [Parameter]
    public string SortProperty { get; set; } = "Sort";

    /// <summary>
    /// Wird benötigt um im Mehrnutzungsszenarion die initiale Container zu definieren 
    /// </summary>
    [Parameter]
    public bool IsDefaultZone { get; set; } = false;

    [Parameter]
    public List<IDTO> Entries { get; set; } = new();

    [Parameter]
    public string CSS { get; set; } = " bg-surface border rounded px-2 py-1 my-2 ";

    // Objects
    private Lazy<Task<IJSObjectReference>> module;
    private DotNetObjectReference<DragDropContainer>? objRef;

    // CTR
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        Init();

    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await PrepareItems();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        try
        {
            // assign dragdrop
            if (firstRender)
            {
                await Assign();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("FAIL: " + ex.Message);
        }
    }

    // Methods
    private async Task PrepareItems()
    {
        if (Entries == null)
            return;

        if (IsDefaultZone)
        {
            foreach (IDTO item in Entries)
            {
                // set Zone 
                string zone = item[ZoneProperty].ToSecureString();
                if (string.IsNullOrEmpty(zone))
                {
                    item[ZoneProperty] = Zone;
                }

                // set Order 
                string sort = item[SortProperty].ToSecureString();
                if (string.IsNullOrEmpty(sort))
                {
                    item[SortProperty] = "1";
                }

                // Update 
                await sql.Update(item);
            }
        }
    }

    // Helper
    public void Init()
    {
        try
        {
            // Import JS File
            module = new(() => JS.InvokeAsync<IJSObjectReference>
                ("import", "./_content/theControls/js/DragDrop.js").AsTask());
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : Board : Init : " + ex.Message);
        }

    }
    public async ValueTask Assign()
    {
        try
        {
            // Reference
            objRef = DotNetObjectReference.Create(this);

            // Execute function
            if (module != null)
            {
                var refMethod = await module.Value;
                await refMethod.InvokeVoidAsync("assignMultipleSortableJS",
                    (drop + Zone), "drag", objRef);
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : Board : AssignSortable : " + ex.Message);
        }
    }

    [JSInvokable]
    public async void OnDragEnd(JsonElement json)
    {
        foreach (JsonElement item in json.EnumerateArray())
        {
            string guid = item.GetProperty("GUID").GetString();
            string sort = item.GetProperty("Sort").GetString();
            string zone = item.GetProperty("Zone").GetString();

            IDTO entry = Entries.FirstOrDefault(e => e.GUID.ToString() == guid);

            if (entry != null)
            {
                entry[SortProperty] = sort;
                entry[ZoneProperty] = zone;

                // Update
                await sql.Update(entry);

                // Event
                await ItemDragEnd.InvokeAsync(entry);
            }
        }

        Entries = Entries.OrderBy(e => e[SortProperty].ToSecureInt()).ToList();

        await InvokeAsync(StateHasChanged);

        // Event
        await DragEnd.InvokeAsync(Entries);

    }

    [Parameter]
    public EventCallback<List<IDTO>> DragEnd { get; set; }

    [Parameter]
    public EventCallback<IDTO> ItemDragEnd { get; set; }

}
