@using theControls.Dynamic
@using theInfrastructure
@inject ISqlDatabaseService sql
@inject IMessagingBusService msg

@if (Item != null)
{
    @* Change *@
    <div @key="@Item.GUID" id="@Item.GUID" 
    class="drag row g-0 border rounded mx-1 my-2 rounded bg-surface align-items-center">

        <div class="col-auto me-auto p-1 px-2 fw-bold text-muted">
            @Item.Title
        </div>

        <div class="col-auto ms-auto me-auto grab p-1 text-muted" >
            <div class="hover rounded py-05 px-3" style="cursor:move;">
                ...
            </div>
        </div>


        @if (Item != null)
        {
             <div class="col-auto ms-auto p-1">
                

                  <ModalForm @key="@(new Guid().ToSecureString())" Title="Einstellungen"
                           ShowTitleInButton="false" Value=""
                           OnOKClicked="@( async e => {  } )">
                    <Icon>
                        <SymbolIcon Symbol="Icon.Config" CSS="" />
                    </Icon>
                    <ChildContent>
            
                    </ChildContent>
                    <FooterContent>

                    </FooterContent>
                </ModalForm>


            </div>

            <div class="col-auto p-1">
                <SymbolIcon Symbol="Icon.Delete"
                OnClick="@( async e => { await DeletItem(); })"
                CSS="pointer hover rounded p-05" />
            </div>
        }

        @if (Component != null)
        {
            <div class="col-12 border-top p-2">
                <DynamicComponent Type="@(Component.ComponentType)" Parameters="@(Component.Parameters)" />
            </div>
        }

    </div>
}



@code {

    // Fields
    string drop = "dropControls";

    // [Parameter]
    // public DragDropElement Item { get; set; }

    private Builder builder { get; set; }

    IDynamicComponent Component { get; set; }

    [Parameter]
    public IDTO Item { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        builder = new Builder(sql);
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (Item != null)
        {
            Component = builder.BuildComponent(builder.GetDefinition(Item.Title));
        }
    }

    public async Task DeletItem()
    {
        if (Item == null)
            return;

        await sql.Delete(Item);

        // Refresh 
        msg.Publish("Item", BusAction.Refresh);
    }

}
