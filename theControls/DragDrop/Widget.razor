@using theControls.Dynamic
@using theInfrastructure
@inject ISqlDatabaseService sql
@inject IMessagingBusService msg

@if (Item != null)
{
    <div @key="@Item.ID" id="@Item.ID" 
         class="drag position-relative mt-2 rounded bg-surface">
         
        <div class="grab hover rounded-2 pt-05 pb-05 px-2 text-muted position-absolute top-0 start-50 translate-middle-x"
             style="cursor:move;">
            ...
        </div>


        @if (DTO != null)
        {
            <div class="hover rounded-2 position-absolute top-0 end-0">
                <SymbolIcon Symbol="Icon.Delete"
                            OnClick="@( async e => { await DeletItem(); })"
                            CSS="pointer rounded-2 p-05" />
            </div>
        }
    
        @if (Component != null)
        {
            <DynamicComponent Type="@(Component.ComponentType)" Parameters="@(Component.Parameters)" />
        }
        
    </div>
}


@code {

    // Fields
    string drop = "dropControls";

    [Parameter]
    public DragDropElement Item { get; set; }

    private Builder builder { get; set; }

    IDynamicComponent Component { get; set; }

    [Parameter]
    public IDTO DTO { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        builder = new Builder(sql);
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (DTO != null)
        {
            Component = builder.BuildComponent(builder.GetDefinition(DTO.Title));
        }
    }

    public async Task DeletItem()
    {
        if (DTO == null)
            return;

        await sql.Delete(DTO);

        // Refresh 
        msg.Publish("Item", BusAction.Refresh);
    }

}
