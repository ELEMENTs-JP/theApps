@using theControls.Dynamic
@using theInfrastructure



@if (Item != null)
{
    <div @key="@Item.ID" id="@Item.ID" class="drag row g-0 align-items-center mt-2 hover border rounded p-1 bg-surface">
        <div class="col fw-bold border-bottom p-1">
            @Item.Control.Name
        </div>
        <div class="grab hover col-auto p-1 px-3 text-center" style="cursor:move;">
            ...
        </div>
        <div class="col p-1">
            @Item.Name
        </div>
        <div class="col-auto p-1">
            @Item.Sort.ToSecureString()
        </div>
        <div class="col-auto fw-bold p-2">
            Widget
        </div>
        <div class="col-12">
            <DynamicBuilderComponent />
        </div>
    </div>
}


@code {

    // Fields 
    string drop = "dropControls";

    [Parameter]
    public DragDropElement Item { get; set; }

}
