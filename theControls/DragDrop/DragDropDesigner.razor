@using Microsoft.JSInterop
@using theControls.DragDrop
@using theInfrastructure
@inject IJSRuntime JS



<div class="btn btn-sm row g-0" data-bs-toggle="offcanvas"
     data-bs-target="@( "#canvasLayout" + ID )" aria-controls="@( "canvasLayout" + ID )">
    @if (Icon.HasContent())
    {
        <div class="col-auto px-1">
            @Icon
        </div>
    }
    <div class="col">
        @Title
    </div>
</div>

<div class="offcanvas offcanvas-end"
     data-bs-scroll="true"
     data-bs-backdrop="@HasBackdrop.ToSecureString().ToLower()"
     tabindex="-1"
     id="@( "canvasLayout" + ID )">
    <div class="offcanvas-header">
        <h4 class="offcanvas-title">@Title</h4>
        <div class="btn-close" data-bs-dismiss="offcanvas"></div>
    </div>
    <div class="offcanvas-body">

        @if (!string.IsNullOrEmpty(DefinitionsTitle))
        {
            <label class="form-label">@DefinitionsTitle</label>    
        }
        <div class="row g-0">
            @foreach (IDTO def in Definitions)
            {
                <div class="col-auto p-1">
                    <DragDropDefinition @key="def.GUID" Item="@def" 
                        OnClick="@( async e => { await AddRow(e); })" />
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(EntriesTitle))
        {
            <label class="form-label">@EntriesTitle</label>
        }
        <DragDropContainer @ref="container" Entries="@Entries" Zone="@Zone"
                           DragEnd="@(async e => { Entries = e; await DragEnd.InvokeAsync(Entries); })">
            <ItemTemplate Context="entry">
                <DragDropRow @key="@entry.GUID" Item="@entry" Zone="@Zone" />
            </ItemTemplate>
        </DragDropContainer>

    </div>
</div>

@code {

    [Parameter]
    public string DefinitionsTitle { get; set; } = string.Empty;

    [Parameter]
    public string EntriesTitle { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment Icon { get; set; }

    private string ID { get; set; } = "_" + Guid.NewGuid().ToSecureString();
    DragDropContainer container;

    [Parameter]
    public List<IDTO> Entries { get; set; } = new();

    [Parameter]
    public List<IDTO> Definitions { get; set; } = new();

    // Events 
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {

        }
    }
    
    // Methods 
    private async Task AddRow(IDTO def)
    {
        // DragDropElement dde = new();
        // dde.Name = def.Name.ToSecureString(); // Bezeichnung im Button 
        // dde.Typ = def.Typ; // Typ der Zeile (12, 66, 444...)
        // dde.Zone = Zone; // Definiert den Zonen Namen 
        // dde.Control = def.Control;
        // dde.Columns = def.Columns.Select(c => new Column
        // {
        //     Width = c.Width // legt die CSS Klasse für die Breite fest 
        // }).ToList();

        Entries.Add(def);

        // Event 
        await DragEnd.InvokeAsync(Entries);

        @if (ReAssignZones == true)
        {
            if (container != null)
            {
                await container.Assign();
            }
        }

        // Event
        await ItemAdded.InvokeAsync(def);
    }

    [Parameter]
    public EventCallback<List<IDTO>> DragEnd { get; set; }

    [Parameter]
    public EventCallback<IDTO> ItemAdded { get; set; }

    [Parameter]
    public string Zone { get; set; } = "Layout";

    [Parameter]
    public string Title { get; set; } = "Layout";

    [Parameter]
    public bool HasBackdrop { get; set; } = true;

    [Parameter]
    public bool ReAssignZones { get; set; } = false;



}
