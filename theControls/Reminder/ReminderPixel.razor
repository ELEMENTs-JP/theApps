@using theInfrastructure
@implements IDisposable
@inject TimerService timer
@inherits BaseCtl

<div class="position-relative rounded p-1 px-3">


@* 


    <div class="dropup-center dropup">
        <div class="" data-bs-toggle="dropdown" aria-expanded="false">
            
        </div>
        <div class="dropdown-menu">

        </div>
    </div>
 *@



    <div id="@( "frame_popup_" + ID )" class="@(" w-100 dropup-center dropup")) ">

        <div id="@( "link_popup_" + ID )" class="@(" row align-items-center ")" data-bs-toggle="dropdown">

            @*  d-none d-xl-block   *@
            <div id="@( "head_popup_" + ID )" class="col p-2 hover rounded pointer">
                <ToolTip Title="@( "Letzte Überprüfung:" + (lastExecution == DateTime.MinValue ? "Noch keine" : lastExecution.ToString("HH:mm:ss")) )">
                    <SymbolIcon Symbol="Icon.Reminder" Size="24" />
                </ToolTip>
            </div>
@*             <div class="@( "col-auto pointer hover rounded-2 px-1 me-2  dropdown-toggle")"
                 style="padding-right: 0.5rem !important;">
            </div> *@
        </div>

        <div id="@( "body_popup_" + ID )" class="@( "dropdown-menu w-100 ")" style="@MenuStyle">

            <div class="row g-0">
                <div class="col">
                    <div class="dropdown-header">Erinnerungen</div>
                </div>
            </div>

         


            <div class="@( " overflow-y-auto " )" style="@( MaxHeightCSS )">

                @foreach (IDTO item in Reminder)
                {
                    <div class="d-flex m-1 mx-2 hover pointer rounded-2 p-1"
                        @onclick="@( e => { nm.NavToItem(item.ItemType, item.GUID); } )" >
                      
                        <div class="flex-fill p-1">
                            @item.Title
                        </div>
                        <div class="p-1">
                            @item["Date"].ToSecureDateTime().ToShortDateString()
                        </div>
                        <div class="p-1">
                            @item["Time"].ToSecureDateTime().ToShortTimeString()
                        </div>
                    </div>
                }

            </div>

         
        </div>
    </div>



</div>

@code {

    string ID { get; set; } = Guid.NewGuid().ToString();

    private readonly string registrationKey = Guid.NewGuid().ToString();
    private DateTime lastExecution = DateTime.MinValue;

    string MenuStyle { get; set; } = "min-width:18rem;";
    string MaxHeightCSS { get; set; } = "max-height:44rem;";

    List<IDTO> Items { get; set; } = new();
    List<IDTO> Reminder { get; set; } = new();


    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        // Registrierung am TimerService mit Intervall 5 Minuten
        // optional: runImmediately = true, falls der erste Check sofort beim Laden erfolgen soll
        timer.Register(
            key: registrationKey,
            interval: UpdateInterval.OneMinute,
            callback: CheckRemindersAsync,
            runImmediately: true
        );
    }

    private async Task CheckRemindersAsync()
    {
        // Ausführungslogik für den 5-Minuten-Tick
        lastExecution = DateTime.Now;

        Items = new();

        IQueryParameter qp = QueryParameter.Default(string.Empty);
        qp.MasterGUID = sql.MasterGUID;
        qp.ItemType = "Reminder";

        IQueryResult result = await sql.GetItems(qp);
        Items = result.Items;

        // Aktiv 
        Items = Items.Where(se => se["IsActive"].ToSecureBool() == true).ToList();

        // inkl. Heute (nicht beendet)
        Items = Items.Where(se => se["Stop"].ToSecureDateTime().Date >= DateTime.Now.Date).ToList();

        // Reminder 
        Reminder = Items;

        // Tag (älter als Heute) nur heutige Reminder
        Items = Items.Where(se => se["Date"].ToSecureDateTime().Date <= DateTime.Now.Date).ToList();

        // Uhrzeit (älter als jetzt)
        Items = Items.Where(se => se["Time"].ToSecureDateTime().TrimToMinute() <= DateTime.Now.TrimToMinute()).ToList();

        foreach (IDTO rem in Items)
        {
            string info = rem.Title + " " + rem.Content;
            msg.Publish("Reminder", BusAction.Info, info);

            await UpdateReminder(rem);
        }

        // UI-Update anfordern, da der Callback vom Background-Timer aufgerufen wird
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateReminder(IDTO item)
    {
        if (item == null)
            throw new Exception("null Item");

        string Intervall = item["Intervall"].ToSecureString();
        DateTime date = item["Date"].ToSecureDateTime();

        if (Intervall == "Tag")
        {
            item["Date"] = date.AddDays(1).ToDateField();
        }
        if (Intervall == "Woche")
        {
            item["Date"] = date.AddDays(7).ToDateField();
        }
        if (Intervall == "Monat")
        {
            item["Date"] = date.AddMonths(1).ToDateField();
        }

        await sql.Update(item);

    }

    public void Dispose()
    {
        // Entfernt die Registrierung beim Zerstören der Komponente
        timer.Unregister(registrationKey);
    }
}