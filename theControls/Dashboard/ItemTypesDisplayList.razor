@inject IAppService app
@inject ILocalizationService loc
@inject NavigationManager nm

<div class="border rounded-2 bg-surface p-2 @CSS">
    <div class="border-bottom py-1">
        <strong>@loc.GetLabel("Inhaltstypen", "ItemTypes")</strong>
    </div>
    <div class="py-1 overflow-y-auto" style="max-height:21rem;">
        
        @foreach (IItemType itemtype in ItemTypes)
        {
            <div class="d-flex gap-1 p-1 hover">
                <div class="flex-fill fw-bold hover pointer rounded-2"
                    @onclick="@( e => { nm.NavToLibrary(itemtype.Name, itemtype.Typ); } )">
                    @itemtype.ToString()
                </div>
            </div>
        }

    </div>

</div>


@code {

    List<IItemType> ItemTypes { get; set; } = new();

    [Parameter]
    public string CSS { get; set; } = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (app.App == null)
            return;

        ItemTypes = await app.App.GetItemTypes(AssociationTyp.Children);
    }

}
