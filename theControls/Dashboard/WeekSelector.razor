

<div class="text-center">
    <div class="row g-0">
        <div class="col-3 p-2">
        </div>
        <div class="col-6 glass p-2">
            <h1 class="h1">@Now.Year.ToString()</h1>
        </div>
        <div class="col-3 p-2">
        </div>
        <div class="col-3 glass p-2 align-middle">
            <SymbolIcon Symbol="Icon.Previous" />
        </div>
        <div class="col-6 glass p-2">
            <h1 class="display-3">
                W @Now.WeekOfYear().ToSecureString()
            </h1>
            <h3 class="h3">
                @Now.ToLongDateString()
            </h3>
        </div>
        <div class="col-3 glass p-2  align-middle">
            <SymbolIcon Symbol="Icon.Next" />
        </div>
    </div>
</div>

@code {

    [Parameter]
    public DateTime Now { get; set; } = DateTime.Now;



}
