


<div class="text-center bg-surface rounded-2 p-2">
    <div class="row g-0 align-items-center">

        <div class="col-3 p-2">
            <div class="pointer hover rounded-2 p-5" @onclick="PreviousWeek">
                <SymbolIcon Symbol="Icon.Previous" />
            </div>
        </div>
        <div class="col-6 p-2 rounded-2">
            <h1 class="display-6 fw-bold">@Now.Year.ToString()</h1>
            <h1 class="display-3">
                W @Now.WeekOfYear().ToSecureString()
            </h1>
            <h3 class="h3">
                @Now.ToString("dddd, d. MMMM", new System.Globalization.CultureInfo("de-DE"))
            </h3>
        </div>
        <div class="col-3 p-2" >
            <div class="pointer hover rounded-2 p-5" @onclick="NextWeek">
                <SymbolIcon Symbol="Icon.Next" />
            </div>
        </div>
        <div class="row text-center my-2">
            @foreach (var day in GetWeekDates())
            {
                <div class="col py-1">
                    <div class="fw-bold py-1">@day.ToString("ddd", CultureInfo.CurrentCulture)</div>
                    <small class="p-1 @(day.Date == DateTime.Today ? "glass text-white rounded" : "")">
                        @day.ToString("dd.MM.")</small>
                </div>
            }
        </div>
    </div>
</div>



@code {

    [Parameter]
    public DateTime Now { get; set; } = DateTime.Now;

    [Parameter]
    public EventCallback<DateTime> DateChanged { get; set; }

    private async Task NextWeek()
    {
        Now = Now.AddDays(7);
        await DateChanged.InvokeAsync(Now);
    }

    private async Task PreviousWeek()
    {
        Now = Now.AddDays(-7);
        await DateChanged.InvokeAsync(Now);
    }
    private IEnumerable<DateTime> GetWeekDates()
    {
        // Ermittelt den Montag der aktuellen Woche (nach ISO 8601 / deutschem Kalender)
        int diff = (7 + (Now.DayOfWeek - DayOfWeek.Monday)) % 7;
        DateTime startOfWeek = Now.Date.AddDays(-1 * diff);

        return Enumerable.Range(0, 7).Select(offset => startOfWeek.AddDays(offset));
    }

}
