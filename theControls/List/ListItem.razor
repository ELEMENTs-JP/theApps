@using theControls.Icons

@inherits BaseRow

@if (Context != null)
{
    <div id="@( Item.GUID.ToSecureString() )" class="row g-0 p-1 hover align-items-center drag">

        @if (IsSortable)
        {
            <div class="col-auto grab">
                <SymbolIcon Symbol="Icon.Grib" CSS="" Style="cursor:move; margin-top:-3px;" Color="#999" />
            </div>
        }

        <div class="col-auto p-1 text-muted" title="@Item.GUID">@(Item.ID.ToSecureString())</div>
        
        <div class="col p-1 px-2 fw-bold pointer text-truncate text-nowrap" title="@Item.ItemType"
            @onclick="@( e => { nm.NavToItem(Context.ItemType.Name, Item.GUID); })">
            @(Item.Title.ToSecureString())
        </div>

  @*       @foreach (IField col in Context.ItemType.GetFields().Result.Where(f => f.Typ != FieldTyp.HR))
        {
            <div class="@Helper.GetClassByDevice(col) align-items-center">
                @Item[col.Column].ToSecureString())
            </div>
        } *@

        @if (IsRelated)
        {
            <div class="col-auto p-1" title="@( Item["Sort"].ToSecureString() )">
                <small class="text-muted " >@(Item.RelationType)</small>
            </div>

            <div class="col-auto p-1">
                <SymbolIcon Symbol="Icon.Disconnect" CSS="pointer hover"
                            OnClick="@( async  e => { await Disconnect(); })" />
            </div>
            
        }
    </div>
}

@code {

    [Parameter]
    public bool IsSortable { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
    }

}
