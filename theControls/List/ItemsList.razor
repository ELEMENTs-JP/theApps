@inherits BaseList

@inject NavigationManager nm

@if (Context != null && ItemType != null)
{
    @if (Context.ItemType != null && Context.ItemType.GetFields().Result != null)
    {
        <SortableContainer Zone="@( "Default")" MinStyleHeight=""
                           Items="@Context.Items">
            <ItemTemplate Context="item">
                <ListItem @key="@item.GUID" Context="@Context" Item="@item"
                          IsRelated="@( (RelatedItem != null))" IsSortable="@IsSortable" ShowID="@ShowID" />
            </ItemTemplate>
        </SortableContainer>

    }
}


@code {

    [Parameter]
    public bool IsSortable { get; set; } = true;

    [Parameter]
    public bool ShowID { get; set; } = true;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (Context == null && ItemType != null)
        {
            Context = new QueryContext(sql, sec, ItemType);
        }
        if (Context != null)
        {
            // ItemType 
            Context.ItemType = ItemType;

            if (RelatedItem != null)
            {
                Context.Items = await Context.RelatedItems(Context.ItemType.Name, Association);
            }
            else
            {
                await Context.Search();
            }
        }
    }

  

}
