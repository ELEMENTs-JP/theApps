@inherits BaseList
@implements IAsyncDisposable

@inject NavigationManager nm

@if (!string.IsNullOrEmpty(this.Title))
{
    <div class="h3 py-1 text-secondary d-flex">
        @Title
    </div>
}

@if (Context != null && ItemType != null)
{
    @if (Context.ItemType != null && Context.ItemType.GetFields().Result != null)
    {
        @if (ShowProgressBar)
        {
            <ProgressBar Value="@Progress" CSS="border-top p-1" />
        }

        <SortableContainer Zone="@( "Default")" MinStyleHeight=""
                           Items="@Context.Items">
            <ItemTemplate Context="item">
                <ListItem @key="@item.GUID" ItemType="@ItemType" Item="@item" RelatedItem="@RelatedItem" 
                            ExtendedView="@ExtendedView"
                          OnConnect="@( async e => { await OnConnect.InvokeAsync(e); })"
                          OnDelete="@( async e => { await OnDelete.InvokeAsync(e); })"
                          OnUpdate="@( async e => { await OnUpdate.InvokeAsync(e); })"
                          OnDisconnect="@( async e => { await OnDisconnect.InvokeAsync(e); })"
                          IsRelated="@( (RelatedItem != null))" IsSortable="@IsSortable" ShowID="@ShowID" />
            </ItemTemplate>
        </SortableContainer>

    }
}


@code {

    [Parameter]
    public bool IsSortable { get; set; } = true;

    [Parameter]
    public bool ShowID { get; set; } = true;

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public bool ExtendedView { get; set; } = false;

    // Events
    protected override async Task OnInitializedAsync()
    {
    
    }


       
    [Parameter]
    public EventCallback<IDTO> OnUpdate { get; set; }

    [Parameter]
    public EventCallback<IDTO> OnDisconnect { get; set; }

    [Parameter]
    public EventCallback<IDTO> OnConnect { get; set; }

    [Parameter]
    public EventCallback<IDTO> OnDelete { get; set; }



    public async ValueTask DisposeAsync()
    {
        try
        {

        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : DISPOSE : BoardComp : " + ex.Message);
        }
    }

}
