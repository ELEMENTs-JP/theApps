@inject IJSRuntime JS
@inject ISqlDatabaseService sql
@inject ISecurityService sec
@inject IMessagingBusService msg
@implements IAsyncDisposable

@if (Item != null)
{

    <table class="w-100 border-0 p-0 m-0">
        <tr>
            <td class="border-0 p-0 m-0 text-center" style="width:1.5rem;"></td>
            <td class="border-0 p-0 m-0 text-center" style="width:49%;"><strong>Bestehende Produkte</strong></td>
            <td class="border-0 p-0 m-0 text-center" style="width:49%;"><strong>Neue Produkte</strong></td>
        </tr>
        <tr>
            <td class="border-0 p-0 m-0 text-vertikal d-flex align-items-center justify-content-center" 
                        style="height:18rem;">
                <strong>Bestehende Märkte</strong>
            </td>
            <td class="border-0 p-2 m-0" style="height:18rem;">
                <DragDropContainer Zone="Marktdurchdringung" Title="Marktdurchdringung" Entries="@Items" 
                                        CSS="border rounded-2 p-2 h-100 "
                                   ZoneProperty="@( $"{ZoneParameter}" )"
                                   SortProperty="@( $"{SortParameter}" )"
                                   ItemDragEnd="@( async e => { Items.ReplaceByItem(e);  })">
                    <ItemTemplate Context="entry">

                        <ListItem @key="@entry.GUID" Item="@entry"
                                  IsSortable="true" CSS="border rounded-2 p-1 m-2"
                                  ItemType="@( new Factory(sql).BuildItemType(entry.ItemType).Result )" />

                    </ItemTemplate>
                </DragDropContainer>
            </td>
            <td class="border-0 p-2 m-0" style="height:18rem;">
                <DragDropContainer Zone="Produktentwicklung" Title="Produktentwicklung" Entries="@Items" 
                                CSS="border rounded-2 p-2 h-100 "
                                   ZoneProperty="@( $"{ZoneParameter}" )"
                                   SortProperty="@( $"{SortParameter}" )"
                                   ItemDragEnd="@( async e => { Items.ReplaceByItem(e);  })">
                    <ItemTemplate Context="entry">

                        <ListItem @key="@entry.GUID" Item="@entry"
                                  IsSortable="true" CSS="border rounded-2 p-1 m-2"
                                  ItemType="@( new Factory(sql).BuildItemType(entry.ItemType).Result )" />

                    </ItemTemplate>
                </DragDropContainer>
            </td>
        </tr>
        <tr>
            <td class="border-0 p-0 m-0 text-vertikal d-flex align-items-center justify-content-center" 
                    style="height:18rem;">
                <strong>Neue Märkte</strong>
                </td>
            <td class="border-0 p-2 m-0" style="height:18rem;">
                <DragDropContainer Zone="Marktentwicklung" Title="Marktentwicklung" Entries="@Items" 
                                    CSS="border rounded-2 p-2 h-100 "
                                   ZoneProperty="@( $"{ZoneParameter}" )"
                                   SortProperty="@( $"{SortParameter}" )"
                                   ItemDragEnd="@( async e => { Items.ReplaceByItem(e);  })">
                    <ItemTemplate Context="entry">

                        <ListItem @key="@entry.GUID" Item="@entry"
                                  IsSortable="true" CSS="border rounded-2 p-1 m-2"
                                  ItemType="@( new Factory(sql).BuildItemType(entry.ItemType).Result )" />

                    </ItemTemplate>
                </DragDropContainer>
            </td>
            <td class="border-0 p-2 m-0" style="height:18rem;">
                <DragDropContainer Zone="Diversifikation" Title="Diversifikation" Entries="@Items" 
                                    CSS="border rounded-2 p-2 h-100 "
                                   ZoneProperty="@( $"{ZoneParameter}" )"
                                   SortProperty="@( $"{SortParameter}" )"
                                   ItemDragEnd="@( async e => { Items.ReplaceByItem(e);  })">
                    <ItemTemplate Context="entry">

                        <ListItem @key="@entry.GUID" Item="@entry"
                                  IsSortable="true" CSS="border rounded-2 p-1 m-2"
                                  ItemType="@( new Factory(sql).BuildItemType(entry.ItemType).Result )" />

                    </ItemTemplate>
                </DragDropContainer>
            </td>
        </tr>
    </table>

    <div class="p-2" style="height:11rem;">
        <DragDropContainer Zone="Default" Title="Backlog" Entries="@Items" 
                            CSS="bg-background border rounded-2 p-2 h-100 "
                           ZoneProperty="@( $"{ZoneParameter}" )"
                           SortProperty="@( $"{SortParameter}" )"
                           IsDefaultZone="true"
                           ItemDragEnd="@( async e => { Items.ReplaceByItem(e);  })">
            <ItemTemplate Context="entry">

                <ListItem @key="@entry.GUID" Item="@entry" IsSortable="true" CSS="border rounded-2 p-1 m-2"
                          ItemType="@( new Factory(sql).BuildItemType(entry.ItemType).Result )" />

            </ItemTemplate>
        </DragDropContainer>
    </div>

}

@code {

    [Parameter]
    public IDTO Item { get; set; } // Board

    private List<IDTO> Items { get; set; } = new();

    private string ZoneParameter { get; set; } = string.Empty;
    private string SortParameter { get; set; } = string.Empty;

    // CTR
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        msg.OnMessage += OnMessageDone;
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (Item != null)
        {
            ZoneParameter = "Zone-Board-Kanban-" + Item.GUID;
            SortParameter = "Sort-Board-Kanban-" + Item.GUID;
        }

        await Init();
    }

    private async Task Init()
    {
        // Items
        Items.Clear();

        // Item
        if (Item == null)
            return;

        // ItemType
        string ItemType = Item["ItemType"].ToSecureString();
        if (string.IsNullOrEmpty(ItemType))
            return;

        // Query
        IQueryParameter qp = QueryParameter.Default(".");
        qp.MasterGUID = sql.MasterGUID;
        qp.ItemType = ItemType;

        // Run
        IQueryResult result = await sql.GetItems(qp);
        Items = result.Items;
    }

    public async void OnMessageDone(AppMessage msg)
    {
        if (msg.Id == "Item" && msg.Action == BusAction.Refresh)
        {
            // Update
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            msg.OnMessage -= OnMessageDone;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : DISPOSE : BoardComp : " + ex.Message);
        }
    }

}
