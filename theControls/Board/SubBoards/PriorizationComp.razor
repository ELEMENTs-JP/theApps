}

@code {

    [Parameter]
    public IDTO Item { get; set; } // Board

    private List<IDTO> Items { get; set; } = new();
    private List<DragCanvas<IDTO>.Item<IDTO>> Entries = new();

    private string ZoneParameter { get; set; } = string.Empty;
    private string TopParameter { get; set; } = string.Empty;
    private string LeftParameter { get; set; } = string.Empty;

    // CTR
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        msg.OnMessage += OnMessageDone;
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (Item != null)
        {
            ZoneParameter = $"Zone-Board-{this.GetType().Name}-" + Item.GUID;
            TopParameter = $"Top-Board-{this.GetType().Name}-" + Item.GUID;
            LeftParameter = $"Left-Board-{this.GetType().Name}-" + Item.GUID;
        }

        await Init();
    }

    private async Task Init()
    {
        // Items
        Items.Clear();

        // Item
        if (Item == null)
            return;

        // ItemType
        string ItemType = Item["ItemType"].ToSecureString();
        if (string.IsNullOrEmpty(ItemType))
            return;

        // Query
        IQueryParameter qp = QueryParameter.Default(".");
        qp.MasterGUID = sql.MasterGUID;
        qp.ItemType = ItemType;

        // Run
        IQueryResult result = await sql.GetItems(qp);
        Items = result.Items;

        Entries.Clear();
        foreach (IDTO item in Items)
        {
            DragCanvas<IDTO>.Item<IDTO> dto = new();

            dto.Guid = item.GUID;
            dto.Data = item;
            dto.Left = item[LeftParameter].ToSecureDouble();
            dto.Top = item[TopParameter].ToSecureDouble();

            string zone = item[ZoneParameter].ToSecureString();
            if (string.IsNullOrEmpty(zone))
            {
                item[ZoneParameter] = "Default";
            }

            Entries.Add(dto);
        }
    }

    private async Task HandleItemDropped(DragCanvas<IDTO>.DropResult<IDTO> result)
    {
        if (!Guid.TryParse(result.Guid, out Guid itemGuid))
            return;

        // Element aus allen Listen suchen
        var item = Entries.FirstOrDefault(i => i.Guid == itemGuid);

        if (item == null)
            return;

        // Aus bestehenden Listen entfernen
        Entries.Remove(item);

        // Neue Koordinaten zuweisen
        item.Left = result.Left;
        item.Top = result.Top;

        item.Data[LeftParameter] = result.Left.ToSecureString();
        item.Data[TopParameter] = result.Top.ToSecureString();
        item.Data[ZoneParameter] = result.TargetCanvasId;

        await sql.Update(item.Data);

        // In die Zielliste einfügen
        Entries.Add(item);

        await InvokeAsync(StateHasChanged);
    }

    public async void OnMessageDone(AppMessage msg)
    {
        if (msg.Id == "Item" && msg.Action == BusAction.Refresh)
        {
            // Update
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            msg.OnMessage -= OnMessageDone;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : DISPOSE : BoardComp : " + ex.Message);
        }
    }

}
