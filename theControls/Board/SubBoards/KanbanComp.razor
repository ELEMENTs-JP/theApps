@inject IJSRuntime JS
@inject ISqlDatabaseService sql
@inject ISecurityService sec
@inject IMessagingBusService msg
@implements IAsyncDisposable

@if (Item != null)
{
    <div class="overflow-x-auto p-2">
        <div class="d-flex flex-nowrap gap-3">
            <div class="flex-shrink-0" style="width:18rem; height:21rem;">
                <DragDropContainer Zone="InPlanung" Title="in Planung" Entries="@Items" CSS="h-100 border rounded-2 p-2"
                                   ZoneProperty="@( $"{ZoneParameter}" )"
                                   SortProperty="@( $"{SortParameter}" )"
                                   ItemDragEnd="@( async e => { Items.ReplaceByItem(e);  })">
                    <ItemTemplate Context="entry">

                        <ListItem @key="@entry.GUID" Item="@entry"
                                  IsSortable="true" CSS="border rounded-2 p-1 m-2"
                                  ItemType="@( new Factory(sql).BuildItemType(entry.ItemType).Result )" />

                    </ItemTemplate>
                </DragDropContainer>
            </div>
            <div class="flex-shrink-0" style="width:18rem; height:21rem;">
                <DragDropContainer Zone="InBearbeitung" Title="in Bearbeitung" Entries="@Items" CSS="h-100 border rounded-2 p-2 "
                                   ZoneProperty="@( $"{ZoneParameter}" )"
                                   SortProperty="@( $"{SortParameter}" )"
                                   ItemDragEnd="@( async e => { Items.ReplaceByItem(e);  })">
                    <ItemTemplate Context="entry">

                        <ListItem @key="@entry.GUID" Item="@entry" IsSortable="true" CSS="border rounded-2 p-1 m-2"
                                  ItemType="@( new Factory(sql).BuildItemType(entry.ItemType).Result )" />

                    </ItemTemplate>
                </DragDropContainer>
            </div>
            <div class="flex-shrink-0" style="width:18rem; height:21rem;">
                <DragDropContainer Zone="Review" Title="Review" Entries="@Items" CSS="h-100  border rounded-2 p-2"
                                   ZoneProperty="@( $"{ZoneParameter}" )"
                                   SortProperty="@( $"{SortParameter}" )"
                                   ItemDragEnd="@( async e => { Items.ReplaceByItem(e);  })">
                    <ItemTemplate Context="entry">

                        <ListItem @key="@entry.GUID" Item="@entry" IsSortable="true" CSS="border rounded-2 p-1 m-2"
                                  ItemType="@( new Factory(sql).BuildItemType(entry.ItemType).Result )" />

                    </ItemTemplate>
                </DragDropContainer>
            </div>
            <div class="flex-shrink-0" style="width:18rem; height:21rem;">
                <DragDropContainer Zone="Zurückgestellt" Title="zurückgestellt" Entries="@Items" CSS="h-100  border rounded-2 p-2"
                                   ZoneProperty="@( $"{ZoneParameter}" )"
                                   SortProperty="@( $"{SortParameter}" )"
                                   ItemDragEnd="@( async e => { Items.ReplaceByItem(e);  })">
                    <ItemTemplate Context="entry">

                        <ListItem @key="@entry.GUID" Item="@entry" IsSortable="true" CSS="border rounded-2 p-1 m-2"
                                  ItemType="@( new Factory(sql).BuildItemType(entry.ItemType).Result )" />

                    </ItemTemplate>
                </DragDropContainer>
            </div>
            <div class="flex-shrink-0" style="width:18rem; height:21rem;">
                <DragDropContainer Zone="Abgeschlossen" Title="abgeschlossen" Entries="@Items" CSS="h-100 border rounded-2 p-2 "
                                   ZoneProperty="@( $"{ZoneParameter}" )"
                                   SortProperty="@( $"{SortParameter}" )"
                                   ItemDragEnd="@( async e => { Items.ReplaceByItem(e);  })">
                    <ItemTemplate Context="entry">

                        <ListItem @key="@entry.GUID" Item="@entry" IsSortable="true" CSS="border rounded-2 p-1 m-2"
                                  ItemType="@( new Factory(sql).BuildItemType(entry.ItemType).Result )" />

                    </ItemTemplate>
                </DragDropContainer>
            </div>
        </div>
    </div>

    <div class="p-2">
        <DragDropContainer Zone="Default" Title="Backlog" Entries="@Items" CSS="bg-background border rounded-2 p-2 "
                           ZoneProperty="@( $"{ZoneParameter}" )"
                           SortProperty="@( $"{SortParameter}" )"
                           IsDefaultZone="true"
                           ItemDragEnd="@( async e => { Items.ReplaceByItem(e);  })">
            <ItemTemplate Context="entry">

                <ListItem @key="@entry.GUID" Item="@entry" IsSortable="true" CSS="border rounded-2 p-1 m-2"
                          ItemType="@( new Factory(sql).BuildItemType(entry.ItemType).Result )" />

            </ItemTemplate>
        </DragDropContainer>
    </div>

}

@code {

    [Parameter]
    public IDTO Item { get; set; } // Board

    private List<IDTO> Items { get; set; } = new();

    private string ZoneParameter { get; set; } = string.Empty;
    private string SortParameter { get; set; } = string.Empty;

    // CTR
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        msg.OnMessage += OnMessageDone;
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (Item != null)
        {
            ZoneParameter = "Zone-Board-Kanban-" + Item.GUID;
            SortParameter = "Sort-Board-Kanban-" + Item.GUID;
        }

        await Init();
    }

    private async Task Init()
    {
        // Items
        Items.Clear();

        // Item
        if (Item == null)
            return;

        // ItemType
        string ItemType = Item["ItemType"].ToSecureString();
        if (string.IsNullOrEmpty(ItemType))
            return;

        // Query
        IQueryParameter qp = QueryParameter.Default(".");
        qp.MasterGUID = sql.MasterGUID;
        qp.ItemType = ItemType;

        // Run
        IQueryResult result = await sql.GetItems(qp);
        Items = result.Items;
    }

    public async void OnMessageDone(AppMessage msg)
    {
        if (msg.Id == "Item" && msg.Action == BusAction.Refresh)
        {
            // Update
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            msg.OnMessage -= OnMessageDone;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : DISPOSE : BoardComp : " + ex.Message);
        }
    }

}
