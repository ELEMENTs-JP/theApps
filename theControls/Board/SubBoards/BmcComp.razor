@inject IJSRuntime JS
@inject ISqlDatabaseService sql
@inject ISecurityService sec
@inject IMessagingBusService msg
@implements IAsyncDisposable

@if (Item != null)
{


    <div class="p-2 d-grid gap-3" style="
            grid-template-columns: repeat(10, 1fr);
            grid-template-rows: repeat(3, auto);
            grid-template-areas:
            'kp kp ka ka vp vp cr cr cs cs'
            'kp kp kr kr vp vp ch ch cs cs'
            'cs-struct cs-struct cs-struct cs-struct cs-struct rev rev rev rev rev';
            ">
            <!-- Schlüsselpartner (Spalte 1-2, Zeile 1-2) -->
            <div class="border rounded p-1" style="grid-area: kp;">
                <DragDropContainer Zone="KeyPartner" Title="Partner" Entries="@Items" CSS="p-1"
                               ZoneProperty="@( $"{ZoneParameter}" )"
                               SortProperty="@( $"{SortParameter}" )"
                                   ItemDragEnd="@( async e => { Items.ReplaceByItem(e); })">
                    <ItemTemplate Context="entry">
                        <ListItem @key="@entry.GUID" Item="@entry"
                                  IsSortable="true" CSS="border rounded-2 p-1 m-2"
                                  ItemType="@( new Factory(sql).BuildItemType(entry.ItemType).Result )" />
                    </ItemTemplate>
                </DragDropContainer>
            </div>

            <!-- Schlüsselaktivitäten (Spalte 3-4, Zeile 1) -->
            <div class="border rounded p-1" style="grid-area: ka;">
                <DragDropContainer Zone="KeyActivities" Title="Activities" Entries="@Items" CSS="p-1"
                               ZoneProperty="@( $"{ZoneParameter}" )"
                               SortProperty="@( $"{SortParameter}" )"
                                   ItemDragEnd="@( async e => { Items.ReplaceByItem(e); })">
                    <ItemTemplate Context="entry">
                        <ListItem @key="@entry.GUID" Item="@entry"
                                  IsSortable="true" CSS="border rounded-2 p-1 m-2"
                                  ItemType="@( new Factory(sql).BuildItemType(entry.ItemType).Result )" />
                    </ItemTemplate>
                </DragDropContainer>
            </div>

            <!-- Schlüsselressourcen (Spalte 3-4, Zeile 2) -->
            <div class="border rounded p-1" style="grid-area: kr;">
                <DragDropContainer Zone="KeyRessourcen" Title="Ressourcen" Entries="@Items" CSS="p-1"
                               ZoneProperty="@( $"{ZoneParameter}" )"
                               SortProperty="@( $"{SortParameter}" )"
                                   ItemDragEnd="@( async e => { Items.ReplaceByItem(e); })">
                    <ItemTemplate Context="entry">
                        <ListItem @key="@entry.GUID" Item="@entry"
                                  IsSortable="true" CSS="border rounded-2 p-1 m-2"
                                  ItemType="@( new Factory(sql).BuildItemType(entry.ItemType).Result )" />
                    </ItemTemplate>
                </DragDropContainer>
            </div>

            <!-- Wertversprechen (Spalte 5-6, Zeile 1-2 - Zentriert über 2 Spalten) -->
            <div class="border rounded p-1" style="grid-area: vp;">
                <DragDropContainer Zone="ValueProposition" Title="Value Proposition" Entries="@Items" CSS="p-1"
                               ZoneProperty="@( $"{ZoneParameter}" )"
                               SortProperty="@( $"{SortParameter}" )"
                                   ItemDragEnd="@( async e => { Items.ReplaceByItem(e); })">
                    <ItemTemplate Context="entry">
                        <ListItem @key="@entry.GUID" Item="@entry"
