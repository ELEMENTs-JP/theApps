                                  ItemType="@( new Factory(sql).BuildItemType(entry.ItemType).Result )" />
                    </ItemTemplate>
                </DragDropContainer>
            </div>

            <!-- Kostenstruktur (Spalte 1-5, Zeile 3 - Exakt linke Hälfte) -->
            <div class="border rounded p-1" style="grid-area: cs-struct;">
                <DragDropContainer Zone="Cost" Title="Cost Structure" Entries="@Items" CSS="p-1"
                               ZoneProperty="@( $"{ZoneParameter}" )"
