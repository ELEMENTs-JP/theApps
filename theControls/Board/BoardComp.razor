@using theControls.Board.SubBoards

@inject IJSRuntime JS
@inject ISqlDatabaseService sql
@inject ISecurityService sec
@inject IMessagingBusService msg
@implements IAsyncDisposable

@if (Item != null)
{
    <Frame Border="true" >
        <Header>
            <ControlHeader PreTitle="Board" Title="@Item.Title" 
                    PostTitle="@Item.ItemType"  Description="@Item.Description()"  />
        </Header>
    
        <Content>

            @if (Typ == "Backlog")
            {
                <BacklogComp Item="@Item" />    
            }

        </Content>
    </Frame>

}

@code {

    [Parameter]
    public IDTO Item { get; set; } // Board 

    [Parameter]
    public string Typ { get; set; } = string.Empty;


    // CTR
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        msg.OnMessage += OnMessageDone;
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

    
    }

    public async void OnMessageDone(AppMessage msg)
    {
        if (msg.Id == "Item" && msg.Action == BusAction.Refresh)
        {
    
            // Update
            await InvokeAsync(StateHasChanged);
        }
    }


    
    public async ValueTask DisposeAsync()
    {
        try
        {
            msg.OnMessage -= OnMessageDone;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : DISPOSE : BoardComp : " + ex.Message);
        }
    }

}
