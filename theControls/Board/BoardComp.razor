@using theControls.Board.SubBoards

@inject IJSRuntime JS
@inject ISqlDatabaseService sql
@inject ISecurityService sec
@inject IMessagingBusService msg
@implements IAsyncDisposable

@if (Item != null)
{
  
        <Frame Border="true" ContentCSS=" p-2 overflow-x-auto " ContentStyle="min-width:0; max-width:100%;">
        <Header>
            <ControlHeader PreTitle="@Item.ItemType" Title="@Item.Title" 
                    PostTitle="@Typ"  Description="@Item.Description()"  />
        </Header>
    
        <Content>

            @if (Typ == "Backlog")
            {
                <BacklogComp Item="@Item" />    
            }
            else if (Typ == "Kanban")
            {
                <KanbanComp Item="@Item" />
            }
            else if (Typ == "Business Model Canvas")
            {
                <BmcComp Item="@Item" />    
            }
            else if (Typ == "Balanced Scorecard")
            {
                <BscComp Item="@Item" />
            }
            else if (Typ == "Moscow Priorisierung")
            {
                <MoscowComp Item="@Item"/>    
            }
            else if (Typ == "Idea Funnel")
            {
                <IdeaFunnelComp Item="@Item" />
            }
            else if (Typ == "Bug Tracking")
            {
                <BugTrackingComp Item="@Item" />
            }
            else if (Typ == "Incident Tracking")
            {
                <IncidentComp Item="@Item" />
            }
            else if (Typ == "Task Priorities")
            {
                <TaskPriorityComp Item="@Item" />
            }
            else if (Typ == "Task Status")
            {
                <TaskStatusComp Item="@Item" />
            }
            else if (Typ == "Ansoff Matrix")
            {
                <AnsoffComp Item="@Item" />
            }
            else if (Typ == "Risiko Matrix")
            {
                <RisikoComp Item="@Item" />
            }
            else if (Typ == "Change Management")
            {
                <ChangeMngtComp Item="@Item" />
            }
            else if (Typ == "Brand Positioning")
            {
                <BrandComp Item="@Item" />
            }
              else if (Typ == "Priorization")
            {
                <PriorizationComp Item="@Item" />
            }
            else if (Typ == "SWOT")
            {
                <SwotComp Item="@Item" />
            }
            else if (Typ == "PESTEL")
            {
                <PestelComp Item="@Item" />
            }
        </Content>
    </Frame>
  

}

@code {

    [Parameter]
    public IDTO Item { get; set; } // Board 

    [Parameter]
    public string Typ { get; set; } = string.Empty;


    // CTR
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        
        msg.OnMessage += OnMessageDone;
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

    
    }

    public async void OnMessageDone(AppMessage msg)
    {
        if (msg.Id == "Item" && msg.Action == BusAction.Refresh)
        {
    
            // Update
            await InvokeAsync(StateHasChanged);
        }
    }


    
    public async ValueTask DisposeAsync()
    {
        try
        {
            msg.OnMessage -= OnMessageDone;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : DISPOSE : BoardComp : " + ex.Message);
        }
    }

}
