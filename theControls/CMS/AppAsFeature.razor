@using theControls.Input
@inject ILocalizationService loc
@inject ISecurityService sec
@inject IMessagingBusService msg
@inject ISqlDatabaseService sql
@inject IAppService appService


<div class="border-bottom pb-2 mb-2">
    <h1 class="h1 w-100">Integrated Apps</h1>
</div>

@if (loc.Configuration != null)
{
    <div class="overflow-y-auto" style="max-height:40rem;">

        <div class="border-bottom p-2">
            <span class="text-muted">Mit der Aktivierung eines App Templates muss die App und deren ItemTypes <a href="/Items/App">hier</a> noch konfiguriert werden.</span>
        </div>

        @foreach (string group in Apps.Select(se => se.Group).Distinct())
        {

            <div class="fw-bold text-secondary px-2 pt-3 pb-1">
                @group
            </div>

            @foreach (ITemplateApp app in Apps.Where(se => se.Group == group))
            {
                <div class="row g-0 align-items-center bg-surface border-bottom p-1 my-1">
                    <div class="col p-1">
                        <div class="fw-bold">
                            @app.Title
                        </div>
                        <div class="text-muted">@loc.GetLabel("aktiviert / deaktiviert", "active / inactive")</div>
                    </div>
                    <div class="col-auto p-1">
                        <CheckBox Value="@( (IsActive(app).Result != null ? "true" : "false") )"
                                  TrueText="@loc.GetLabel("aktiviert", "active")"
                                  FalseText="@loc.GetLabel("inaktiv", "inactive")"
                                  ValueChanged="@(async e => { await CreateDeleteApp(app, e.ToSecureBool()); })" />
                    </div>
                </div>
            }
        }



    </div>
}



@code {

    List<ITemplateApp> Apps { get; set; } = new();
    List<IDTO> AllDbApps { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        Apps = TemplateAppFactory.GetAllTemplateApps();

        await Init();
    }
    private async Task Init()
    {
        IQueryParameter qp = QueryParameter.Default(".");
        qp.MasterGUID = sql.MasterGUID;
        qp.ItemType = "App";

        IQueryResult result = await sql.GetItems(qp);
        AllDbApps = result.Items;
    }
    private async Task<IDTO> IsActive(ITemplateApp app)
    {
        if (app != null)
        {
            IDTO? activeApp = AllDbApps.Find(se =>
                string.Equals(se.ID, app.Name, StringComparison.InvariantCultureIgnoreCase) ||
                string.Equals(se.Title, app.Name, StringComparison.InvariantCultureIgnoreCase) ||
                string.Equals(se.ID, app.Title, StringComparison.InvariantCultureIgnoreCase) ||
                string.Equals(se.Title, app.Title, StringComparison.InvariantCultureIgnoreCase));

            if (activeApp != null)
            {
                return activeApp;
            }
        }
        return null;
    }

    private async Task CreateDeleteApp(ITemplateApp app, bool value)
    {
        if (app != null)
        {
            await Init();

            IDTO? isActive = await IsActive(app);
            if (isActive != null)
            {
                // löschen
                if (value == false)
                {
                    IQueryParameter qp = QueryParameter.Default(app.Title);
                    qp.MasterGUID = sql.MasterGUID;
                    qp.ItemType = "App";

                    IQueryResult result = await sql.GetItems(qp);

                    IDTO? activeApp = result.Items.Find(se =>
                        string.Equals(se.ID, app.Name, StringComparison.InvariantCultureIgnoreCase) ||
                        string.Equals(se.Title, app.Name, StringComparison.InvariantCultureIgnoreCase) ||
                        string.Equals(se.ID, app.Title, StringComparison.InvariantCultureIgnoreCase) ||
                        string.Equals(se.Title, app.Title, StringComparison.InvariantCultureIgnoreCase));

                    if (activeApp != null)
                    {
                        // App
                        await sql.Delete(activeApp);

                        // ItemTypes
                        await DeleteAllItemTypesByApp(app);
                    }
                }
            }
            else
            {
                // erstellen
                if (value == true)
                {
                    IQueryParameter qp = QueryParameter.Default(app.Title);
                    qp.MasterGUID = sql.MasterGUID;
                    qp.ItemType = "App";

                    IQueryResult result = await sql.GetItems(qp);

                    IDTO? activeApp = result.Items.Find(se =>
                        string.Equals(se.ID, app.Name, StringComparison.InvariantCultureIgnoreCase) ||
                        string.Equals(se.Title, app.Name, StringComparison.InvariantCultureIgnoreCase) ||
                        string.Equals(se.ID, app.Title, StringComparison.InvariantCultureIgnoreCase) ||
                        string.Equals(se.Title, app.Title, StringComparison.InvariantCultureIgnoreCase));

                    // App existiert nicht
                    if (activeApp == null)
                    {
                        qp = QueryParameter.Default(app.Title);
                        qp.MasterGUID = sql.MasterGUID;
                        qp.ItemType = "App";

                        // App
                        await sql.Create(qp);

                        IQueryResult appResult = await sql.GetItem(qp);
                        IDTO newApp = appResult.Items.FirstOrDefault();
                        if (newApp != null)
                        {
                            // App aktiv schalten
                            newApp["IsActive"] = "true";
                            newApp["Group"] = app.Group;

                            // aktualisieren
                            await sql.Update(newApp);

                            // ItemTypes
                            await CreateItemTypesByApp(app);
                        }

                    }
                }
            }

            // Apps
            appService.Init();

            msg.Publish(new AppMessage("AppList", BusAction.Refresh));
        }

        await Init();
    }
    private async Task DeleteAllItemTypesByApp(ITemplateApp app)
    {
        List<ItemTypeInfo> itemtypes = app.GetItemTypes();

        foreach (ItemTypeInfo info in itemtypes)
        {
            IQueryParameter qp = QueryParameter.Default(".");
            qp.MasterGUID = sql.MasterGUID;
            qp.ItemType = "ItemType";

            IQueryResult result = await sql.GetItems(qp);

            foreach (IDTO it in result.Items.Where(se => se.Title == info.Name))
            {
                await sql.Delete(it);
            }
        }
    }
    private async Task CreateItemTypesByApp(ITemplateApp app)
    {
        await Init();

        IDTO? activeApp = AllDbApps.Find(se =>
            string.Equals(se.ID, app.Name, StringComparison.InvariantCultureIgnoreCase) ||
             string.Equals(se.Title, app.Name, StringComparison.InvariantCultureIgnoreCase) ||
              string.Equals(se.ID, app.Title, StringComparison.InvariantCultureIgnoreCase) ||
               string.Equals(se.Title, app.Title, StringComparison.InvariantCultureIgnoreCase));

        if (activeApp != null)
        {
            List<IDTO> dbItemTypes = sql.GetRelatedItems(activeApp, "ItemType", AssociationTyp.NULL).Result.Items;
            List<ItemTypeInfo> itemtypes = app.GetItemTypes();

            foreach (ItemTypeInfo info in itemtypes)
            {
                IDTO? activeItemType = dbItemTypes.Find(se =>
                        string.Equals(se.ID, info.Name, StringComparison.InvariantCultureIgnoreCase) ||
                        string.Equals(se.Title, info.Name, StringComparison.InvariantCultureIgnoreCase) ||
                            string.Equals(se.ID, info.Title, StringComparison.InvariantCultureIgnoreCase) ||
                            string.Equals(se.Title, info.Title, StringComparison.InvariantCultureIgnoreCase));

                if (activeItemType == null)
                {
                    IQueryParameter qp = QueryParameter.Default(info.Name);
                    qp.MasterGUID = sql.MasterGUID;
                    qp.ItemType = "ItemType";
                    IQueryResult result = await sql.Create(qp);

                    result = await sql.GetItem(qp);
                    IDTO newItemType = result.Items.FirstOrDefault();
                    if (newItemType != null)
                    {
                        await sql.Assign(activeApp, newItemType, AssociationTyp.Children);
                    }
                }
            }
        }

        
    }

    
    private async Task PushFeatureUpdate()
    {
        msg.Publish(new AppMessage("Feature", BusAction.Refresh));
    }

}
