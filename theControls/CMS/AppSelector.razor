@using theControls.Icons
@using theInfrastructure
@inject IAppService app
@inject NavigationManager nm
@inject IMessagingBusService msg
@inject IAppService apps
@inject ISecurityService sec
@implements IAsyncDisposable

<div class="p-3">

    @* --- App Modus (App wurde selektiert) --- *@
    @if (app.App != null)
    {
        @* --- HOME (go back to HOME) --- *@
        <div class="row g-0 rounded-2 hover pointer p-2 m-1"
             @onclick="@( async e => { app.App = null; app.ItemType = null; app.Page = null; nm.NavigateTo("/", false); })">
            <div class="col-auto pe-2"><SymbolIcon Symbol="Icon.Home" /></div>
            <div class="col fw-bold"> Home</div>
            <div class="col-12 text-muted  ps-4">zurück zum Start</div>
        </div>
    }

    
    @* --- HOME Modus --- *@
    @if (app.App == null)
    {
        @if (apps.Configuration.AppSelector == "List")
        {
            <AppSelectionList OnAppSelected="@( async e => { await OnAppSelect(e); })" />
        }
        else if (apps.Configuration.AppSelector == "Popup")
        {
            @* --- App DROP DOWN --- *@
            <div class="w-100 dropdown-center my-1">
                <div class="@(" p-2 hover rounded-2 pointer align-items-center ")"
                     data-bs-toggle="dropdown">
                    <div class="d-flex">
                        <div class="px-1">
                            <SymbolIcon Symbol="Icon.Apps" />
                        </div>
                        <div class="flex-fill fw-bold px-1">
                            Apps
                        </div>
                    </div>
                    <div class="text-muted small ps-4 ms-1">
                        App wählen...
                    </div>
                </div>

                <div class="@( "dropdown-menu w-100")">

                    <div class="d-flex align-items-center border-bottom">
                        <div class="p-2">
                            <SymbolIcon Symbol="Icon.Apps" />
                        </div>
                        <div class="flex-fill p-2 fw-bold">
                            Apps
                        </div>
                    </div>

                    @* --- App List --- *@
                    <div class="overflow-y-auto" style="max-height:40rem;">
                        <AppSelectionList OnAppSelected="@( async e => { await OnAppSelect(e); })" />
                    </div>
                </div>
            </div>
        }

    }

    @* --- App INHALT --- *@
    @if (app.App != null)
    {
        <div class="border-top my-3"></div>

        @* --- APP (selected App) --- *@
        <div class="selected pointer p-2 m-2"
             @onclick="@( async e => { await OnAppSelect(app.App); })">
            <div class="fw-bold">
                @app.App.ToString()
            </div>
            @if (!string.IsNullOrEmpty(app.App.Description))
            {
                <small class="text-muted">
                    @app.App.Description.ToString()
                </small>
            }
        </div>

        @if (CurrentItemTypes.Count() >= 1)
        {
            <div class="border-top my-3"></div>
            <div class="text-muted small fw-bold ps-2">Listen</div>
            <div class="row g-0">
                @foreach (IItemType it in CurrentItemTypes.Where(se => se.IsNavigation == true)
                            .OrderBy(se => se.Order != 0 ? se.Order : int.MaxValue).ThenBy(se => se.Title))
                {
                    <div class="col-12 p-1">
                        <div class="rounded-2 hover pointer p-1 px-2 fw-bold 
                            @( " " + (it.InSubNavigation ? " text-secondary ps-4 " : "" ) )
                                        @( " " + GetItemTypeSelection(it) )"
                             @onclick="@( async e => { await OnItemType(it); })">
                            @it.ToString()
                        </div>
                    </div>

                }
            </div>
        }

        @if (CurrentPages.Count() >= 1)
        {
            <div class="border-top my-3"></div>
            <div class="text-muted small fw-bold ps-2">Pages</div>
            <div class="row g-0">
                @foreach (IDTO _page in CurrentPages)
                {
                    <div class="col-12 p-1">
                        <div class="rounded-2 hover pointer p-1 px-2 fw-bold @( GetPageSelection(_page) )"
                             @onclick="@( async e => { await OnPage(_page); })">
                            @_page.Title
                        </div>
                    </div>
                }
            </div>
        }

    }
</div>

@code {

    private List<IItemType> CurrentItemTypes { get; set; } = new();
    private List<IDTO> CurrentPages { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        msg.OnMessage += OnMessage;
    }
    public async void OnMessage(AppMessage message)
    {
        if (message.Id == "App")
        {
            if (message.Action == BusAction.Refresh)
            {
                CurrentItemTypes.Clear();
                CurrentPages.Clear();

                if (app.App != null)
                {
                    CurrentItemTypes = await app.App.GetItemTypes(AssociationTyp.Children);
                    CurrentPages = await app.App.GetPages(AssociationTyp.Children);
                }

                await InvokeAsync(StateHasChanged);
            }
        }

           if (message.Id == "ItemType" && message.Action == BusAction.Refresh)
        {
            await InvokeAsync(StateHasChanged);
        }

        if (message.Id == "Feature" && message.Action == BusAction.Refresh)
        {
            await InvokeAsync(StateHasChanged);
        }
    }


    // Structure
    private async Task OnAppSelect(IApp _app)
    {
        await app.SetApp(_app);

        nm.NavToApp(_app.Name);

        // // Refresh
        // msg.Publish(new AppMessage("App", BusAction.Refresh));

        // await Task.CompletedTask;
    }
    private async Task OnItemType(IItemType it)
    {
        await app.SetItemType(it);
        nm.NavToLibrary(it.Name, it.Typ);

        // App Selection
        await app.AppByItemType(it);

        // Refresh
        // msg.Publish(new AppMessage("ItemType", BusAction.Refresh));

        // await Task.CompletedTask;
    }
    private async Task OnPage(IDTO page)
    {
        await app.SetPage(page);
        nm.NavigateTo("/Page/" + page.GUID, false);

        // Refresh
        msg.Publish(new AppMessage("Page", BusAction.Refresh));

        await Task.CompletedTask;
    }
    
    // Layout 
    private string GetAppSelection(IApp _app)
    {
        if (app.App == null)
            return string.Empty;

        if (app.App.Name == _app.Name)
            return " selected ";

        return string.Empty;
    }
    private string GetItemTypeSelection(IItemType it)
    {
        if (app.ItemType == null)
            return string.Empty;

        if (app.ItemType.Name == it.Name)
            return " selected ";

        return string.Empty;
    }
    private string GetPageSelection(IDTO dto)
    {
        if (app.Page == null)
            return string.Empty;

        if (app.Page.Title == dto.Title)
            return " selected ";

        return string.Empty;
    }
  
    // Dispose 
    public async ValueTask DisposeAsync()
    {
        try
        {
            msg.OnMessage -= OnMessage;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : DISPOSE : BoardComp : " + ex.Message);
        }
    }

    // Groups 
    private readonly List<string> PreferredGroupOrder = new()
    {
        "Strategy",
        "Main",
        "Tools",
        "Admin"
    };
}
