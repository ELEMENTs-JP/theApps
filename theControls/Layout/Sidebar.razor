@using Microsoft.AspNetCore.Components.Routing

<div class="d-flex flex-column">
    <div class="header p-3 align-items-center bg-surface">
        <div class="h1">theApp</div>
    </div>

    <div class="scrollable flex-fill">
        <nav class="flex-column">
            @MenuContent
        </nav>
    </div>

    <div class="form-check form-switch no-focus togglerPos">
        <input class="form-check-input toggler" type="checkbox" />
    </div>
    <div class="footer">

    </div>
</div>

@code {

    [Parameter]
    public RenderFragment MenuContent { get; set; }
}