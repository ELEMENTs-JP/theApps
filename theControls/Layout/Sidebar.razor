@using Microsoft.AspNetCore.Components.Routing

<div class="d-flex flex-column">
    <div class="header p-3 align-items-center bg-surface">
        <div class="h1">
            @AppTitle
        </div>
    </div>

    <div class="scrollable flex-fill">
        <nav class="flex-column">
            @Navigation
        </nav>
    </div>

    <div class="form-check form-switch no-focus togglerPos">
        <input class="form-check-input toggler" type="checkbox" />
    </div>
    <div class="footer">

    </div>
</div>

@code {

    [Parameter]
    public RenderFragment Navigation { get; set; }

    string AppTitle { get; set; } = "the App";

    private SystemConfiguration Configuration { get; set; } = null;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        Configuration = Serializer.Load<SystemConfiguration>("system.config");
        AppTitle = Configuration.Title;


    }
}