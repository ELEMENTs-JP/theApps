@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager nm

<div class="d-flex flex-column">
    <div class="position-relative header p-2 px-5 text-nowrap align-items-center bg-surface text-center">
        <div class="h1 hover pointer rounded-2 p-1 text-center" style="margin-top:-8px;"
             @onclick="@( e => { nm.NavigateTo("/", false); })">
            @AppTitle
        </div>

        <div class="position-absolute top-50 end-0 translate-middle-y toggler pe-3"
             data-bs-toggle="collapse"
             data-bs-target="#app_navigation"
             aria-expanded="false"
             aria-controls="app_navigation">
            <SymbolIcon Symbol="Icon.Menu" />
        </div>
   
    </div>

    @if (Profile.HasContent())
    {
        <div class="profile border-bottom align-items-center " 
             style="height: var(--tsp-user-profile-height)">
            @Profile
        </div>
    }

    <div id="app_navigation" class="scrollable flex-fill">
        <nav class="flex-column">
            @Navigation
        </nav>
    </div>



    <div class="footer">
    </div>
</div>

@code {

    [Parameter]
    public RenderFragment Profile { get; set; }

    [Parameter]
    public RenderFragment Navigation { get; set; }

    string AppTitle { get; set; } = "the App";

    private SystemConfiguration Configuration { get; set; } = null;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        Configuration = Serializer.Load<SystemConfiguration>("system.config");
        AppTitle = Configuration.Title;


    }
}