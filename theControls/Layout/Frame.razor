@inject ILocalizationService loc
@inject ISecurityService sec
@inject IAppService app
@inject IMessagingBusService msg
@implements IAsyncDisposable

<div class="@( " bg-surface " + CSS + "   " + GetCssClass() + " " + app.Configuration.GetRoundedCSS() )" 
            style="@( " " + app.Configuration.GetAkzentStyle() + " " )">

    <div class="d-flex flex-row @HeadBorderCSS align-items-center py-1">

        @if (Icon.HasContent())
        {
            <div class="p-2 align-self-start">
                @Icon
            </div>
        }

        @if (Header.HasContent())
        {
            <div class="px-1 flex-grow-1">
                @Header
            </div>
        }

        @if (Controls.HasContent())
        {
            <div class="px-2">
                @Controls
            </div>

        }
        @if (Search.HasContent())
        {
            <div class="flex-fill px-2">
                @Search
            </div>
        }
        @if (Features.HasContent())
        {
            <div class="px-2">
                @Features
            </div>

        }
        @if (Related.HasContent())
        {
            <div class="d-flex flex-row-reverse g-1 px-1">
                @Related
            </div>
        }
    </div>

    @if (Content.HasContent())
    {
        <div class="row g-0 px-1">
            <div class="col-12 @ContentCSS" style="@ContentStyle">
                @Content
            </div>
        </div>
    }

    @if (Bottom.HasContent())
    {
        <div class="row g-0 px-1 @BottomBorderCSS">
            <div class="col-12 p-2">
                @Bottom
            </div>
        </div>
    }

</div>

@code {

    [Parameter]
    public bool Border { get; set; } = false;

    [Parameter]
    public string BottomBorderCSS { get; set; } = " border-top ";

    [Parameter]
    public string HeadBorderCSS { get; set; } = " border-bottom ";

    [Parameter]
    public string CSS { get; set; } = string.Empty;

    [Parameter]
    public string ContentCSS { get; set; } = " p-2 ";

    
    [Parameter]
    public string ContentStyle { get; set; } = "  ";

    [Parameter]
    public RenderFragment Icon { get; set; }

    [Parameter]
    public RenderFragment Header { get; set; }

    [Parameter]
    public RenderFragment Search { get; set; }

    [Parameter]
    public RenderFragment Controls { get; set; }

    [Parameter]
    public RenderFragment Features { get; set; }

    [Parameter]
    public RenderFragment Related { get; set; }

    [Parameter]
    public RenderFragment Content { get; set; }

    [Parameter]
    public RenderFragment Bottom { get; set; }

    private string GetCssClass()
    {
        string css = string.Empty;

        css = " ";

        if (Border)
        {
            css += " border ";
        }

        return css;
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }


    public async ValueTask DisposeAsync()
    {
        try
        {
          
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : DISPOSE : BoardComp : " + ex.Message);
        }
    }
}
