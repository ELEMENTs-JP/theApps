@inject NavigationManager nm
@inject IMessagingBusService msg
@inject ILocalizationService loc
@inject ISecurityService sec
@inject IAppService app
@inject ISqlDatabaseService sql

@implements IAsyncDisposable
@attribute [Authorize]


<AuthorizeView>
    <Authorized>
        <div class="frame">
            <div class="sidebar">
                <Sidebar>
                    <Profile>
                        <UserProfileImage />
                    </Profile>
                    <Navigation>
                        @Navigation
                    </Navigation>
                </Sidebar>
            </div>
            <main class="w-100 d-flex flex-column">
                <div class="header hstack px-3 bg-surface">
                    @Header
                </div>
                <div class="menu px-3">
                    @Menu
                </div>
                <div class="p-3 px-4 scrollable flex-fill">
                    @Body
                </div>
                <div class="footer">
                    @Footer
                </div>

                @if (sec.Configuration.TaskBar)
                {
                    <div class="bar p-2 glass rounded-2 align-items-center overflow-hidden">
                        @Bar
                    </div>
                }
            </main>
        </div>

        <StaticPositionContainer Position="@StaticPosition.MessageBox">

            <InfoBox FrameCSS="" CloseAfterSeconds="true" Seconds="4"
                     ShowCloseButton="true" />

        </StaticPositionContainer>
    </Authorized>
    <NotAuthorized>

        @if (sql.DatabaseExists == true)
        {
            <div class="container p-5 mt-5">

            <h1 class="display-1">Access Denied...</h1>
            <h1 class="display-1">Zugriff verweigert...</h1>

            <div class="text-muted">
                Es wurde offenbar ein Link aufgerufen, der so nicht existiert, oder ihr Account hierfür nicht berechtigt ist.
            </div>

            <div class="d-inline-flex flex-column my-5">
                <div class="fw-bold border hover pointer rounded-2 p-3 my-2 pe-5"
                     @onclick="@( e => { nm.NavigateTo("/Security/Login", false); })">
                    zum Login...
                </div>

                <div class="fw-bold border hover pointer rounded-2 p-3 my-2 pe-5"
                     @onclick="@( e => { nm.NavigateTo("/Security/Register", false); })">
                    zur Registration...
                </div>

                <div class="fw-bold border hover pointer rounded-2 p-3 my-2 pe-5"
                     @onclick="@( e => { nm.NavigateTo("/", false); })">
                    zur App...
                </div>
            </div>
        </div>
        }
        @if (sql.DatabaseExists == false)
        {
            <div class="container my-5 p-5">
                <h1 class="display-5">Willkommen zum Setup</h1>
                <h1 class="h1 fw-light">Keine Sorge, es ist ganz einfach.</h1>
                <h3 class="h3 fw-light">Einfach 4 Mal tippen... und 1 Mal klicken.</h3>
                <div class="hr"></div>
            </div>
            <SetupComp />    
        }

    </NotAuthorized>
</AuthorizeView>

@code {

    [Parameter]
    public RenderFragment Navigation { get; set; }

    [Parameter]
    public RenderFragment Header { get; set; }

    [Parameter]
    public RenderFragment Menu { get; set; }

    [Parameter]
    public RenderFragment Body { get; set; }

    [Parameter]
    public RenderFragment Footer { get; set; }

    [Parameter]
    public RenderFragment Bar { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Token
        var authState = await AuthStateTask;
        var token = authState.User.FindFirst("SecureToken")?.Value;
        if (!string.IsNullOrEmpty(token))
        {
            await sec.SetUser(token.ToSecureGUID());
        }

        // Message Handler
        msg.OnMessage += OnMessageIncome;


    }

    private async void OnMessageIncome(AppMessage message)
    {
        if (message.Id == "Feature" && message.Action == BusAction.Refresh)
        {
            await InvokeAsync(StateHasChanged);
        }
    }


    public async ValueTask DisposeAsync()
    {
        try
        {
            msg.OnMessage -= OnMessageIncome;
      
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : DISPOSE : BoardComp : " + ex.Message);
        }
    }
}
