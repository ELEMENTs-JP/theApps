@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

@inject NavigationManager nm
@inject ISecurityService sec
@inject IMessagingBusService msg
@inject ILocalizationService loc
@inject IAppService app

@implements IAsyncDisposable
@attribute [Authorize]


<AuthorizeView>
    <Authorized>
        <div class="frame">
            <div class="sidebar">
                <Sidebar>
                    <Navigation>
                        @Navigation
                    </Navigation>
                </Sidebar>
            </div>
            <main class="w-100 d-flex flex-column">
                <div class="header hstack px-3 bg-surface">
                    @Header
                </div>
                <div class="menu px-3">
                    @Menu
                </div>
                <div class="p-3 px-4 scrollable flex-fill">
                    @Body
                </div>
                <div class="footer">
                    @Footer
                </div>

                @if (loc.Configuration.TaskBar)
                {
                    <div class="bar p-2 transulent rounded-2 align-items-center overflow-hidden">
                        <a class="mx-3" href="/DragDrop">DragDrop</a>
                        @Bar
                    </div>
                }
            </main>
        </div>

        <StaticPositionContainer Position="@StaticPosition.MessageBox">

            <InfoBox FrameCSS="m-2" CloseAfterSeconds="true" Seconds="5"
                     ShowCloseButton="true" />

        </StaticPositionContainer>
    </Authorized>
    <NotAuthorized>

        <div class="container p-5 mt-5">

            <h1 class="display-1">Access Denied...</h1>
            <h1 class="display-1">Zugriff verweigert...</h1>

            <div class="text-muted">
                Es wurde offenbar ein Link aufgerufen, der so nicht existiert, oder ihr Account hierfür nicht berechtigt ist.
            </div>

            <div class="hover pointer rounded-2 p-2 my-3" 
                @onclick="@( e => { nm.NavigateTo("/Login", false); })">
                go to Login...
            </div>
            <div class="hover pointer rounded-2 p-2 my-3"
                 @onclick="@( e => { nm.NavigateTo("/", false); })">
                go to App...
            </div>
        </div>

    </NotAuthorized>
</AuthorizeView>

@code {

    [Parameter]
    public RenderFragment Navigation { get; set; }

    [Parameter]
    public RenderFragment Header { get; set; }

    [Parameter]
    public RenderFragment Menu { get; set; }

    [Parameter]
    public RenderFragment Body { get; set; }

    [Parameter]
    public RenderFragment Footer { get; set; }

    [Parameter]
    public RenderFragment Bar { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Token
        var authState = await AuthStateTask;
        var token = authState.User.FindFirst("SecureToken")?.Value;
        if (!string.IsNullOrEmpty(token))
        {
            await sec.SetUser(token.ToSecureGUID());
        }

        // Message Handler 
        msg.OnMessage += OnMessageIncome;

        // Navigation Handler
        nm.LocationChanged += OnLocationChanged;
    }

    private async void OnMessageIncome(AppMessage message)
    {
        if (message.Id == "Feature" && message.Action == BusAction.Refresh)
        {
            await InvokeAsync(StateHasChanged);
        }
    }
    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Globaler Code bei jeder Navigation (z. B. Logging, Analytics)
        string newUrl = e.Location;

        UrlAnalysis analysis = UrlAnalysis.AnalyzeUrl(nm);
        if (analysis.Segments.Count() == 0)
        {
            // Home 
            app.App = null;
            msg.Publish("App", BusAction.Refresh);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            msg.OnMessage -= OnMessageIncome;
            nm.LocationChanged -= OnLocationChanged;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : DISPOSE : BoardComp : " + ex.Message);
        }
    }
}
