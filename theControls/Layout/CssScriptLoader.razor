@* ----- HEAD ----- *@


@if (Position == LoadingPosition.Head)
{
     @* Tabler *@
    <link rel="stylesheet" href="@Assets["lib/tabler/dist/css/tabler.min.css"]" />
    <script src="@Assets["lib/tabler/dist/js/tabler.min.js"]"></script>

    <title>the App Plattform</title>

    <meta name="author" content="the STRIDEs Path by Jürgen Pott" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico">

    <script>
        (function () {
            let theme = localStorage.getItem("theme");

            if (!theme) {
                theme = window.matchMedia("(prefers-color-scheme: dark)").matches
                    ? "dark"
                    : "light";
            }

            document.documentElement.setAttribute("data-bs-theme", theme);
        })();
    </script>
}


@* ----- BODY ----- *@
@if (Position == LoadingPosition.Body)
{
      @* --- Video.JS --- *@
    <link href="https://cdnjs.cloudflare.com/ajax/libs/video.js/7.22.0/video-js.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/video.js/7.22.0/video.min.js">
    </script>

    @* Controls JS *@
    <link rel="stylesheet" href="@Assets["./_content/theControls/css/controls.css"]" />
    <script src="@Assets["./_content/theControls/js/controls.js"]"></script>

    @* Tabler Icons *@
    <link href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css" rel="stylesheet" />

    @* HTML Editor *@
    <script src="https://cdn.jsdelivr.net/npm/hugerte@1/hugerte.min.js"></script>

    @* Sortable *@
    <script src="./_content/theControls/js/Sortable.min.js" async></script>
    <script type="module" src="./_content/theControls/js/DragDrop.js" async></script>
 
}

@code {

    [Parameter]
    public LoadingPosition Position { get; set; } = LoadingPosition.NULL;

    
}
