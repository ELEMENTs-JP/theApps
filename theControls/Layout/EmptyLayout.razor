@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase

<PageTitle>ECharts.App</PageTitle>

<div class="page">


    <main>
        <div class="header px-4">
            <AuthorizeView>
                <Authorized>
                    <span class="me-2">Hallo, @context.User.Identity?.Name!</span>
                    <a href="/api/auth/logout" class="btn btn-sm btn-outline-danger">Abmelden</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="btn btn-sm btn-primary">Login</a>
                    <div class="vr"></div>
                    <a href="/register" class="btn btn-sm btn-primary">Registrierung</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
