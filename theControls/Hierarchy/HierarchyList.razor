@inherits BaseList

@inject IMessagingBusService msg
@inject NavigationManager nm

@if (Context != null && ItemType != null)
{
    @if (Context.ItemType != null && Context.ItemType.GetFields().Result != null)
    {
        <div class="overflow-y-auto">
        @foreach (IDTO item in Context.Items)
        {
            <HierarchyItem Context="@Context" Item="@item" ItemType="@ItemType.Name" Mode="@Mode" />
        }
        </div>
    }
}


@code {

    [Parameter]
    public HierarchyMode Mode { get; set; } = HierarchyMode.Related;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        msg.OnMessage += OnMessageIncome;
    }


    private async void OnMessageIncome(AppMessage message)
    {
        if (message.Id == "Hierarchy" && message.Action == BusAction.Refresh)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            msg.OnMessage -= OnMessageIncome;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : DISPOSE : BoardComp : " + ex.Message);
        }
    }

}
