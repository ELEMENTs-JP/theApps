@using Microsoft.AspNetCore.Hosting
@inject NavigationManager nm
@inject ILocalizationService loc
@inject ISecurityService sec
@inject IMessagingBusService msg
@inject IWebHostEnvironment env
@implements IAsyncDisposable

<div class="dropdown-center " role="group">

    <div class="pointer hover rounded-2 p-1 px-2" data-bs-toggle="dropdown">
        <small class="text-muted"><i class="ti ti-chevron-down"></i></small>
    </div>

    <div class="dropdown-menu" style="min-width:15rem;">

        <div class="px-2 pt-2 fw-bold">Aktionen</div>

        @if (sec.Configuration.Archive == true)
        {
            @if (Context.Item.ItemType != "Archive")
            {
                <div class="hover pointer rounded-2 p-1 px-2 m-1 mx-2"
                     @onclick="ToArchive">
                    ins Archiv...
                </div>
            }
            @if (Context.Item.ItemType == "Archive")
            {
                <div class="hover pointer rounded-2 p-1 px-2 m-1 mx-2"
                     @onclick="ToOriginalList">
                    widerherstellen...
                </div>
            }
        }


        @if (sec.Configuration.Trash == true)
        {
            @if (Context.Item.ItemType != "Trash")
            {
                <div class="hover pointer rounded-2 p-1 px-2 m-1 mx-2"
                     @onclick="ToTash">
                    in den Papierkorb...
                </div>
            }
            @if (Context.Item.ItemType == "Trash")
            {
                <div class="hover pointer rounded-2 p-1 px-2 m-1 mx-2"
                     @onclick="ToOriginalList">
                    widerherstellen...
                </div>
            }
        }

        <div class="hover pointer rounded-2 p-1 px-2 m-1 mx-2"
             @onclick="DeleteItem">
            löschen...
        </div>

    </div>
</div>


@code {


    [Parameter]
    public IItemType ItemType { get; set; } // Injectiopn

    [Parameter]
    public IQueryContext Context { get; set; } // Injection

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        msg.OnMessage += OnMessageIncome;
    }

    private async void OnMessageIncome(AppMessage message)
    {
        if (message.Id == "Features" && message.Action == BusAction.Refresh)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToOriginalList()
    {
        if (Context != null)
        {
            string originalItemType = Context.Item["OriginalItemType"];
            if (!string.IsNullOrEmpty(originalItemType))
            {
                await Context.ChangeItemType(Context.Item, originalItemType);
                nm.NavToLibrary(originalItemType);
            }
        }
    }
    private async Task ToArchive()
    {
        if (Context != null)
        {
            Context.Item["OriginalItemType"] = Context.Item.ItemType;
            await Context.ChangeItemType(Context.Item, "Archive");

            nm.NavToLibrary(ItemType.Name);
        }
    }
    private async Task ToTash()
    {
        if (Context != null)
        {
            Context.Item["OriginalItemType"] = Context.Item.ItemType;
            await Context.ChangeItemType(Context.Item, "Trash");

            nm.NavToLibrary(ItemType.Name);
        }
    }
    private async Task DeleteItem()
    {
        if (Context != null)
        {
            string info = "";
            string ext = Context.Item["FileExtension"].ToSecureString();
            string file = Context.Item.GUID.ToSecureString() + "." + ext;
            
            string fullFilePath = Path.Combine(env.ContentRootPath, loc.DefaultFilePath, file);
            if (File.Exists(fullFilePath))
            {
                File.Delete(fullFilePath);
                info = "Datei und ";
            }

            await Context.Delete(Context.Item);
            info += "Datensatz wurde gelöscht";

            nm.NavToLibrary(ItemType.Name, ItemType.Typ);

            msg.Publish("", BusAction.Info, info);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            msg.OnMessage -= OnMessageIncome;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : DISPOSE : BoardComp : " + ex.Message);
        }
    }
}
