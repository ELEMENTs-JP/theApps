@using Microsoft.AspNetCore.Hosting
@inject NavigationManager nm
@inject ILocalizationService loc
@inject ISecurityService sec
@inject ISqlDatabaseService sql
@inject ISearchService search
@inject IAppService app
@inject IMessagingBusService msg
@inject IWebHostEnvironment env
@inject INotificationService notify
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="dropdown-center @CSS " role="group">

    <div class="pointer hover rounded-2 p-1 px-2" data-bs-toggle="dropdown">
        <small class="text-muted"><i class="ti ti-chevron-down"></i></small>
    </div>

    <div class="dropdown-menu" style="min-width:12rem;">

        <div class="p-2 mb-2 fw-bold border-bottom text-secondary">Aktionen</div>

        <div class="hover pointer rounded-2 p-1 px-2 m-1 mx-2 text-nowrap  d-flex flex-row "
                 @onclick="Copy">
            <SymbolIcon Symbol="Icon.Copy" CSS="me-2" />
                kopieren
        </div>
        <div class="dropdown-divider"></div>
        @if (!isFollowedByMe)
        {
            <div class="hover pointer rounded-2 p-1 px-2 m-1 mx-2 text-nowrap  d-flex flex-row "
                 @onclick="Follow">
                <SymbolIcon Symbol="Icon.Follow" CSS="me-2" />
                folgen...
            </div>
        }
        else
        {
            <div class="hover pointer rounded-2 p-1 px-2 m-1 mx-2 text-nowrap  d-flex flex-row "
                 @onclick="UnFollow">
                <SymbolIcon Symbol="Icon.UnFollow" CSS="me-2" />
                nicht folgen...
            </div>
        }

        @if (!isFavoriteItem)
        {
            <div class="hover pointer rounded-2 p-1 px-2 m-1 mx-2 text-nowrap  d-flex flex-row "
                 @onclick="MakeFavorite">
                <SymbolIcon Symbol="Icon.Favorite" CSS="me-2" />
                als Favorite markieren...
            </div>
        }
        else
        {
            <div class="hover pointer rounded-2 p-1 px-2 m-1 mx-2 text-nowrap  d-flex flex-row "
                 @onclick="NoFavorite">
                <SymbolIcon Symbol="Icon.NoFavorite" CSS="me-2" />
                Favorite entfernen...
            </div>
        }



        @if (Context.ItemType.Typ == ItemTypeTyp.File ||
                Context.ItemType.Typ == ItemTypeTyp.Audio ||
                Context.ItemType.Typ == ItemTypeTyp.Image)
        {
            <div class="hover pointer rounded-2 p-1 px-2 m-1 mx-2 d-flex flex-row "
                 @onclick="DownloadFileFromStream">
                <SymbolIcon Symbol="Icon.Download" CSS="me-2" />
                Datei herunterladen...
            </div>

        }


        @if (IsItemOwner() == true)
        {
            @if (ValidatePrivacy() == false)
            {
                <div class="hover pointer rounded-2 p-1 px-2 m-1 mx-2 d-flex flex-row "
                     @onclick="MakePrivate">
                    <SymbolIcon Symbol="Icon.Private" CSS="me-2" />
                    als privat markieren...
                </div>
            }
            else
            {
                <div class="hover pointer rounded-2 p-1 px-2 m-1 mx-2 d-flex flex-row "
                     @onclick="MakePublic">
                    <SymbolIcon Symbol="Icon.Public" CSS="me-2" />
                    veröffentlichen
                </div>
            }
        }

        @if (sec.Configuration.Archive == true)
        {
            <div class="dropdown-divider"></div>

            @if (Context.Item.ItemType != "Archive")
            {
                <div class="hover pointer rounded-2 p-1 px-2 m-1 mx-2 d-flex flex-row "
                     @onclick="ToArchive">
                    <SymbolIcon Symbol="Icon.Archiv" CSS="me-2" Color="var(--tblr-blue)" />
                    ins Archiv bewegen...
                </div>
            }
            @if (Context.Item.ItemType == "Archive")
            {
                <div class="hover pointer rounded-2 p-1 px-2 m-1 mx-2 d-flex flex-row "
                     @onclick="ToOriginalList">
                    widerherstellen...
                </div>
            }
        }


        @if (sec.Configuration.Trash == true)
        {
            @if (Context.Item.ItemType != "Trash")
            {
                <div class="hover pointer rounded-2 p-1 px-2 m-1 mx-2 d-flex flex-row "
                     @onclick="ToTash">
                    <SymbolIcon Symbol="Icon.Papierkorb" CSS="me-2" Color="var(--tblr-orange)" />
                    in den Papierkorb...
                </div>
            }
            @if (Context.Item.ItemType == "Trash")
            {
                <div class="hover pointer rounded-2 p-1 px-2 m-1 mx-2 d-flex flex-row "
                     @onclick="ToOriginalList">
                    widerherstellen...
                </div>
            }
        }

        @if (hasDeletePermission)
        {
            @if (Context.Item.ItemType != "Archive")
            {
                <div class="dropdown-divider"></div>
                <div class="hover pointer rounded-2 p-1 px-2 m-1 mx-2 d-flex flex-row "
                     @onclick="DeleteItem">
                    <SymbolIcon Symbol="Icon.Delete" CSS="me-2" Color="var(--tblr-red)" />
                    endgültig löschen...
                </div>
            }
        }

    </div>
</div>


@code {


    [Parameter]
    public IItemType ItemType { get; set; } // Injectiopn

    [Parameter]
    public IQueryContext Context { get; set; } // Injection

    bool hasDeletePermission { get; set; } = true;
    bool isFavoriteItem { get; set; } = false;
    bool isFollowedByMe { get; set; } = false;

    [Parameter]
    public string CSS { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        msg.OnMessage += OnMessageIncome;
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        // Berechtigung
        if (ItemType != null)
        {
            hasDeletePermission = await sec.HasItemTypePermission(this.ItemType, SecurityFunction.Delete);
            isFavoriteItem = await IsFavorite();
            isFollowedByMe = await IsFollowed();
        }
    }
    private async void OnMessageIncome(AppMessage message)
    {
        if (message.Id == "Features" && message.Action == BusAction.Refresh)
        {
            await InvokeAsync(StateHasChanged);
        }
    }


    private async Task ToFavorite()
    {
        if (Context != null)
        {

        }
    }
    private bool IsItemOwner()
    {
        if (Context != null)
        {
            IMetadata mtd = (IMetadata)Context.Item;
            if (mtd.Metadata.CreatedBy == sec.User.GUID)
            {
                return true;
            }
        }

        return false;
    }
    private bool ValidatePrivacy()
    {
        if (Context != null)
        {
            return Context.Item["IsPrivate"].ToSecureBool();
        }

        return false;
    }

    private async Task Copy()
    {
        IDTO CurrentItem = Context.Item;

        // Query 
        IQueryParameter qp = QueryParameter.Default("[Copy] " + Context.Item.Title);
        qp.MasterGUID = sql.MasterGUID;
        qp.ItemType = ItemType.Name;

        // Create Favorite
        await sql.Create(qp);

        // Load
        IQueryResult result = await sql.GetItem(qp);
        // Item
        IDTO? newItem = result.Items.FirstOrDefault();
        if (newItem != null)
        {
            // Head 
            CurrentItem.GUID = newItem.GUID;
            CurrentItem.Title = newItem.Title;

            // Metadata 
            IMetadata? oldMtd = CurrentItem as IMetadata;
            IMetadata? newMtd = newItem as IMetadata;
            oldMtd?.Metadata = newMtd?.Metadata;

            await sql.Update(CurrentItem);

            nm.NavToItem(ItemType.Name, CurrentItem.GUID);
        }
    }
    private async Task Follow()
    {
        // Query 
        IQueryParameter qp = QueryParameter.Default(Context.Item.Title);
        qp.MasterGUID = sql.MasterGUID;
        qp.ItemType = "Notification";

        // Create Favorite 
        await sql.Create(qp);

        // Load 
        IQueryResult result = await sql.GetItem(qp);

        // Item 
        IDTO? newItem = result.Items.FirstOrDefault();
        if (newItem != null)
        {
            newItem["ItemType"] = Context.Item.ItemType.ToSecureString();
            newItem["GUID"] = Context.Item.GUID.ToSecureString();
            await sql.Update(newItem);

            // Assign 
            await sql.Assign(sec.User, newItem, AssociationTyp.Related);
            isFollowedByMe = await IsFollowed();
        }
    }
    private async Task UnFollow()
    {
        IQueryResult result = await sql.GetRelatedItems(sec.User, "Notification", AssociationTyp.Related);

        // Item
        IDTO? fav = result.Items.Find(se =>
             se["GUID"] == Context.Item.GUID.ToSecureString() &&
             se["ItemType"] == Context.ItemType.ToSecureString());
        if (fav != null)
        {
            await sql.Remove(sec.User, fav);
            await sql.Delete(fav);

            isFollowedByMe = await IsFollowed();
        }
    }
    private async Task<bool> IsFollowed()
    {
        IQueryResult result = await sql.GetRelatedItems(sec.User, "Notification", AssociationTyp.Related);

        IDTO? fav = result.Items.Find(se => 
            se["GUID"] == Context.Item.GUID.ToSecureString() && 
            se["ItemType"] == Context.ItemType.ToSecureString());
        if(fav != null)
            return true;

        return false;
    }

    private async Task MakeFavorite()
    {
        // Query 
        IQueryParameter qp = QueryParameter.Default(Context.Item.Title);
        qp.MasterGUID = sql.MasterGUID;
        qp.ItemType = "Favorite";

        // Create Favorite 
        await sql.Create(qp);

        // Load 
        IQueryResult result = await sql.GetItem(qp);

        // Item 
        IDTO? newItem = result.Items.FirstOrDefault();
        if (newItem != null)
        {
            newItem["ItemType"] = Context.Item.ItemType.ToSecureString();
            newItem["GUID"] = Context.Item.GUID.ToSecureString();
            await sql.Update(newItem);

            // Assign 
            await sql.Assign(sec.User, newItem, AssociationTyp.Related);
            isFavoriteItem = await IsFavorite();
        }
    }
    private async Task NoFavorite()
    {
        IQueryResult result = await sql.GetRelatedItems(sec.User, "Favorite", AssociationTyp.Related);

        // Item
        IDTO? fav = result.Items.Find(se =>
             se["GUID"] == Context.Item.GUID.ToSecureString() &&
             se["ItemType"] == Context.ItemType.ToSecureString());
        if (fav != null)
        {
            await sql.Remove(sec.User, fav);
            await sql.Delete(fav);

            isFavoriteItem = await IsFavorite();
        }
    }
    private async Task<bool> IsFavorite()
    {
        IQueryResult result = await sql.GetRelatedItems(sec.User, "Favorite", AssociationTyp.Related);

        IDTO? fav = result.Items.Find(se => 
            se["GUID"] == Context.Item.GUID.ToSecureString() && 
            se["ItemType"] == Context.ItemType.ToSecureString());
        if(fav != null)
            return true;

        return false;
    }

    private async Task MakePrivate()
    {
        if (Context != null)
        {
            Context.Item["IsPrivate"] = true.ToSecureString();
            await sql.Update(Context.Item);
        }
    }
    private async Task MakePublic()
    {
        if (Context != null)
        {
            Context.Item["IsPrivate"] = false.ToSecureString();
            await sql.Update(Context.Item);
        }
    }

    private async Task ToOriginalList()
    {
        if (Context != null)
        {
            string originalItemType = Context.Item["OriginalItemType"];
            if (!string.IsNullOrEmpty(originalItemType))
            {
                await Context.ChangeItemType(Context.Item, originalItemType);

                // Search Refresh
                await search.Init();

                nm.NavToLibrary(originalItemType);
            }
        }
    }
    private async Task ToArchive()
    {
        if (Context != null)
        {
            Context.Item["OriginalItemType"] = Context.Item.ItemType;
            await Context.ChangeItemType(Context.Item, "Archive");

            // Search Refresh
            await search.Init();

            nm.NavToLibrary(ItemType.Name);
        }
    }
    private async Task ToTash()
    {
        if (Context != null)
        {
            Context.Item["OriginalItemType"] = Context.Item.ItemType;
            await Context.ChangeItemType(Context.Item, "Trash");

            // Search Refresh
            await search.Init();

            nm.NavToLibrary(ItemType.Name);
        }
    }
    private async Task DeleteItem()
    {
        // Berechtigung
        if (hasDeletePermission == false)
        {
            msg.Publish("Info", BusAction.Info, "Keine Berechtigung zum löschen.");
            return;
        }

        // if (ItemType.Name == "Principal")
        // {
            
        // }
        // if (ItemType.Name == "User")
        // {
        //     int admins = search.Store.Where(se => se["IsAdmin"] == "true").Count();
        //     if (admins == 1)
        //     {
        //         IDTO? lastAdmin = search.Store.Find(se => se["IsAdmin"] == "true");
        //         if (lastAdmin != null && Context.Item != null)
        //         {
        //             if (lastAdmin.GUID == Context.Item.GUID)
        //             {
        //                 msg.Publish("Info", BusAction.Info, "Der letzte Administrator darf nicht gelöscht werden.");
        //                 return;
        //             }
        //         }
        //     }
        // }

        if (Context != null)
        {
            string info = "";
            string ext = Context.Item["FileExtension"].ToSecureString();

            // File
            string file = Context.Item.GUID.ToSecureString() + "." + ext;
            string fullFilePath = Path.Combine(env.ContentRootPath, loc.DefaultFilePath, file);
            if (File.Exists(fullFilePath))
            {
                File.Delete(fullFilePath);
                info = "Datei und ";
            }

            // Min Image File
            string minFile = Context.Item.GUID.ToSecureString() + "_min." + ext;
            string minFullFilePath = Path.Combine(env.ContentRootPath, loc.DefaultFilePath, minFile);
            if (File.Exists(minFullFilePath))
            {
                File.Delete(minFullFilePath);
                info = " und Mindatei und ";
            }

            await Context.Delete(Context.Item);
            info += "Datensatz wurde gelöscht";

            if (sec.Configuration.EventHandler)
            {
                IItemEventArgs args = new ItemEventArgs(Context.Item, null, sql, sec, app);
                await this.Context.ItemType.OnDeleteItem(args);
            }

            // Search Refresh
            await search.Init();

            // Callback 
            if (ItemDeleted.HasDelegate)
            {
                await ItemDeleted.InvokeAsync("Deleted");    
            }

            nm.NavToLibrary(ItemType.Name, ItemType.Typ);

            msg.Publish("", BusAction.Info, info);

            // Hierarchy Refresh 
            // msg.Publish("Hiearchy", BusAction.Refresh);
            msg.Publish(new AppMessage("Item", BusAction.Select, null));

            // Notification Service
            notify.NotifyChanged(Context.Item, NotificationType.Delete, sec.User);

           
        }
    }

    private async Task DownloadFileFromStream()
    {
        try
        {
            if (Context.Item == null)
                return;

            var randomBinaryData = Context.Item.GetFileAsByteArray();
            var fileStream = new MemoryStream(randomBinaryData);

            var fileName = Context.Item.Title + "." + Context.Item["FileExtension"].ToSecureString();

            using var streamRef = new DotNetStreamReference(stream: fileStream);

            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        catch (Exception ex)
        {

        }
    }

    // Callback 
    [Parameter]
    public EventCallback<string> ItemDeleted { get; set; }

    public async ValueTask DisposeAsync()
    {
        try
        {
            msg.OnMessage -= OnMessageIncome;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : DISPOSE : BoardComp : " + ex.Message);
        }
    }
}
