@if (!string.IsNullOrEmpty(this.Label))
{
    <label class="form-label text-secondary" for="@ID">@Label</label>
}

<div class="position-relative overlay-container">

    <div id="@( "frame_popup_" + ID )" name="@InputName" class="@(" w-100 dropdown-center editbox ")) "
         disabled="@Disabled" readonly="@ReadOnly">

        <div id="@( "link_popup_" + ID )" class="@(" row align-items-center ")" data-bs-toggle="dropdown">

            @*  d-none d-xl-block   *@
            <div id="@( "head_popup_" + ID )" class=" col p-1">
                <span class="@( " px-1 ")">
                    @((MarkupString)Value)
                </span>
            </div>
            <div class="@( "col-auto pointer hover rounded-2 px-1 me-2  dropdown-toggle")">
            </div>
        </div>

        <div id="@( "body_popup_" + ID )" class="@( "dropdown-menu w-100 ")" style="@MenuStyle">

            <div class="row g-0">
                <div class="col">
                    <div class="dropdown-header">@Label</div>
                    <div class="px-2 mb-1 small text-muted text-truncate-container-2 overflow-hidden">@Description</div>
                </div>
            </div>

            <div class="dropdown-divider"></div>
      
            <div class="@( " overflow-y-auto " )" style="@( MaxHeightCSS )">

                @foreach (IDTO item in Items)
                {
                    <div class="dropdown-item"
                         @onclick="@(e => { SelectedItem = item; Value = item.Title; })">

                        @if (ItemTemplate is not null)
                        {
                            @ItemTemplate(item)
                        }
                        else
                        {
                            @item.Title
                        }

                    </div>
                }

            </div>

         
        </div>
    </div>

    @if (Inlay != null)
    {
        <div class="position-absolute top-50 end-0 translate-middle-y me-2">
            @Inlay
        </div>
    }

    @if (Overlay != null)
    {
        <div class="overlay position-absolute top-50 end-0 translate-middle-y me-2">
            @Overlay
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(Description))
{
    <div class="text-muted small border-top" style="padding-left:3px; padding-top:3px;">
        @this.Description.ToSecureString()
    </div>
}
@if (!string.IsNullOrEmpty(Hint))
{
    <div class="form-hint" style="padding-left:3px; padding-top:3px;">
        @Hint.ToSecureString()
    </div>
}

@code {

    [Parameter]
    public RenderFragment<IDTO>? ItemTemplate { get; set; }

    [Parameter]
    public RenderFragment? Overlay { get; set; }

    [Parameter]
    public RenderFragment? Inlay { get; set; }

    [Parameter]
    public string ID { get; set; } = Guid.NewGuid().ToString();

    [Parameter]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string Description { get; set; } = string.Empty;
    [Parameter]
    public string Hint { get; set; } = string.Empty;

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public string CssClass { get; set; } = string.Empty;

    [Parameter]
    public string MenuStyle { get; set; } = "min-width:13rem;";

    [Parameter]
    public string MaxHeightCSS { get; set; } = "max-height:44rem;";

    [Parameter]
    public List<IDTO> Items { get; set; } = new();


    [Parameter]
    public IDTO SelectedItem { get; set; }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = string.Empty;


    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    private async Task HandleInput(IDTO dto)
    {
        SelectedItem = dto;
        Value = dto.Title;
        await ValueChanged.InvokeAsync(Value);
    }


    private string InputName =>
    !string.IsNullOrWhiteSpace(Name)
        ? Name
        : Helper.GenerateName(Label);

   

}
