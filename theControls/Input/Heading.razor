@inject IJSRuntime JS

@if (!string.IsNullOrEmpty(Label))
{
    @if (ShowLabel == true)
    {
        <label class="form-label text-secondary" for="@Id">@Label</label>
    }
}
<div class="position-relative overlay-container">
    <div id="@Id" name="@InputName"
         class="display-6 editbox @CssClass" style="margin-left:-10px;"
         contenteditable="@(!Disabled && !ReadOnly)"
         role="textbox"
         aria-multiline="false"
         aria-readonly="@ReadOnly"
         spellcheck="false"
         tabindex="@(Disabled ? "-1" : "0")"
         data-placeholder="@Placeholder"
         @ref="_element"
         @oninput="HandleInput"
         @onkeydown="HandleKeyDown">
        @Value
    </div>

    @if (Inlay != null)
    {
        <div class="position-absolute top-50 end-0 translate-middle-y me-2">
            @Inlay
        </div>
    }

    @if (Overlay != null)
    {
        <div class="overlay position-absolute top-50 end-0 translate-middle-y me-2">
            @Overlay
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(Description))
{
    @Description.ToSecureString()
}

@if (!string.IsNullOrEmpty(Hint))
{
    @Hint.ToSecureString()
}

@code
{
    private ElementReference _element;

    [Parameter]
    public bool ShowLabel { get; set; } = true;

    [Parameter]
    public RenderFragment? Overlay { get; set; }

    [Parameter]
    public RenderFragment? Inlay { get; set; }

    [Parameter]
    public string Id { get; set; } = Guid.NewGuid().ToString();

    [Parameter]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string Description { get; set; } = string.Empty;

    [Parameter]
    public string Hint { get; set; } = string.Empty;

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public string CssClass { get; set; } = string.Empty;

    [Parameter]
    public string Placeholder { get; set; } = string.Empty;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public bool AutoFocus { get; set; }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<string> OnInput { get; set; }

    [Parameter]
    public EventCallback<string> OnBlur { get; set; }


    private async Task HandleInput()
    {
        Value = await JS.InvokeAsync<string>("getInnerText", _element);
        await ValueChanged.InvokeAsync(Value);
    }

    private Task HandleKeyDown(KeyboardEventArgs e)
    {
        // Enter unterdrücken (einzeilige H1)
        if (e.Key == "Enter")
        {
            // Optional per JS preventDefault() ergänzen
        }

        return Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync(
                "contentEditable.setText",
                _element,
                Value
            );
        }
    }


    private string InputName =>
        !string.IsNullOrWhiteSpace(Name)
            ? Name
            : Helper.GenerateName(Label);
}