@if (!string.IsNullOrEmpty(this.Label))
{
    <label class="form-label" style="padding-left:5px;" for="@Id">@Label</label>
}

<div class="position-relative overlay-container">
   
    <select id="@Id"
            name="@InputName"
            class="form-select @CssClass"
            value="@Value"
            @onchange="HandleChange"
            disabled="@Disabled">

        @if (!string.IsNullOrEmpty(Placeholder))  {
            <option value="" disabled selected>@Placeholder</option> }

        @foreach (IDTO item in Items) 
        {
            <option value="@item.Title" 
                    selected="@IsSelected(item)">@item.Title</option> 
        }
    </select>

    @if (Overlay != null)
    {
        <div class="overlay position-absolute top-50 end-0 translate-middle-y me-2">
            @Overlay
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(Description))
{
    <div class="text-muted" style="padding-left:3px; padding-top:3px;">
        @this.Description.ToSecureString()
    </div>
}
@if (!string.IsNullOrEmpty(Hint))
{
    <div class="form-hint" style="padding-left:3px; padding-top:3px;">
        @Hint.ToSecureString()
    </div>
}

@code {

    [Parameter]
    public RenderFragment? Overlay { get; set; }

    [Parameter]
    public string Id { get; set; } = Guid.NewGuid().ToString();

    [Parameter]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string Description { get; set; } = string.Empty;
    [Parameter]
    public string Hint { get; set; } = string.Empty;

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public string CssClass { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public List<IDTO> Items { get; set; } = new();

    [Parameter]
    public Func<object, string>? TextSelector { get; set; }

    [Parameter]
    public Func<object, string>? ValueSelector { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = string.Empty;



    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }


    private async Task HandleChange(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? string.Empty;
        await ValueChanged.InvokeAsync(Value);
    }

    private bool IsSelected(IDTO item)
    {
        return item.Title == Value;
    }

    private string InputName =>
    !string.IsNullOrWhiteSpace(Name)
        ? Name
        : Helper.GenerateName(Label);

   

}
