@using System
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Hosting
@implements IDisposable
@inject IJSRuntime JS

@inject IWebHostEnvironment env
@inject ISqlDatabaseService sql
@inject ILocalizationService loc
@inject ISecurityService sec
@inject IMessagingBusService msg
@inject IAppService app

@if (ItemType != null)
{
    <div class="pointer @app.Configuration.GetRoundedCSS() overflow-hidden bg-surface text-secondary position-relative mx-2"
         style="@( (SizeMode == FileInputSizeMode.Maximized 
                        ? " border: 2px dashed #999 !important; " 
                        : " border: 1px dashed #555 !important; " ) + " " + InternalStyle )">

        @if (isLoading)
        {
            <div class="@( ProgressCSS + " position-absolute top-50 start-50 translate-middle " )"
                 style="@( "  " + InternalStyle )"
                 title="@(Progress + "% Complete")">
                <div class="@ProgressLineCSS" style="width: @(Progress + "%")" role="progressbar"
                     aria-valuenow="@Progress" aria-valuemin="0" aria-valuemax="100">
                </div>
            </div>
        }
        else
        {
            <div class="position-relative" style="@( $"min-width:{Width}px; min-height:{Height}px;" )">
                <div class="p-2 position-absolute top-50 start-50 translate-middle" >
                    <SymbolIcon Symbol="Icon.File" Width="@Width" Height="@Height" 
                                Style="@( (SizeMode == FileInputSizeMode.Maximized ? " margin-top:5rem; " : " margin-top:0px; " ) )"
                        CSS="@( (SizeMode == FileInputSizeMode.Maximized ? "  " : " " ) )" />
                </div>
            </div>
        }

        <!-- InputFile darf während des Uploads NICHT aus dem DOM entfernt werden -->
        <InputFile @key="inputFileKey" id="@ID" multiple OnChange="@Upload"
                   disabled="@isLoading"
                   class="@( ControlCSS + " position-absolute top-50 start-50 translate-middle " )"
                   style="@( ControlStyle + " opacity:0.0005; " + (isLoading ? "display:none;" : "") + InternalStyle )" />
    </div>
}

@code {

    [Parameter]
    public IItemType ItemType { get; set; }

    public enum FileInputSizeMode
    {
        NULL = 0,
        Fixed = 1,
        Maximized = 2,
    }

    private string ID = "file_input_" + Guid.NewGuid();
    private Guid inputFileKey = Guid.NewGuid();

    private int maxAllowedFiles = 5;
    private bool isLoading;

    [Parameter]
    public EventCallback<FileNotification> OnFileUploaded { get; set; }

    [Parameter]
    public FileInputSizeMode SizeMode { get; set; } = FileInputSizeMode.Fixed;

    [Parameter]
    public string FrameCSS { get; set; } = "";

    [Parameter]
    public string ControlCSS { get; set; } = "form-control";

    [Parameter]
    public string ProgressCSS { get; set; } = "progress mt-1";

    [Parameter]
    public string ProgressLineCSS { get; set; } = "progress-bar";

    [Parameter]
    public int Progress { get; set; } = 0;

    [Parameter]
    public string ControlStyle { get; set; } = "height: 36px; ";

    private string InternalStyle { get; set; } = " width:36px !important; height:28px !important; ";

    [Parameter]
    public int Width { get; set; } = 24;

    [Parameter]
    public int Height { get; set; } = 24;


    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        await SetStyle();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task Upload(InputFileChangeEventArgs e)
    {
        // Key darf ERST NACH dem Upload geändert werden!
        isLoading = true;
        Progress = 0;
        await InvokeAsync(StateHasChanged);

        IReadOnlyList<IBrowserFile> files = e.GetMultipleFiles(maxAllowedFiles);

        string contentRootPath = env.ContentRootPath;
        string relativeSaveFilePath = Path.Combine(contentRootPath, loc.DefaultFilePath);

        if (!Directory.Exists(relativeSaveFilePath))
        {
            Directory.CreateDirectory(relativeSaveFilePath);
        }

        if (!Directory.Exists(relativeSaveFilePath))
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        foreach (IBrowserFile file in files)
        {
            try
            {
                double fileSizeInMB = (double)file.Size / (1024 * 1024);

                if (fileSizeInMB > sec.Configuration.MaxFileSizeInMB)
                {
                    string info = $"Die Datei ist größer als {sec.Configuration.MaxFileSizeInMB} MB.";
                    msg.Publish("Info", BusAction.Info, info);
                    continue;
                }

                Guid itemGUID = Guid.NewGuid();
                string extension = Helper.SplitGetLast(file.Name);
                string fullFilePath = Path.Combine(relativeSaveFilePath, $"{itemGUID}.{extension}");

                // Bild 
                if (this.ItemType.Typ == ItemTypeTyp.Image)
                {
                    if (extension.IsValidImageExtension() == false)
                    {
                        // Info 
                        msg.Publish("Info", BusAction.Info, 
                            $"Datei: {file.Name} - nicht unterstütztes Bildformat.");
                        
                        // WEITER 
                        continue;    
                    }
                }

                // Audio 
                if (this.ItemType.Typ == ItemTypeTyp.Audio)
                {
                    if (extension.IsValidAudioExtension() == false)
                    {
                        // Info
                        msg.Publish("Info", BusAction.Info,
                            $"Datei: {file.Name} - nicht unterstütztes Audioformat.");

                        // WEITER
                        continue;
                    }
                }

                // Video 
                if (this.ItemType.Typ == ItemTypeTyp.Video)
                {
                    if (extension.IsValidVideoExtension() == false)
                    {
                        // Info
                        msg.Publish("Info", BusAction.Info,
                            $"Datei: {file.Name} - nicht unterstütztes Videoformat.");
                        // WEITER
                        continue;
                    }
                }

                try
                {
                    byte[] buffer = new byte[1024 * 80];
                    int bytesRead = 0;
                    long totalRead = 0;
                    int lastProgress = -1;

                    await using FileStream writeStream = new(
                        fullFilePath,
                        FileMode.Create,
                        FileAccess.Write,
                        FileShare.None,
                        bufferSize: 8192,
                        useAsync: true);

                    using Stream readStream = file.OpenReadStream(maxAllowedSize: Helper.MaxFileSize());

                    while ((bytesRead = await readStream.ReadAsync(buffer, 0, buffer.Length)) > 0)
                    {
                        await writeStream.WriteAsync(buffer.AsMemory(0, bytesRead));

                        totalRead += bytesRead;
                        int currentProgress = file.Size > 0 ? (int)((double)totalRead / file.Size * 100) : 0;

                        if (currentProgress != lastProgress)
                        {
                            Progress = currentProgress;
                            lastProgress = currentProgress;
                            await InvokeAsync(StateHasChanged);
                        }
                    }

                    await writeStream.FlushAsync();
                }
                catch (Exception exInner)
                {
                    System.Diagnostics.Debug.WriteLine("Fail Upload Image: " + exInner.ToString());
                    continue;
                }

                try
                {

                    if (extension.IsValidImageExtension())
                    {
                        // 1. Die eben geschriebene Datei komprimieren (Bytes direkt aus dem Speicher lesen)
                        // file.OpenReadStream ermöglicht direkten Zugriff ohne File-Locking-Probleme
                        using var imageStream = file.OpenReadStream(maxAllowedSize: Helper.MaxFileSize());
                        using var memoryStream = new MemoryStream();
                        await imageStream.CopyToAsync(memoryStream);

                        byte[] originalBytes = memoryStream.ToArray();

                        // 2. Komprimierung über JSInterop aufrufen
                        byte[]? compressedBytes = await ProcessByteArray(originalBytes);

                        if (compressedBytes != null && compressedBytes.Length > 0)
                        {
                            // 3. Pfad mit _min erstellen
                            string minFilePath = Path.Combine(relativeSaveFilePath, $"{itemGUID}_min.{extension}");

                            // 4. Datei mittels eigenem FileStream schreiben und explizit schließen (Flush & Close)
                            await using (FileStream minStream = new FileStream(
                                minFilePath,
                                FileMode.Create,
                                FileAccess.Write,
                                FileShare.None,
                                bufferSize: 8192,
                                useAsync: true))
                            {
                                await minStream.WriteAsync(compressedBytes.AsMemory(0, compressedBytes.Length));
                                await minStream.FlushAsync();
                            }
                        }
                    }
                }
                catch (Exception exMin)
                {

                }

                FileNotification token = new FileNotification
                {
                    FileGUID = itemGUID,
                    FullFilePath = fullFilePath,
                    OriginalFileName = file.Name,
                    FileSizeInByte = file.Size,
                    FileSizeInKB = file.Size / 1024m,
                    FileSizeInMB = file.Size / (1024m * 1024m),
                    FileExtension = file.Name.SplitGetLast(),

                    // MimeType und Text/Binary Bestimmung (Helper-Methoden)
                    MimeType = file.GetMimeTypeFromBrowserFile(),
                    IsText = file.IsProbablyTextFile(),
                    IsBinary = !file.IsProbablyTextFile()
                };
             

                await OnFileUploaded.InvokeAsync(token);
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine("FAIL: " + ex.ToString());
            }
        }

        isLoading = false;
        // Key nach erfolgreichem Stream zurücksetzen, um das Input-Element für weitere Uploads zu leeren
        inputFileKey = Guid.NewGuid();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SetStyle()
    {
        if (SizeMode == FileInputSizeMode.Fixed)
        {
            ControlStyle = "height: 36px; ";
            InternalStyle = " width:36px !important; height:28px !important; ";
        }
        else if (SizeMode == FileInputSizeMode.NULL)
        {
            ControlStyle = "height: 36px; ";
            InternalStyle = " width:36px !important; height:28px !important; ";
        }
        else if (SizeMode == FileInputSizeMode.Maximized)
        {
            // Dehnt das Control vollständig auf die Spaltenbreite/Höhe des Eltern-Containers aus
            ControlStyle = "width: 100%; height: 100%; top: 0; left: 0; transform: none;";
            InternalStyle = "width: 100% !important; height: 100% !important; min-height: 36px;";
        }

        await Task.CompletedTask;
    }

    public async Task<byte[]?> ProcessByteArray(byte[] sourceBytes)
    {
        int size = sec.Configuration.SmallImagePixel;
        try
        {
            // Parameter 200 = Längste Seite maximal 200px (Seitenverhältnis bleibt erhalten)
            return await JS.InvokeAsync<byte[]>(
                "imageUtils.compressToTargetSize",
                sourceBytes, size
            );
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("JSInterop Error: " + ex.ToString());
            return null;
        }
    }


    public void Dispose()
    {
    }
}