@using System
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Hosting
@implements IDisposable
@inject IJSRuntime JS

@inject IWebHostEnvironment env
@inject ISqlDatabaseService sql
@inject ILocalizationService loc
@inject ISecurityService sec

<div class="pointer rounded hover overflow-hidden bg-surface text-white position-relative mx-2"
     style="@( "border: 1px dashed #333 !important; " + InternalStyle )">

    @if (isLoading)
    {
        <div class="@( ProgressCSS + " position-absolute top-50 start-50 translate-middle " )"
             style="@( "  " + InternalStyle )"
             title="@(Progress + "% Complete")">
            <div class="@ProgressLineCSS" style="width: @(Progress + "%")" role="progressbar"
                 aria-valuenow="@Progress" aria-valuemin="0" aria-valuemax="100">
            </div>
        </div>
    }
    else
    {
        <div class="px-1 position-absolute top-50 start-50 translate-middle">
            <SymbolIcon Symbol="Icon.File" />
        </div>
    }

    <!-- InputFile darf während des Uploads NICHT aus dem DOM entfernt werden -->
    <InputFile @key="inputFileKey" id="@ID" multiple OnChange="@Upload"
               disabled="@isLoading"
               class="@( ControlCSS + " position-absolute top-50 start-50 translate-middle " )"
               style="@( ControlStyle + " opacity:0.0005; " + (isLoading ? "display:none;" : "") + InternalStyle )" />
</div>

@code {

    private string ID = "file_input_" + Guid.NewGuid();
    private Guid inputFileKey = Guid.NewGuid();

    private int maxAllowedFiles = 5;
    private bool isLoading;

    [Parameter]
    public EventCallback<FileNotification> OnFileUploaded { get; set; }

    [Parameter]
    public string FrameCSS { get; set; } = "";

    [Parameter]
    public string ControlCSS { get; set; } = "form-control";

    [Parameter]
    public string ProgressCSS { get; set; } = "progress mt-1";

    [Parameter]
    public string ProgressLineCSS { get; set; } = "progress-bar";

    [Parameter]
    public int Progress { get; set; } = 0;

    [Parameter]
    public string ControlStyle { get; set; } = "height: 36px; ";

    private string InternalStyle { get; set; } = " width:36px !important; height:28px !important; ";

    [Parameter]
    public IItemType ItemType { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        await SetStyle();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task Upload(InputFileChangeEventArgs e)
    {
        // Key darf ERST NACH dem Upload geändert werden!
        isLoading = true;
        Progress = 0;
        await InvokeAsync(StateHasChanged);

        IReadOnlyList<IBrowserFile> files = e.GetMultipleFiles(maxAllowedFiles);

        string contentRootPath = env.ContentRootPath;
        string relativeSaveFilePath = Path.Combine(contentRootPath, loc.DefaultFilePath);

        if (!Directory.Exists(relativeSaveFilePath))
        {
            Directory.CreateDirectory(relativeSaveFilePath);
        }

        if (!Directory.Exists(relativeSaveFilePath))
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        foreach (IBrowserFile file in files)
        {
            try
            {
                long maxAllowedBytes = (long)sec.Configuration.MaxFileSizeInMB * 1024 * 1024;
                if (file.Size > maxAllowedBytes)
                {
                    continue;
                }

                Guid itemGUID = Guid.NewGuid();
                string extension = Helper.SplitGetLast(file.Name);
                string fullFilePath = Path.Combine(relativeSaveFilePath, $"{itemGUID}.{extension}");

                try
                {
                    byte[] buffer = new byte[1024 * 80];
                    int bytesRead = 0;
                    long totalRead = 0;
                    int lastProgress = -1;

                    await using FileStream writeStream = new(
                        fullFilePath,
                        FileMode.Create,
                        FileAccess.Write,
                        FileShare.None,
                        bufferSize: 8192,
                        useAsync: true);

                    using Stream readStream = file.OpenReadStream(maxAllowedSize: Helper.MaxFileSize());

                    while ((bytesRead = await readStream.ReadAsync(buffer, 0, buffer.Length)) > 0)
                    {
                        await writeStream.WriteAsync(buffer.AsMemory(0, bytesRead));

                        totalRead += bytesRead;
                        int currentProgress = file.Size > 0 ? (int)((double)totalRead / file.Size * 100) : 0;

                        if (currentProgress != lastProgress)
                        {
                            Progress = currentProgress;
                            lastProgress = currentProgress;
                            await InvokeAsync(StateHasChanged);
                        }
                    }

                    await writeStream.FlushAsync();
                }
                catch (Exception exInner)
                {
                    System.Diagnostics.Debug.WriteLine("Fail Upload Image: " + exInner.ToString());
                    continue;
                }

                FileNotification token = new FileNotification
                {
                    FileGUID = itemGUID,
                    FullFilePath = fullFilePath,
                    OriginalFileName = file.Name,
                    FileSizeInByte = file.Size,
                    FileSizeInKB = file.Size / 1024m,
                    FileSizeInMB = file.Size / (1024m * 1024m),
                    FileExtension = file.Name.SplitGetLast()
                };

                await OnFileUploaded.InvokeAsync(token);
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine("FAIL: " + ex.ToString());
            }
        }

        isLoading = false;
        // Key nach erfolgreichem Stream zurücksetzen, um das Input-Element für weitere Uploads zu leeren
        inputFileKey = Guid.NewGuid();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SetStyle()
    {
        InternalStyle = " width:36px !important; height:28px !important; ";
        await Task.CompletedTask;
    }

    public void Dispose()
    {
    }
}