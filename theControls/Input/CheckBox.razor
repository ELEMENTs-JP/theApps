@if (!string.IsNullOrEmpty(this.Label))
{
    <label class="form-label text-secondary" for="@Id">
        @Label
    </label>
}


<div class="form-check @( (IsSwitch ? " form-switch " : " ") ) no-focus @CssClass" 
        style="@Style @( (IsSwitch ? " min-height: 2.35rem; " : " ") )">
    <input id="@Id"
           name="@InputName"
           class="form-check-input"
           type="checkbox"
            value="@Value"
           checked="@IsChecked"
           @onchange="HandleInput" />

    @if (IsChecked && !string.IsNullOrEmpty(TrueText))
    {
        <label class="form-check-label ms-2" for="@Id">
            @TrueText
        </label>
    }
    else if (!IsChecked && !string.IsNullOrEmpty(FalseText))
    {
        <label class="form-check-label ms-2" for="@Id">
            @FalseText
        </label>
    }

    @if (Inlay != null)
    {
        <div class="ms-2">
            @Inlay
        </div>
    }

    @if (Overlay != null)
    {
        <div class="ms-2">
            @Overlay
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(Description))
{
    <div class="text-muted text-truncate small border-top mt-1" 
    style="padding-left:3px; padding-top:3px; max-width:9rem; ">
        @Description.ToSecureString()
    </div>
}

@if (!string.IsNullOrEmpty(Hint))
{
    <div class="form-hint text-truncate" style="padding-left:3px; padding-top:3px; max-width:9rem; ">
        @Hint.ToSecureString()
    </div>
}


@code {

    [Parameter]
    public RenderFragment? Overlay { get; set; }

    [Parameter]
    public RenderFragment? Inlay { get; set; }


    [Parameter]
    public string Id { get; set; } = Guid.NewGuid().ToString();


    [Parameter]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public bool IsSwitch { get; set; } = true;


    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string TrueText { get; set; } = string.Empty;

    [Parameter]
    public string FalseText { get; set; } = string.Empty;


    [Parameter]
    public string Description { get; set; } = string.Empty;


    [Parameter]
    public string Hint { get; set; } = string.Empty;


    [Parameter]
    public string Value { get; set; } = "false";


    [Parameter]
    public string CssClass { get; set; } = string.Empty;

    [Parameter]
    public string Style { get; set; } = " margin-left: 9px; padding-top: 9px; ";


    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }


    [Parameter]
    public bool IsEditable { get; set; } = true;


    private bool IsChecked
    {
        get => ParseBoolean(Value);
        set => Value = value.ToString().ToLowerInvariant();
    }


    private async Task HandleInput(ChangeEventArgs e)
    {
        var checkedValue = e.Value is bool b && b;

        Value = checkedValue
            ? "true"
            : "false";

        await ValueChanged.InvokeAsync(Value);
    }


    private static bool ParseBoolean(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return false;

        return value.Trim().ToLowerInvariant() switch
        {
            "true" => true,
            "1" => true,
            "yes" => true,
            "y" => true,
            "on" => true,

            _ => false
        };
    }


    private string InputName =>
        !string.IsNullOrWhiteSpace(Name)
            ? Name
            : Helper.GenerateName(Label);
}