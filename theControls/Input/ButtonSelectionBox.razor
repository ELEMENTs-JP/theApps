@inject ISqlDatabaseService sql
@inject ILocalizationService loc
@inject IMessagingBusService msg
@implements IAsyncDisposable

@if (!string.IsNullOrEmpty(this.Label))
{
    <label class="form-label text-secondary" for="@ID">@Label</label>
}

<div class="position-relative overlay-container p-1">
    <div class="btn-group" role="group">

        @foreach (IDTO it in Items.FromTo<IDTO>(0, 2))
        {
            <div class="@($"btn btn-sm {(Item?.ID == it.ID ? "btn-primary" : "")}")"
                 @onclick="@(async e => { Item = it; await onSelect(it); })">
                @it.Title.ToString()
            </div>
        }

        @if (Items.Count() >= 4)
        {
            <div class="btn-group" role="group">
                <div class="btn btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    ...
                </div>


                <div class="dropdown-menu" style="">

                    @* Es geht um folgende TextBox *@
                    <div class="p-2" @onclick:stopPropagation="true">
                        <input type="text"
                               class="form-control form-control-sm"
                               placeholder="@loc.GetLabel("Suchen...", "find...")"
                               @bind="searchTerm"
                               @bind:event="oninput" />
                    </div>
                    <div class="dropdown-divider"></div>
                    @foreach (IDTO item in Items.FromTo<IDTO>(3, Items.Count() + 1))
                    {
                        <div class="@( "dropdown-item" )"
                             @onclick="@( async e => { Item = item; await onSelect(item); })">
                            @if (ItemTemplate is not null)
                            {
                                @ItemTemplate(item)
                            }
                            else
                            {
                                @item.Title
                            }
                        </div>
                    }

                </div>
            </div>
        }
    </div>

    @if (Inlay != null)
    {
        <div class="position-absolute top-50 end-0 translate-middle-y me-2">
            @Inlay
        </div>
    }

    @if (Overlay != null)
    {
        <div class="overlay position-absolute top-50 end-0 translate-middle-y me-2">
            @Overlay
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(Description))
{
    <div class="text-muted small border-top mt-1" style="padding-left:3px; padding-top:3px;">
        @this.Description.ToSecureString()
    </div>
}
@if (!string.IsNullOrEmpty(Hint))
{
    <div class="form-hint" style="padding-left:3px; padding-top:3px;">
        @Hint.ToSecureString()
    </div>
}

@code {

    [Parameter]
    public RenderFragment<IDTO>? ItemTemplate { get; set; }

    [Parameter]
    public RenderFragment? Overlay { get; set; }

    [Parameter]
    public RenderFragment? Inlay { get; set; }

    [Parameter]
    public string ID { get; set; } = Guid.NewGuid().ToString();

    [Parameter]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string Description { get; set; } = string.Empty;
    [Parameter]
    public string Hint { get; set; } = string.Empty;

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public string CssClass { get; set; } = string.Empty;

    [Parameter]
    public string MenuStyle { get; set; } = "min-width:13rem;";

    [Parameter]
    public string MaxHeightCSS { get; set; } = "max-height:44rem;";

    [Parameter]
    public List<IDTO> Items { get; set; } = new();

    [Parameter]
    public IDTO Item { get; set; } // Current // Selection 

    [Parameter]
    public EventCallback<IDTO> ItemChanged { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = string.Empty;


    [Parameter]
    public bool IsEditable { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await Init();
    }

    private async Task Init()
    {
        Item = Items.FirstOrDefault(se => se.Title == this.Value);
        if (Item == null)
        {
            Item = Items.FirstOrDefault(se => se.ID == this.Value);
        }
    }

    private async Task onSelect(IDTO dto)
    {
        if (dto == null)
            return;

        // Select 
        this.Item = dto;

        await ItemChanged.InvokeAsync(dto);

        msg.Publish("Info", BusAction.Info, "Auswahl getätigt.");

        // await InvokeAsync(StateHasChanged);
    }


    private string searchTerm = string.Empty;

    private IEnumerable<IDTO> GetFilteredItems()
    {
        if (Items is null)
            return Enumerable.Empty<IDTO>();

        if (string.IsNullOrWhiteSpace(searchTerm))
            return Items;

        return Items.Where(x => x.Title != null &&
                                x.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
    }

    private string InputName =>
    !string.IsNullOrWhiteSpace(Name)
        ? Name
        : Helper.GenerateName(Label);


    public async ValueTask DisposeAsync()
    {
        try
        {
            if (Items != null)
            {
                Items.Clear();
                Items = null;
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : DISPOSE : BoardComp : " + ex.Message);
        }
    }
}
