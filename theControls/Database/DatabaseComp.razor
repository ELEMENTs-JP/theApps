@using Microsoft.AspNetCore.Hosting
@using theDatabase
@using theInfrastructure
@inject ISqlDatabaseService sql
@inject IMessagingBusService msg
@inject IWebHostEnvironment env

<div class="">


    <div class="row g-0">
        <div class="col-3 py-2">
            <KpiFrame KPI="Datenbank" Description="Anzahl an Datensätze"
                      Value="@( sql.GetRecordCount().Result.ToSecureString() )" />
        </div>
        <div class="col-3 py-2 px-2">
            <KpiFrame KPI="Datenbankgröße" Description="Größe der Datenbank in MB" 
                      Value="@( DBFileSize )" />
        </div>
        <div class="col-3 p-2 px-2">
            <KpiFrame KPI="Page Count" Description="Anzahl verwendete Pages" 
                Value="@( sql.GetUsedPageCount().Result.ToSecureString() )" />
        </div>
        <div class="col-3 py-2">
            <KpiFrame KPI="Unused Pages" Description="Anzahl ungenutzter Pages" 
                Value="@(  sql.GetNotUsedPageCount().Result.ToSecureString() )" />
        </div>
    </div>


    <div class="row align-items-center bg-surface border rounded-2 p-2 my-2">
        <div class="col p-2">
            Datenbank Zustand
        </div>

        <div class="col-auto p-2">
            @if (sql.DatabaseExists == true)
            {
                <span class="badge bg-success text-white">Datenbank existiert</span>
            }
            else
            {
                <span class="badge bug-warning">Keine Datenbank vorhanden</span>
            }
        </div>
    </div>


    @if (sql.DatabaseExists == true)
    {

        <h2 class="h2">Backup Management</h2>
        <div class="row g-0">
            <div class="col-6">

                <div class="d-flex align-items-center bg-surface p-2">
                <strong class="flex-fill">Backup erstellen</strong>
                <button class="btn btn-sm btn-success m-2" @onclick="BackupDatabase">Backup erstellen</button>
            </div>



            </div>

            <div class="col-6">
                <div class="p-2">

                    @foreach (FileInfo file in DbFiles)
                    {
                        <div class="d-flex align-items-center border-bottom p-1">
                            <div class="flex-fill p-1">
                                @file.Name
                            </div>
                            <div class="p-1 text-end">
                                @file.Length.ToMB()
                            </div>
                        </div>    
                    }

                </div>
            </div>
        </div>
    }


    @if (sql.DatabaseExists == true)
    {
        <div class="row align-items-center bg-surface border rounded-2 p-2 my-2">
            <div class="col p-2">
                Datenbank komprimieren
            </div>
            <div class="col-auto p-2">
                <button class="btn btn-sm btn-primary m-3" 
                    @onclick="@( async e => { 
                        await sql.CompressDatabase(); 
                        msg.Publish("Info", BusAction.Info, "Datenbank wurde komprimiert."); } )">komprimieren</button>
            </div>
        </div>
        <div class="row align-items-center bg-surface border rounded-2 p-2 my-2">
            <div class="col p-2">
                Datenbank optimieren
            </div>
            <div class="col-auto p-2">
                <button class="btn btn-sm btn-primary m-3" 
                @onclick="@( async e => {  
                    await sql.OptimizeDatabase(); 
                            msg.Publish("Info", BusAction.Info, "Datenbank wurde optimiert.");
                        })">
                    Optimieren
                </button>
            </div>
        </div>

  
        <h2 class="h2 text-danger">Danger Zone</h2>
        <div class="row align-items-center bg-surface border border-red rounded-2 p-2 my-2">
            <div class="col p-2 text-danger fw-bold">
                <strong>Datenbank löschen</strong>
                <div>Wenn Sie die Datenbank löschen, können Sie genau diese nicht wieder herstellen.</div>
            </div>
            <div class="col-auto p-2">
                <button class="btn btn-sm btn-danger m-3" @onclick="DeleteDatabase">löschen</button>
            </div>
        </div>
    }
    else
    {
        <div class="row align-items-center bg-surface border rounded-2 p-2 my-2">
            <div class="col p-2">
                Datenbank erstellen
            </div>
            <div class="col-auto p-2">
                <button class="btn btn-sm btn-success m-3" @onclick="CreateDatabase">erstellen</button>
            </div>
        </div>
    }

    <div class="m-3">@Info</div>
</div>

@code {

    string Info = string.Empty;
    string DBFileSize = string.Empty;

    List<FileInfo> DbFiles { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await DatabaseSize();
        await LoadFiles();
    }

    private async Task LoadFiles()
    {
        string filePath = Path.Combine(env.ContentRootPath, "Database", "Backup");

        if (Directory.Exists(filePath))
        {
            DbFiles = new DirectoryInfo(filePath).GetFiles("*.db").ToList();
        }
    }

    private async Task DatabaseSize()
    {
        string filePath = Path.Combine(env.ContentRootPath, "Database", "Default.db");
        const double bytesToMB = 1024.0 * 1024.0;
        long length = 0;
        if (File.Exists(filePath))
        {
            length = new FileInfo(filePath).Length;
        }
        DBFileSize = $"{length / bytesToMB:F2} MB";
    
    }
    private async Task CreateDatabase()
    {
        SQLiteService.Database = "Default.db";
        IQueryResult info = sql.CreateDatabase();
        Info = info.Message;
    }
    private async Task BackupDatabase()
    {
        SQLiteService.Database = "Default.db";
        IQueryResult info = sql.BackupDatabase();
        Info = info.Message;
    }

    private async Task DeleteDatabase()
    {
        SQLiteService.Database = "Default.db";
        IQueryResult info = sql.DeleteDatabase();
        Info = info.Message;
    }

}
