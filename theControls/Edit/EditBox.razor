@using theControls.Icons
@using theControls.Input
@inject IMessagingBusService msg
@inject ISecurityService sec
@inject ISqlDatabaseService sql
@implements IAsyncDisposable

@if (Field != null && Context != null && Context.Item != null)
{
    <div class="@( ((Border == true) ? "border " : "")) rounded-2 p-1 px-2 @CssClass">

        @if (Field.Typ == FieldTyp.TextArea)
        {
            <TextArea @key="@( "TextArea-" + Context.ID + "-" + Field.Title + "-" + Context.Item.GUID)"
                      Label="@Title" Description="@Description" Value="@Value"
                      ValueChanged="@(async e => { onValueChanged(e); await Change(); })"
                      Placeholder="@Field.Placeholder"
                      CssClass="@CssClass"
                      Rows="@Rows"
                      IsEditable="@IsEditable">
                <Overlay>
                    <div class="hover pointer rounded-2 p-1 me-1" @onclick="Save">
                        <i class="ti ti-check"></i>
                    </div>
                </Overlay>

            </TextArea>
        }
        else if (Field.Typ == FieldTyp.DropDown ||
                Field.Typ == FieldTyp.FieldTyp ||
                Field.Typ == FieldTyp.ItemTypeTyp ||
                Field.Typ == FieldTyp.User ||
                 Field.Typ == FieldTyp.Priority ||
                 Field.Typ == FieldTyp.Status ||
                 Field.Typ == FieldTyp.Progress)
        {
            <DropDown @key="@( "DropDown-" + Context.ID + "-" + Field.Title + "-" + Context.Item.GUID)"
                      Label="@Title" Description="@Description" Value="@Value" Items="@Items"
                      ValueChanged="@(async e =>{ onValueChanged(e); await Change(); await Save(); })"
                      Placeholder="@Field.Placeholder"
                      CssClass="@CssClass"
                      IsEditable="@IsEditable">

            </DropDown>
        }
        else if (Field.Typ == FieldTyp.CheckBox)
        {
            <CheckBox @key="@( "CheckBox-" + Context.ID + "-" + Field.Title + "-" + Context.Item.GUID)"
                      Label="@Title" Description="@Description" Value="@Value"
                      ValueChanged="@(async e =>{ onValueChanged(e); await Change(); await Save(); })"
                      CssClass="@CssClass"  IsEditable="@IsEditable"
                      TrueText="@Field.TrueText" FalseText="@Field.FalseText" >

            </CheckBox>
        }
        else if (Field.Typ == FieldTyp.Heading)
        {
            <Heading @key="@( "Heading-" + Context.ID + "-" + Field.Title + "-" + Context.Item.GUID)"
                     Label="@Title" ShowLabel="false" Description="@Description" Value="@Value"
                     ValueChanged="@(async e =>{ onValueChanged(e); await Change(); })"
                     CssClass="@CssClass"
                     IsEditable="@IsEditable">
                <Overlay>
                    <div class="hover pointer rounded-2 p-1 me-2" @onclick="Save">
                        <SymbolIcon Symbol="@Icon.Check" />
                    </div>

                </Overlay>
            </Heading>
        }
        else if (Field.Typ == FieldTyp.Html)
        {
            <HtmlBox @key="@( "Html-" + Context.ID + "-" + Field.Title + "-" + Context.Item.GUID)"
                     Label="@Title" Description="@Description" Value="@Value"
                     ValueChanged="@(async e =>{ onValueChanged(e); await Change(); })"
                     CssClass="@CssClass"
                     IsEditable="@IsEditable">
                <Overlay>
                    <div class="hover pointer rounded-2 p-1 me-2" @onclick="Save">
                        <SymbolIcon Symbol="@Icon.Check" />
                    </div>
                </Overlay>
            </HtmlBox>
        }
        else
        {
            <TextBox @key="@( "TextBox-" + Context.ID + "-" + Field.Title + "-" + Context.Item.GUID)"
                     Label="@Title" Description="@Description" Value="@Value"
                     ValueChanged="@(async e =>{ onValueChanged(e); await Change(); })"
                     Type="@Field.Typ"
                     Placeholder="@Field.Placeholder"
                     CssClass="@CssClass"
                     Min="@Min" Max="@Max" Step="@Step"
                     IsEditable="@IsEditable">
                <Inlay>
                    @if (Field.Typ == FieldTyp.Search)
                    {
                        <SymbolIcon Symbol="@Icon.Search" />
                    }
                </Inlay>
                <Overlay>
                    @if (Field.Typ != FieldTyp.Search)
                    {
                        <div class="hover pointer rounded-2 p-1" @onclick="Save">
                            <SymbolIcon Symbol="@Icon.Check" />
                        </div>
                    }
                </Overlay>
            </TextBox>
        }
    </div>

}

@code {

    private string Title { get; set; } = string.Empty;
    private string Description { get; set; } = string.Empty;
    private string Value { get; set; } = string.Empty;


    [Parameter]
    public List<IDTO> Items { get; set; } = new();

    [Parameter]
    public IField Field { get; set; }

    [Parameter]
    public ValueBindingTyp Binding { get; set; } = ValueBindingTyp.Property;

    [Parameter]
    public IQueryContext Context { get; set; }

    [Parameter]
    public string CssClass { get; set; } = "  ";

    [Parameter]
    public bool Border { get; set; } = true;

    [Parameter]
    public bool ShowLabel { get; set; } = false;

    [Parameter]
    public string? Min { get; set; }

    [Parameter]
    public string? Max { get; set; }

    [Parameter]
    public string? Step { get; set; }

    [Parameter]
    public int Rows { get; set; } = 4;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public bool IsEditable { get; set; } = true;

    // Events 
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        Title = Field.Title;
        Description = Field.Description;

        await Init();

        Value = onValueBinding();
    }

    // Methods 
    public async Task Init()
    {
        this.Items = await Helper.InitDropDown(Field, sql);
    }

    // Helper 
    private async Task<IDTO> Save()
    {
        // Update
        await Context.Update(Context.Item);

        // Update 
        msg.Publish("", BusAction.Info, "Eintrag aktualisiert");

        if (Context.Item.ItemType == "User")
        {
            if (Context.Item.GUID == sec.User.GUID)
            {
                // User Neu laden 
                await sec.RefreshUser();
            }
        }

        // Events
        await ItemSaved.InvokeAsync(Context.Item);
        return Context.Item;
    }
    private async Task<IDTO> Change()
    {
        // Events
        await ItemChanged.InvokeAsync(Context.Item);
        return Context.Item;
    }

    // ... 
    private string onValueBinding()
    {
        if (Binding == ValueBindingTyp.Property)
        {
            string val = Context.Item[Field.Column].ToSecureString();

            if (Field.Typ == FieldTyp.Date)
            {
                val = val.ToDate();
            }
            else if (Field.Typ == FieldTyp.Time)
            {

            }
            else if (Field.Typ == FieldTyp.DateTime)
            {

            }

            return val;
        }
        else if (Binding == ValueBindingTyp.Description)
        {
            return Context.Item.Content.ToSecureString();
        }
        else
        {
            return Context.Item.Title.ToSecureString();
        }
    }
    private void onValueChanged(string text)
    {
        if (Binding == ValueBindingTyp.Property)
        {
            Context.Item[Field.Column] = text;
        }
        else if (Binding == ValueBindingTyp.Description)
        {
            Context.Item.Content = text;
        }
        else
        {
            Context.Item.Title = text;
        }

    }

    [Parameter]
    public EventCallback<IDTO> ItemChanged { get; set; }

    [Parameter]
    public EventCallback<IDTO> ItemSaved { get; set; }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (Items != null)
            {
                Items.Clear();
                Items = null;
            }

            if (Field != null)
            {
                Field = null;
            }

            if (Context != null)
            {
                ((IDisposable)Context).Dispose();
                Context = null;
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : DISPOSE : BoardComp : " + ex.Message);
        }
    }
}