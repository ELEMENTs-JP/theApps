@using theControls.Icons
@using theControls.Input


@if (Field != null && Context != null && Context.Item != null)
{
    <div class="@( ((Border == true) ? "border " : "")) rounded-2 p-2 bg-body">
    
        @if (Field.Typ == FieldTyp.TextArea)
        {
            <TextArea Label="@Field.Title"
                      Description="@Field.Description"
                      Value="@Context.Item[Field.Column]"
                      ValueChanged="@ValueChanged"
                      Placeholder="@Field.Placeholder"
                      CssClass="@CssClass"
                      Rows="@Rows"
                      Disabled="@Disabled"
                      ReadOnly="@ReadOnly">
            <Overlay>
                <button type="button"
                class="btn btn-sm btn-icon btn-success px-2"
                @onclick="OnSaveClicked">
                    <i class="ti ti-check"></i>
                </button>
            </Overlay>

        </TextArea>
        }
        else if (Field.Typ == FieldTyp.Select)
        {
            <Select Label="@Field.Title"
                    Description="@Field.Description"
                    Items="@Items"
                    Value="@Context.Item[Field.Column]"
                    ValueChanged="@ValueChanged"
                    Placeholder="@Field.Placeholder"
                    CssClass="@CssClass"
                    Disabled="@Disabled"
                    ReadOnly="@ReadOnly">
            </Select>
        }
        else
        {
            <TextBox Label="@Field.Title"
                     Description="@Field.Description"
                     Value="@Context.Item[Field.Column]"
                     ValueChanged="@ValueChanged"
                     Type="@Field.Typ"
                     Placeholder="@Field.Placeholder"
                     CssClass="@CssClass"
                     Min="@Min"
                     Max="@Max"
                     Step="@Step"
                     Disabled="@Disabled"
                     ReadOnly="@ReadOnly">
                <Inlay>
                    @if (Field.Typ == FieldTyp.Search)
                    {
                        <SymbolIcon Symbol="@Icon.Search" />
                    }
                </Inlay>
                <Overlay>
                    @if (Field.Typ != FieldTyp.Search)
                    {
                        <button type="button"
                                class="btn btn-sm btn-icon btn-success" style="padding:0.7rem;"
                                @onclick="OnSaveClicked">
                            <SymbolIcon Symbol="@Icon.Check" />
                        </button>
                    }
                </Overlay>
            </TextBox>
        }
    </div>

}

@code {

    [Parameter]
    public List<IDTO> Items { get; set; } = new();

    [Parameter]
    public IField Field { get; set; }

    [Parameter]
    public IQueryContext Context { get; set; }

    [Parameter]
    public string CssClass { get; set; } = string.Empty;

    [Parameter]
    public bool Border { get; set; } = true;

    [Parameter]
    public string? Min { get; set; }

    [Parameter]
    public string? Max { get; set; }

    [Parameter]
    public string? Step { get; set; }
    [Parameter]
    public int Rows { get; set; } = 4;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public EventCallback OnSaveClicked { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

}