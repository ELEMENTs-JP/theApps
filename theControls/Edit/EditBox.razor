@using theControls.Essentials
@using theControls.Icons
@using theControls.Input
@inject IMessagingBusService msg
@inject ISecurityService sec
@inject ISqlDatabaseService sql
@inject IAppService app
@implements IAsyncDisposable

@if (Field != null && Context != null && Context.Item != null)
{
    <div class="@( ((Border == true) ? "border " : "")) rounded-2 p-1 px-2 @CheckCondition(Context.Item) @CssClass">

        @if (Field.Typ == FieldTyp.TextArea)
        {
            <TextArea @key="@( "TextArea-" + Context.ID + "-" + Field.Title + "-" + Context.Item.GUID)"
                      Label="@Title" Description="@Description" Value="@Value"
                      ValueChanged="@(async e => { onValueChanged(e); await Change(); })"
                      Placeholder="@Field.Placeholder"
                      CssClass="@CssClass"
                      Style="@ControlStyle"
                      Rows="@Rows"
                      IsEditable="@IsEditable">
                <Overlay>
                    <div class="hover pointer rounded-2 p-1 me-1" @onclick="Save">
                        <i class="ti ti-check"></i>
                    </div>
                </Overlay>

            </TextArea>
        }
        else if (Field.Typ == FieldTyp.Select)
        {
            <Selection @key="@( "Select-" + Context.ID + "-" + Field.Title + "-" + Context.Item.GUID)"
                       Label="@Title" Description="@Description" Value="@Value"
                       Item="@Context.Item" ItemType="@Field.ItemType" 
                       Association="@Field.Association"
                       ItemAssigned="@(async e =>{ await SelectAssign(e);  })"
                       ItemRemoved="@(async e =>{ await SelectRemove(e); })"
                       ItemChanged="@(async e =>{  })"
                       Placeholder="@Field.Placeholder"
                       CssClass="@CssClass"
                       IsEditable="@IsEditable">
            </Selection>
        }
        else if (Field.Typ == FieldTyp.DropDown ||
                Field.Typ == FieldTyp.Color ||
                Field.Typ == FieldTyp.FieldTyp ||
                Field.Typ == FieldTyp.ItemTypeTyp ||
                Field.Typ == FieldTyp.ItemTypeList ||
                Field.Typ == FieldTyp.AppList ||
                Field.Typ == FieldTyp.FunctionList ||
                Field.Typ == FieldTyp.AssociationTyp ||
                Field.Typ == FieldTyp.User ||
                 Field.Typ == FieldTyp.Priority ||
                 Field.Typ == FieldTyp.Status ||
                 Field.Typ == FieldTyp.Progress)
        {
            <DropDown @key="@( "DropDown-" + Context.ID + "-" + Field.Title + "-" + Context.Item.GUID)"
                      Label="@Title" Description="@Description" Value="@Value" Items="@Items"
                      ValueChanged="@(async e =>{ onValueChanged(e); await Change(); await Save(); })"
                      Placeholder="@Field.Placeholder"
                      CssClass="@CssClass"
                      IsEditable="@IsEditable">
                <HeaderTemplate Context="headitem">
                    @if (Field.Typ == FieldTyp.Progress)
                    {
                        <ProgressBar Value="@headitem.Title.ToSecureString()" />
                    }
                    else if (Field.Typ == FieldTyp.Priority)
                    {
                        <PriorityBox ID="@headitem.ID" Value="@headitem.Title" />
                    }
                    else if (Field.Typ == FieldTyp.Status)
                    {
                        <StatusBox ID="@headitem.ID" Value="@headitem.Title" />
                    }
                    else if (Field.Typ == FieldTyp.Color)
                    {
                        <div class="col px-1" style="background-color:@headitem.ID">
                        </div>
                        <div class="col px-1">
                            @headitem.Title
                        </div>
                    }
                    else
                    {
                        @headitem.Title.ToSecureString()
                    }
                </HeaderTemplate>
                <ItemTemplate Context="entry">
                    <div class="row g-0">

                        @if (Field.Typ == FieldTyp.Priority)
                        {
                            <PriorityBox ID="@entry.ID" Value="@entry.Title" />
                        }
                        else if (Field.Typ == FieldTyp.Status)
                        {
                            <StatusBox ID="@entry.ID" Value="@entry.Title" />
                        }
                        else if (Field.Typ == FieldTyp.Color)
                        {
                            <div class="col-auto px-1" style="">
                                <div style="width: 20px; height: 20px; border-radius: 50%; border:2px solid #fff; background-color:@entry.ID"></div>
                            </div>
                            <div class="col px-1">
                                @entry.Title
                            </div>
                        }
                        else
                        {
                            <div class="col px-1">
                                @entry.Title
                            </div>
                        }
                    </div>

                </ItemTemplate>
            </DropDown>
        }
        else if (Field.Typ == FieldTyp.CheckBox)
        {
            <CheckBox @key="@( "CheckBox-" + Context.ID + "-" + Field.Title + "-" + Context.Item.GUID)"
                      Label="@Title" Description="@Description" Value="@Value"
                      ValueChanged="@(async e =>{ onValueChanged(e); await Change(); await Save(); })"
                      CssClass="@CssClass" IsEditable="@IsEditable"
                      TrueText="@Field.TrueText" FalseText="@Field.FalseText">

            </CheckBox>
        }
        else if (Field.Typ == FieldTyp.Heading)
        {
            <Heading @key="@( "Heading-" + Context.ID + "-" + Field.Title + "-" + Context.Item.GUID)"
                     Label="@Title" ShowLabel="false" Description="@Description" Value="@Value"
                     ValueChanged="@(async e =>{ onValueChanged(e); await Change(); })"
                     CssClass="@CssClass"
                     Style="@ControlStyle"
                     IsEditable="@IsEditable">
                <Overlay>
                    <div class="hover pointer rounded-2 p-1 me-2" @onclick="Save">
                        <SymbolIcon Symbol="@Icon.Check" />
                    </div>

                </Overlay>
            </Heading>
        }
        else if (Field.Typ == FieldTyp.Html)
        {
            <HtmlBox @key="@( "Html-" + Context.ID + "-" + Field.Title + "-" + Context.Item.GUID)"
                     Label="@Title" Description="@Description" Value="@Value"
                     ValueChanged="@(async e =>{ onValueChanged(e); await Change(); })"
                     CssClass="@CssClass"
                     IsEditable="@IsEditable">
                <Overlay>
                    <div class="hover pointer rounded-2 p-1 me-2" @onclick="Save">
                        <SymbolIcon Symbol="@Icon.Check" />
                    </div>
                </Overlay>
            </HtmlBox>
        }
        else if (Field.Typ == FieldTyp.TextBlock)
        {
            <TextBlock @key="@( "TextBlock-" + Context.ID + "-" + Field.Title + "-" + Context.Item.GUID)"
                       Label="@Title" Description="@Description" Value="@Value" Format="@Field.Formatierung"
                       Extension="@Field.Extension"
                       IsEditable="@IsEditable" />
        }
        else
        {
            <TextBox @key="@( "TextBox-" + Context.ID + "-" + Field.Title + "-" + Context.Item.GUID)"
                     Label="@Title" Description="@Description" Value="@Value"
                     ValueChanged="@(async e =>{ onValueChanged(e); await Change(); })"
                     Type="@Field.Typ"
                     Placeholder="@Field.Placeholder"
                     CssClass="@CssClass"
                     Min="@Min" Max="@Max" Step="@Step"
                     Extension="@Field.Extension"
                     IsEditable="@IsEditable">
                <Inlay>
                    @if (Field.Typ == FieldTyp.Search)
                    {
                        <SymbolIcon Symbol="@Icon.Search" />
                    }
                </Inlay>
                <Overlay>
                    @if (Field.Typ != FieldTyp.Search)
                    {
                        <div class="hover pointer rounded-2 p-1" @onclick="Save">
                            <SymbolIcon Symbol="@Icon.Check" />
                        </div>
                    }
                </Overlay>
            </TextBox>
        }
    </div>
}

@code {

    private string Title { get; set; } = string.Empty;
    private string Description { get; set; } = string.Empty;
    private string Value { get; set; } = string.Empty;



    [Parameter]
    public List<IDTO> Items { get; set; } = new();

    [Parameter]
    public IField Field { get; set; }

    [Parameter]
    public ValueBindingTyp Binding { get; set; } = ValueBindingTyp.Property;

    [Parameter]
    public IQueryContext Context { get; set; }

    [Parameter]
    public string CssClass { get; set; } = "  ";

    [Parameter]
    public string ControlStyle { get; set; } = " ";

    [Parameter]
    public bool Border { get; set; } = true;

    [Parameter]
    public bool ShowLabel { get; set; } = false;

    [Parameter]
    public string? Min { get; set; }

    [Parameter]
    public string? Max { get; set; }

    [Parameter]
    public string? Step { get; set; }

    [Parameter]
    public int Rows { get; set; } = 4;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public bool IsEditable { get; set; } = true;

    // Events
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        Title = Field.Title;
        Description = Field.Description;

        await Init();

        Value = onValueBinding();
    }

    // Methods
    public async Task Init()
    {
        this.Items = await Helper.InitDropDown(Field, sql);

        msg.OnMessage += OnMessageRun;
    }
    private string CheckCondition(IDTO? dto)
    {
        if(dto == null)
            return string.Empty;

        // Kein Condition angelegt
        if (Field.Condition == null)
            return string.Empty;

        // Kein Cnodition enthalten
        if (Field.Condition.Field == string.Empty
            || Field.Condition.Value == string.Empty)
            return string.Empty;

        string field = Field.Condition.Field;
        string fieldValue = dto[field].ToSecureString();
        string conditionValue = Field.Condition.Value.ToSecureString();
        string conditionTyp = this.Field.Condition.Typ;

        // Bedingungen enthalten 
        if (Field.Condition.Condition == "==")
        {
            if (fieldValue == conditionValue)
            {
                // Bedingung erfüllt
                return (conditionTyp == "Show" ? " " : " d-none ");
            }
        }
        if (Field.Condition.Condition == "!=")
        {
            if (fieldValue != conditionValue)
            {
                // Bedingung erfüllt
                return (conditionTyp == "Show" ? " " : " d-none ");
            }
        }

        return string.Empty;
    }

    // Helper
    private async Task<IDTO> Save()
    {
        // Update 
        await Context.Update(Context.Item);

        // ItemType Event
        IItemEventArgs args = new ItemEventArgs(Context.Item, null, sql, sec, app);
        Context.Item = await Context.ItemType.OnUpdateItem(args);

        // Update
        msg.Publish("", BusAction.Info, "Eintrag aktualisiert");

        if (Context.Item.ItemType == "User")
        {
            if (Context.Item.GUID == sec.User.GUID)
            {
                // User Neu laden
                await sec.RefreshUser();
            }
        }

        // Events 
        await ItemSaved.InvokeAsync(Context.Item);

        // andere EditBox aufgrund Update oder Condition aktualisieren
        msg.Publish("EditBox", BusAction.Refresh, Context.Item);

        return Context.Item;
    }
    private async Task<IDTO> Change()
    {
        // Events
        await ItemChanged.InvokeAsync(Context.Item);
        return Context.Item;
    }

    // SELECTION 
    private async Task SelectAssign(IDTO dto)
    {
        // Assign 
        IQueryResult assignResult = await sql.Assign(Context.Item, dto, Field.Association);
        msg.Publish("Info", BusAction.Info, "Zuordnung erfolgt");

    }
    private async Task SelectRemove(IDTO dto)
    {
        // Remove 
        IQueryResult assignResult = await sql.Remove(Context.Item, dto);
        msg.Publish("Info", BusAction.Info, "Eintrag entfernt");

    }

    // Events
    public async void OnMessageRun(AppMessage message)
    {
        if (message.Id == "EditBox" && message.Action == BusAction.Refresh)
        {
            Value = onValueBinding();

            await InvokeAsync(StateHasChanged);
        }
    }

    // ...
    private string onValueBinding()
    {
        if (Binding == ValueBindingTyp.Property)
        {
            string val = Context.Item[Field.Column].ToSecureString();

            if (Field.Typ == FieldTyp.Date)
            {
                val = val.ToDate();
            }
            else if (Field.Typ == FieldTyp.Time)
            {

            }
            else if (Field.Typ == FieldTyp.DateTime)
            {

            }

            return val;
        }
        else if (Binding == ValueBindingTyp.Description)
        {
            return Context.Item.Content.ToSecureString();
        }
        else
        {
            return Context.Item.Title.ToSecureString();
        }
    }
    private void onValueChanged(string value, string id = "")
    {
        if (Binding == ValueBindingTyp.Property)
        {
            if (!string.IsNullOrEmpty(value))
            {
                Context.Item[Field.Column] = value;
            }
            else if (!string.IsNullOrEmpty(id))
            {
                Context.Item[Field.Column] = id;
            }
        }
        else if (Binding == ValueBindingTyp.Description)
        {
            Context.Item.Content = value;
        }
        else
        {
            Context.Item.Title = value;
        }

    }

    [Parameter]
    public EventCallback<IDTO> ItemChanged { get; set; }

    [Parameter]
    public EventCallback<IDTO> ItemSaved { get; set; }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (Items != null)
            {
                Items.Clear();
                Items = null;
            }

            if (Field != null)
            {
                Field = null;
            }

            if (Context != null)
            {
                ((IDisposable)Context).Dispose();
                Context = null;
            }

            msg.OnMessage -= OnMessageRun;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : DISPOSE : BoardComp : " + ex.Message);
        }
    }
}