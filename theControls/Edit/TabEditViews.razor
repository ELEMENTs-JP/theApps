@if (ItemType != null)
{
    @if (Views.Count >= 1)
    {
        <TabsFrame Orientation=" Orientation.Center" Border="  " Icon=" "
                FrameCSS=" row g-0 w-100" Padding="" ShowAkzente="false">
            <HeaderContent>
                <TabsItem ID="@( "Default_View")" Title="@ItemType.Name" 
                        IsActive="true" Layout="TabsLayout.Buttons" />

                @foreach (IEditView view in Views)
                {
                    <TabsItem ID="@( "View_" + view.Name)" 
                                Title="@view.Title" Layout="TabsLayout.Buttons" />
                }

            </HeaderContent>
            <ChildContent>

                <TabsPanel ID="@( "Default_View")" IsActive="true" CSS="">

                    @Content
                   
                </TabsPanel>
                @foreach (IEditView view in Views)
                {
                    <TabsPanel ID="@( "View_" + view.Name)" CSS="">

                        <EditFields Context="@Context" Fields="@( GetFields(view).Result )" />

                    </TabsPanel>
                }

            </ChildContent>
        </TabsFrame>
    }
    @if (Views.Count == 0)
    {
        @Content
    }
}



@code {

    [Parameter]
    public IItemType ItemType { get; set; }

    List<IEditView> Views { get; set; } = new();

    [Parameter]
    public RenderFragment Content { get; set; }

    [Parameter]
    public IQueryContext Context { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (ItemType == null)
            return;

        Views = await ItemType.GetViews();

    }
    private async Task<List<IField>> GetFields(IEditView view)
    {
        List<IField> Fields = await ItemType.GetFields(view.Name);
        return Fields;
    }
}
