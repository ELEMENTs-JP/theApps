@using theControls.Chart
@using theControls.List
@inject ISqlDatabaseService sql
@inject ISecurityService sec
@inject IAppService appService
@inject ILocalizationService loc

@implements IAsyncDisposable


@if (ItemType != null && !string.IsNullOrEmpty(ID) && Context != null && Context.Item != null)
{
    <Frame Border="true" CSS="pt-2">
        <Icon>
            @if (ItemType.Typ == ItemTypeTyp.User)
            {
                <MinUserProfileImg Style="margin-top:6px;" User="@Context.Item" SizeStyle="height: 60px; width: 60px;" />
            }
        </Icon>
        <Header>
            <EditBox @key="@( "H1-" + Context.ID + "-" + Context.Item.GUID)"
                     Field="@TitleField" Binding="ValueBindingTyp.Title"
                     Context="@Context" Border="false" ControlStyle=" min-width:21rem; " />
            <div class="d-flex align-items-center" style="margin-left: 8px; margin-top: -8px;">

                @if (appService != null && appService.App != null)
                {
                    <a href="@("/app/" + appService.App.Name)" class="text-muted small" title="Application">
                        @appService.App.Name.ToSecureString()
                    </a>
                    <div class="vr"></div>
                }

                @if (Context != null && Context.ItemType != null)
                {
                    <a href="@( Helper.LibraryUrl(Context.ItemType.Name, Context.ItemType.Typ) )" class="text-muted small" title="ItemType">
                        @Context.ItemType.Name.ToSecureString()
                    </a>
                    <div class="vr"></div>
                    <small class="text-muted small px-2 no-select">Typ: @Context.ItemType.Typ.ToSecureString()</small>
                }

                @if (Context != null && Context.Item != null)
                {
                    <div class="vr"></div>
                    <small class="text-muted small px-2 no-select">ID: @Context.Item.ID.ToSecureString()</small>
                }

                @if (RelatedItems != null && RelatedItems.Count > 0)
                {
                    <div class="vr"></div>
                    <AllRelatedItemsPopup Items="@RelatedItems" />
                }
                    
            </div>
        </Header>
        <Related>
            <ContextMenu Context="@Context" ItemType="@ItemType" CSS="me-3" 
                ItemDeleted="@( async e => { await ItemDeleted.InvokeAsync(e);  } )" />
            @if (Context.ItemType.Name == "User")
            {
                <SetPasswordComp Item="@Context.Item" Mode="ModalRenderMode.Modal" />
            }
        </Related>
        <Content>
            
            <ProgressRangeKPI Item="@Context.Item" ItemType="@ItemType" />

            <div class="row g-0">
                @foreach (IField field in Fields)
                {
                    @if (field.Typ == FieldTyp.HR)
                    {
                        <div class="hr-text px-3">@field.Title</div>
                    }
                    else
                    {
                        <div class="@( field.CSS + " p-2 " )">
                            <EditBox @key="@( "EditBox-" + Context.ID + "-" + field.Column + "-" + Context.Item.GUID)"
                                     Field="@field" Context="@Context"
                                     IsEditable="@field.IsEditable" Border="false" />
                        </div>
                    }
                }
            </div>
        </Content>
        <Bottom>

            @if (hasUpdatePermission == false)
            {
                <div class="d-inline-flex align-items-center">
                  <div class="bg-danger rounded-circle me-2" style="width: 12px; height: 12px; border:1px solid #fff; flex-shrink: 0;"></div>
                  <small class="text-muted small">
                        @loc.GetLabel("Berechtigungen aktiv (Bearbeitung)", "Permissions active (Editing)")
                  </small>
                </div>
            }

        </Bottom>
    
    </Frame>

}


@code {

    [Parameter]
    public IItemType ItemType { get; set; } // Injectiopn

    [Parameter]
    public string ID { get; set; } // Injectiopn

    IQueryContext Context { get; set; }
    IField TitleField { get; set; }
    List<IField> Fields { get; set; } = new();

    private List<IDTO> RelatedItems { get; set; } = new();
    bool hasUpdatePermission { get; set; } = true;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (ItemType == null)
            return;
             
        // Field 
        TitleField = new Factory(sql).BuildField(FieldTyp.Heading);
        Fields = await ItemType.GetFields();
        Fields = Fields.Where(se => se.OnDisplay.Edit == true).ToList();

        // Context 
        Context = new QueryContext(sql, sec);
        Context.ItemType = ItemType;
        await Context.Load(ID);

        // Permission 
        hasUpdatePermission = await sec.HasItemTypePermission(Context.ItemType, SecurityFunction.Update);

        await ValidateParents();
    }

    [Parameter]
    public EventCallback<string> ItemDeleted { get; set; }

    private async Task ValidateParents()
    {
        if (ItemType == null)
            return;

        if (Context == null)
            return;

        IQueryParameter query = new QueryParameter();
        query.MasterGUID = SQLiteService.GeneralMasterGUID;
        query.ItemType = ItemType.Name;
        IQueryResult result = await sql.GetRelatedItems(Context.Item, "", AssociationTyp.NULL);
        RelatedItems = result.Items;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            ItemType = null;

            if (Context != null)
            {
                ((IDisposable)Context).Dispose();
                Context = null;
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : DISPOSE : BoardComp : " + ex.Message);
        }
    }

}
