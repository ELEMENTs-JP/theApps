@using theControls.Modal
@using theControls.Pages
@using theInfrastructure

@if (ItemType != null && Context != null && Context.Item != null)
{
    <div class="border rounded-2 p-2">

        <div class="row g-0 px-2 border-bottom">
            <div class="col p-2">
                <EditBox Field="@( new FieldBuilder().BuildField(FieldTyp.Heading) )" 
                        Binding="ValueBindingTyp.Title" Context="@Context" Border="false" />
            </div>
            <div class="col-auto p-2">
                <ContextMenu Context="@Context" ItemType="@ItemType" />
            </div>
            <div class="col-12 px-3 pb-2" style="margin-top:-18px;">
                <small class="text-muted small">@Context.ItemType.Name</small>
            </div>
        </div>

        <div class="row g-0">

            @foreach (IField field in ItemType.Fields)
            {
                @if (field.Typ == FieldTyp.HR)
                {
                    <div class="hr-text px-3">@field.Title</div>    
                }
                else
                {
                    <div class="@( field.CSS + " p-2 " )">
                        <EditBox Field="@field" Context="@Context" 
                                IsEditable="@field.IsEditable" Border="false" />
                    </div>
                }
            }
        </div>

    </div>
}




@code {

    [Parameter]
    public IItemType ItemType { get; set; } // Injectiopn

    [Parameter]
    public IQueryContext Context { get; set; } // Injection

  
}
