@inherits BaseCtl

@if (Item != null)
{
    <div class="rounded-2 hover pointer p-05" data-bs-toggle="offcanvas" data-bs-target="@( "#" + ID )"
         aria-controls="@( ID )">
        <i class="bi bi-pencil-square text-muted"></i>
    </div>

    <div class="offcanvas offcanvas-end" tabindex="-1"
         id="@( ID )" aria-labelledby="offcanvasRightLabel">
        <div class="offcanvas-header">
   
            <EditBox @key="@( "H1-" + Context.ID + "-" + Context.Item.GUID)"
                     Field="@TitleField" Binding="ValueBindingTyp.Title"
                     Context="@Context" Border="false" ControlStyle=" min-width:15rem; " />

            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            
            <div class="row g-0">
                @foreach (IField field in Fields)
                {
                    @if (field.Typ == FieldTyp.HR)
                    {
                        <div class="hr-text px-3">@field.Title</div>
                    }
                    else
                    {
                        <div class="@( " col-12 p-2 " )">
                            <EditBox @key="@( "EditBox-" + Context.ID + "-" + field.Column + "-" + Context.Item.GUID)"
                                     Field="@field" Context="@Context"
                                     IsEditable="@field.IsEditable" Border="false" />
                        </div>
                    }
                }
            </div>

        </div>
    </div>
}



@code {

    private string ID { get; set; } = "Canvas_Edit_" + Guid.NewGuid();

    [Parameter]
    public IDTO Item { get; set; }

    IQueryContext Context { get; set; }
    IField TitleField { get; set; }
    List<IField> Fields { get; set; } = new();
    bool hasUpdatePermission { get; set; } = true;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        IItemType it = await new Factory(sql).BuildItemType(Item.ItemType);

        // Field 
        TitleField = new Factory(sql).BuildField(FieldTyp.Heading);
        Fields = await it.GetFields();
        Fields = Fields.Where(se => se.OnDisplay.Edit == true).ToList();

        // Context
        Context = new QueryContext(sql, sec);
        Context.ItemType = it;
        Context.Item = Item;

        // Permission
        hasUpdatePermission = await sec.HasItemTypePermission(Context.ItemType, SecurityFunction.Update);

    }

}
