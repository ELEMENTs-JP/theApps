@using Markdig
@inject HttpClient client
@implements IDisposable
@implements IAsyncDisposable
@inherits BaseCtl

<style>
    pre {
        background-color: #f1f1f1;
        padding: 10px;
        border-radius: 5px;
        overflow-x: auto;
        color: #222;
    }
</style>

@if (gs != null)
{
    <div class="rounded-2 hover pointer p-2" data-bs-toggle="offcanvas" data-bs-target="@("#" + ID)"
         aria-controls="@(ID)">
        <i class="bi bi-stars"></i>
    </div>

    <div class="offcanvas offcanvas-end" tabindex="-1"
         id="@(ID)" aria-labelledby="offcanvasRightLabel"
         style="--tblr-offcanvas-width: 720px !important;">
        <div class="offcanvas-header">
            <h1 class="h1">Groq</h1>
            <div class="hover pointer rounded p-1 px-1" data-bs-dismiss="offcanvas" aria-label="Close">
                <i class="bi bi-x-lg"></i>
            </div>
        </div>
        <div class="offcanvas-body">
            <div class="input-group">
                <input @bind="_currentInput" @onkeyup="OnKeyUp" class="form-control"
                       placeholder="Deine Nachricht..." disabled="@_isThinking" />
                <div class="p-3 pointer hover rounded-2 ms-3" @onclick="Send" disabled="@_isThinking">
                    @if (_isThinking)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <i class="bi bi-send"></i>
                    }
                </div>
            </div>

            <div class="border-bottom my-3"></div>

            <div id="chatbox" class="overflow-auto my-2">
                @if (_isThinking)
                {
                    <div class="text-muted small ms-2 animate-pulse mb-2">Groq denkt nach...</div>
                }
                @foreach (var msg in _messages.AsEnumerable().Reverse())
                {
                    <div class="d-flex mb-3 @(msg.Role == "user" ? "justify-content-end" : "justify-content-start")">
                        <div class="p-2 border @(msg.Role == "user" ? "rounded-start rounded-top bg-surface-secondary" : "rounded-end rounded-top")"
                             style="max-width: 80%; line-height: 1.5;">
                            <small class="d-block fw-bold text-muted opacity-75">@(msg.Role == "user" ? sec.User.Title : "Groq")</small>

                            @if (msg.Role == "user")
                            {
                                <div class="p-1">
                                    @((MarkupString)ConfigureInput(msg.Text).MarkdownToHtml())
                                </div>
                            }
                            else
                            {
                                var messageId = $"msg-{Guid.NewGuid()}";

                                <div id="@messageId" class="hover pointer rounded p-1 px-1"
                                     @onclick="() => CopyContent(messageId)">
                                    @((MarkupString)msg.Text.MarkdownToHtml())
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<script>
    window.copyElementTextById = function (id) {
        const element = document.getElementById(id);
        if (element) {
            const text = element.innerText;
            navigator.clipboard.writeText(text);
        }
    };
</script>

@code {
    private string ID { get; set; } = "Groq_" + Guid.NewGuid().ToString();

    private GroqService gs;
    private List<ChatMessage> _messages = new();
    private string _currentInput = "";
    private bool _isThinking = false;

    private string Anweisungen { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        try
        {
            IDTO user = sec.User;
            if (user != null)
            {
                string Groq_API_Key = appService.KIConfiguration.GroqApiKey.ToSecureString();
                Anweisungen = appService.KIConfiguration.GroqAnweisungen.ToSecureString();

                if (!string.IsNullOrEmpty(Groq_API_Key))
                {
                    gs = new GroqService(client, Groq_API_Key);
                }
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL Init: " + ex.Message);
        }
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(_currentInput) || _isThinking)
            return;

        if (!string.IsNullOrEmpty(Anweisungen))
        {
            _currentInput = _currentInput + " " + Anweisungen;
        }

        var userMsg = new ChatMessage { Role = "user", Text = _currentInput };
        _messages.Add(userMsg);

        _currentInput = "";
        _isThinking = true;

        var response = await gs.GetResponseAsync(_messages);

        _messages.Add(new ChatMessage { Role = "assistant", Text = response });
        _isThinking = false;

        await JS.InvokeVoidAsync("eval", "setTimeout(() => { document.getElementById('chatbox').scrollTop = document.getElementById('chatbox').scrollHeight; }, 50);");
    }

    private async Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Send();
    }

    private string ConfigureInput(string input)
    {
        if (input.Contains(Anweisungen))
        {
            input = input.Replace(Anweisungen, string.Empty);
        }

        input = input + "<div class='border-top py-1 text-muted' />" + Anweisungen;
        return input;
    }

    private async Task CopyContent(string elementId)
    {
        await JS.InvokeVoidAsync("copyElementTextById", elementId);
    }

    public void Dispose()
    {
        try
        { GC.Collect(); }
        catch { }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            GC.Collect();
            await Task.FromResult("Done");
        }
        catch (Exception ex)
        {
            Console.WriteLine("FAIL: " + ex.Message);
        }
    }
}