@inherits BaseCtl



<div class="border-bottom pb-2 mb-2">
    <h1 class="h1 w-100">KI Einstellungen</h1>
</div>

<div class="row">
    <div class="col-12 col-lg-4 px-2">
        <CheckBox Label="Gemini aktivieren"
                  Value="@appService.KIConfiguration.IsGeminiActive.ToSecureString()"
                  ValueChanged="@(e =>  {
                      appService.KIConfiguration.IsGeminiActive = e.ToSecureBool();
                      appService.KIConfiguration.Save();  })" />
    </div>
    <div class="col-12 col-lg-4 px-2">
        <TextBox Label="Gemini Key"
                 Value="@appService.KIConfiguration.GeminiApiKey"
                 ValueChanged="@(e =>  {
                     appService.KIConfiguration.GeminiApiKey = e;
                     appService.KIConfiguration.Save(); })" />
    </div>
    <div class="col-12 col-lg-4 px-2">
        <TextBox Label="Gemini Anweisungen"
                 Value="@appService.KIConfiguration.GeminiAnweisungen"
                 ValueChanged="@(e =>  {
                     appService.KIConfiguration.GeminiAnweisungen = e;
                     appService.KIConfiguration.Save(); })" />
    </div>
</div>

