<div class="col border-end position-relative" style="height: 1440px;">

    <!-- Hintergrund-Zeitraster (24 Stunden x 60px = 1440px) -->
    <div class="h-100">
        @for (int hour = 0; hour < 24; hour++)
        {
            <div class="border-bottom" style="height: 60px; box-sizing: border-box;"></div>
        }
    </div>

    <!-- Aktuelle Uhrzeit-Linie (nur am heutigen Tag sichtbar) -->
    @if (Day.Date == DateTime.Today)
    {
        int topOffset = (DateTime.Now.Hour * 60) + DateTime.Now.Minute;
        <div class="position-absolute start-0 w-100 d-flex align-items-center"
             style="top: @(topOffset)px; z-index: 20; pointer-events: none;">
            <div class="bg-secondary rounded-circle" style="width: 8px; height: 8px; margin-left: -4px;"></div>
            <div class="border-top border-secondary border-2 w-100"></div>
        </div>
    }

    <!-- Termine-Overlay -->
    <div class="position-absolute top-0 start-0 w-100 h-100 d-grid grid-96-rows bg-worktime"
         style="display: grid !important; @((IsWeekend() ? "--start-hour: 0; --end-hour: 0;" : "--start-hour: 8; --end-hour: 17;"))">
        @foreach (var entry in RenderEvents)
        {
            <CalendarWeekDayAppointment Item="@entry.Item"
                                        RowStart="@entry.RowStart"
                                        RowSpan="@entry.RowSpan"
                                        ColumnIndex="@entry.ColumnIndex"
                                        MaxColumns="@entry.MaxColumns"
                                        StartTime="@entry.Start"
                                        EndTime="@entry.End" />
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public DateTime Day { get; set; }

    [Parameter, EditorRequired]
    public List<IDTO> Items { get; set; } = new();

    private const int MinutesPerSlot = 15;
    private const int SlotsPerHour = 60 / MinutesPerSlot;

    // Lokale Hilfsklasse für die Berechnungsphase innerhalb der Methode
    private class CalculatedLayout
    {
        public IDTO Item { get; set; } = default!;
        public TimeSpan Start { get; set; }
        public TimeSpan End { get; set; }
        public int RowStart { get; set; }
        public int RowSpan { get; set; }
        public int ColumnIndex { get; set; }
        public int MaxColumns { get; set; }
    }

    private List<CalculatedLayout> RenderEvents => CalculateRenderItems();

    private List<CalculatedLayout> CalculateRenderItems()
    {
        if (Items == null || !Items.Any())
            return new();

        var parsedEvents = Items.Select(ev =>
        {
            TimeSpan.TryParse(ev["Start"], out var start);
            TimeSpan.TryParse(ev["Ende"], out var end);
            return new
            {
                Item = ev,
                Start = start,
                End = end
            };
        })
        .OrderBy(e => e.Start)
        .ThenByDescending(e => e.End)
        .ToList();

        var renderItems = new List<CalculatedLayout>();

        // 1. Grid-Zeilen berechnen (RowStart & RowSpan)
        foreach (var ev in parsedEvents)
        {
            int startSlot = (ev.Start.Hours * SlotsPerHour) + (ev.Start.Minutes / MinutesPerSlot) + 1;
            int totalMinutes = (int)(ev.End - ev.Start).TotalMinutes;
            int spanSlots = Math.Max(1, totalMinutes / MinutesPerSlot);

            renderItems.Add(new CalculatedLayout
            {
                Item = ev.Item,
                Start = ev.Start,
                End = ev.End,
                RowStart = startSlot,
                RowSpan = spanSlots
            });
        }

        // 2. Überschneidungsgruppen bilden
        var groups = new List<List<CalculatedLayout>>();
        foreach (var item in renderItems)
        {
            var added = false;
            foreach (var group in groups)
            {
                if (group.Any(g => Overlaps(g, item)))
                {
                    group.Add(item);
                    added = true;
                    break;
                }
            }
            if (!added)
            {
                groups.Add(new List<CalculatedLayout> { item });
            }
        }

        // 3. Spalten-Index und maximale Spalten pro Gruppe berechnen
        foreach (var group in groups)
        {
            var columns = new List<List<CalculatedLayout>>();
            foreach (var item in group)
            {
                int placedColumn = -1;
                for (int i = 0; i < columns.Count; i++)
                {
                    if (!columns[i].Any(c => Overlaps(c, item)))
                    {
                        columns[i].Add(item);
                        placedColumn = i;
                        break;
                    }
                }
                if (placedColumn == -1)
                {
                    columns.Add(new List<CalculatedLayout> { item });
                    placedColumn = columns.Count - 1;
                }
                item.ColumnIndex = placedColumn;
            }

            int maxCols = columns.Count;
            foreach (var item in group)
            {
                item.MaxColumns = maxCols;
            }
        }

        return renderItems;
    }

    private static bool Overlaps(CalculatedLayout a, CalculatedLayout b)
    {
        int aEnd = a.RowStart + a.RowSpan;
        int bEnd = b.RowStart + b.RowSpan;
        return a.RowStart < bEnd && b.RowStart < aEnd;
    }

    private bool IsWeekend()
    {
        if (Day.DayOfWeek == DayOfWeek.Saturday || Day.DayOfWeek == DayOfWeek.Sunday)
            return true;

        return false;
    }
}