@using System.Globalization
@inject IJSRuntime js
@inherits BaseList


<div class="row d-flex align-items-center p-2">

    <div class="col-auto">
        <div class="hover pointer rounded-2 p-1" @onclick="PreWeek">
            <i class="ti ti-chevron-left text-muted"></i>
        </div>
    </div>

    <div class="col-auto px-2">
        <strong class="fw-bold">
            KW @ISOWeek.GetWeekOfYear(CurrentDate.Date) - @(CurrentDate.Date.ToString("MMMM", CultureInfo.CurrentCulture)) @CurrentDate.Date.Year.ToSecureString()
        </strong>
    </div>
    <div class="col-auto">
        <div class="hover pointer rounded-2 p-1" @onclick="NextWeek">
            <i class="ti ti-chevron-right text-muted"></i>
        </div>
    </div>
    @if (ISOWeek.GetWeekOfYear(DateTime.Today) != ISOWeek.GetWeekOfYear(CurrentDate.Date) ||
        ISOWeek.GetYear(DateTime.Today) != ISOWeek.GetYear(CurrentDate.Date))
    {
        <div class="col-auto px-2">
            <div class="hover pointer rounded-2 p-1"
                 @onclick="SetToday">
                <small class="text-muted">Heute</small>
            </div>
        </div>
    }

    @if (RelatedContent.HasContent())
    {
        @RelatedContent
    }

    <div class="col-auto ms-auto px-2">
        @*      <AddArea ItemType="@ItemType" /> *@
    </div>
</div>

<div id="@Id"  class="border overflow-auto" style="height: 720px;">
    <div class="container-fluid p-0">
        <div class="row g-0 border-bottom bg-surface sticky-top" style="z-index: 10;">
            <div class="col-auto text-end pe-2 fw-bold text-muted border-end" style="width: 60px;"></div>
            @foreach (var day in DatesInWeek)
            {
                <div class="col p-2 border-end ">
                    <div class="d-inline-flex rounded align-items-center @(day.Date == DateTime.Today ? "bg-light text-dark fw-bold" : "")">
                        <div class="fw-bold px-1">@day.ToString("ddd", CultureInfo.CurrentCulture)</div>
                        <div class="fs-5 px-1">@day.Day</div>
                    </div>
                </div>
            }
        </div>

        <div class="row g-0 position-relative">

            <div class="col-auto border-end d-grid grid-96-rows position-relative" style="width: 60px; height: 1440px; display: grid !important;">
                @for (int hour = 0; hour < 24; hour++)
                {
                    int gridRow = (hour * 4) + 1;
                    <div class="text-end pe-2 text-muted small position-relative"
                         style="grid-row: @gridRow; top: -7px;">
                        @($"{hour:D2}:00")
                    </div>
                }
            </div>

            @foreach (var day in DatesInWeek)
            {
                <CalendarWeekDayComp Day="day"
                                     Items="@Items.Where(se => se["Date"].ToSecureDateTime().Date == day.Date).ToList()" />
            }
        </div>
    </div>
</div>

@code {


    private string Id { get; set; } = $"scrollable-div-{Guid.NewGuid():N}";

    [Parameter]
    public RenderFragment RelatedContent { get; set; }

    [Parameter]
    public DateTime CurrentDate { get; set; } = DateTime.Today.AddDays(-(int)DateTime.Today.DayOfWeek + 1);

    [Parameter]
    public List<IDTO> Items { get; set; } = new();

    List<DateTime> DatesInWeek { get; set; } = new();

    string ShowWeekend { get; set; } = "true";
    int weekDaysRange = 7;

    protected override void OnInitialized()
    {
        // GenerateTestData();
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        ShowWeekend = await Helper.GetSettingValue(sql, "ShowWeekend", ItemType.Name);
        weekDaysRange = (ShowWeekend == "true" ? 7 : 5);

        DatesInWeek = Enumerable.Range(0, weekDaysRange).Select(i => CurrentDate.Date.AddDays(i)).ToList();
        
        if (Context != null && Context.Items != null)
        {
            Items = Context.Items;

        }
    }

 
    [Parameter]
    public EventCallback<DateTime> OnNextMonth { get; set; }
    [Parameter]
    public EventCallback<DateTime> OnSetToday { get; set; }
    [Parameter]
    public EventCallback<DateTime> OnPreMonth { get; set; }

    private async Task NextWeek()
    {
        CurrentDate = CurrentDate.AddDays(7);
        DatesInWeek = Enumerable.Range(0, weekDaysRange).Select(i => CurrentDate.Date.AddDays(i)).ToList();
        await OnNextMonth.InvokeAsync(CurrentDate);
    }

    private async Task PreWeek()
    {
        CurrentDate = CurrentDate.AddDays(-7);
        DatesInWeek = Enumerable.Range(0, weekDaysRange).Select(i => CurrentDate.Date.AddDays(i)).ToList();
        await OnPreMonth.InvokeAsync(CurrentDate);
    }

    private async Task SetToday()
    {
        CurrentDate = DateTime.Now.Date;
        DatesInWeek = Enumerable.Range(0, weekDaysRange).Select(i => CurrentDate.Date.AddDays(i)).ToList();
        await OnSetToday.InvokeAsync(CurrentDate);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Beispiel: Scrollt den Container beim initialen Rendern auf 400px Höhe
            await ScrollToPositionAsync(380);
        }
    }

    public async Task ScrollToPositionAsync(int pixelFromTop)
    {
        await js.InvokeVoidAsync("scrollToById", Id, pixelFromTop);
    }
}