@inject IAppService app
@inject NavigationManager nm
@inject ISqlDatabaseService sql
@inject IMessagingBusService msg

<div class="d-flex position-relative">

  

    @if (CurrentDate.ToYearMonth() == Date.ToYearMonth())
    {
        if (Date.Date.DayOfWeek == DayOfWeek.Saturday ||
            Date.Date.DayOfWeek == DayOfWeek.Sunday)
        {
            <div class="@( (Date.Date == DateTime.Now.Date) ? "badge text-bg-light mb-1" : "mb-1" )">@Date.Day.ToSecureString()</div>
        }
        else
        {
            if (Date.Date.Day == 1)
            {
                <strong class="@( (Date.Date == DateTime.Now.Date) ? "badge text-bg-light mb-1" : "mb-1" )">@Date.ToString("dd. MMM")</strong>
            }
            else
            {
                <strong class="@( (Date.Date == DateTime.Now.Date) ? "badge text-bg-light mb-1" : "mb-1" )">@Date.Day.ToSecureString()</strong>
            }
        }
    }
    else
    {
        if (Date.Date.Day == 1)
        {
            <div class="mb-1 text-muted" style="opacity:0.5;">@Date.ToString("dd. MMM")</div>
        }
        else
        {
            <div class="mb-1 text-muted" style="opacity:0.5;">@Date.Day.ToSecureString()</div>
        }
    }

    

    @*  <tpt.Controls.v2.Collection.AddItem Title="@( "Eintrag hinzufügen" )"
                                        ButtonTitle="+" ItemType="@this.ItemType.Name"
                                        FieldHeader="Bezeichnung"
                                        ButtonGroupCSS=" in ms-auto "
                                        ButtonTitleCSS="@( "text-muted hover rounded-2 pointer px-2" )"
                                        DefaultDate="@( Date )"
                                        OnOKClicked="@( e => { ItemAdded(e); })" /> *@
</div>

<div class="overflow-auto position-relative" style="height:108px;">

    @if (!string.IsNullOrEmpty(DateColumn))
    {
        @foreach (IDTO dto in Items)
        {
            <div class="bg-secondary py-1 px-2 mb-1 rounded-1">
                <div class="row g-0 align-items-center out">
                    <div class="col fw-bold pointer">
                        <small class="text-truncate-line"
                               @onclick="@( e => { nm.NavigateTo(Helper.GetItemUrl(dto)); })">
                            @dto.Title.ToSecureString()
                        </small>
                    </div>

                    @if (dto[DateColumn].ToSecureString().ToSecureDateTime().ToString("HH:mm") != "00:00")
                    {
                        <div class="col-auto ps-2 fw-normal">
                            <small>
                                @dto[DateColumn].ToSecureString().ToSecureDateTime().ToString("HH:mm")
                            </small>
                        </div>
                    }

                    <div class="col-auto ps-1 hover">
                        <div class="pointer rounded-2"
                             @onclick="@( e => { ItemDelete(dto); })">
                            <SymbolIcon Symbol="Icon.Delete" />
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    @if (Date.Date.DayOfWeek == DayOfWeek.Monday)
    {
        <small class="position-absolute bottom-0 start-0 p-1 text-muted">
            W:@Date.Date.WeekOfYear()
        </small>
    }
</div>


@code {

    [Parameter]
    public DateTime Date { get; set; } = DateTime.Now.Date;

    [Parameter]
    public IItemType ItemType { get; set; }

    private DateTime CurrentDate { get; set; } = DateTime.Now.Date;

    private string DateColumn = string.Empty;

    [Parameter]
    public List<IDTO> Items { get; set; } = new();

    [Parameter]
    public IQueryContext Context { get; set; }


    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        LoadItems();

    }
    private async void LoadItems()
    {

        DateColumn = await this.ItemType.GetRelevantPropertyName(RelevantPropertyType.Date);

        // Filter
        if (!string.IsNullOrEmpty(DateColumn))
        {
            Items = Context.Items.Where(se => se[DateColumn].ToSecureString().ToSecureDateTime().Date == Date.Date).ToList();
        }
    }

    [Parameter]
    public EventCallback<IDTO> OnItemAdded { get; set; }

    private async Task ItemAdded(IDTO dto)
    {
        try
        {
            if (dto == null)
                return;

            // Store.Add(dto);

            LoadItems();

            await OnItemAdded.InvokeAsync(dto);
        }
        catch (Exception ex)
        {

        }
    }

    [Parameter]
    public EventCallback<IDTO> OnItemDeleted { get; set; }

    private async Task ItemDelete(IDTO dto)
    {
        try
        {
            if (dto == null)
                return;

        
            await Context.Delete(dto);
            msg.Publish("", BusAction.Refresh);
            msg.Publish("", BusAction.Info, "Item wurde gelöscht");
            await OnItemDeleted.InvokeAsync(dto);

        }
        catch (Exception ex)
        {

        }
    }
}
