@using System.Globalization
@inherits BaseList

<div class="row d-flex align-items-center p-2">

    <div class="col-auto">
        <div class="hover pointer rounded-2 p-1" @onclick="Pre">
            <i class="ti ti-chevron-left text-muted"></i>
        </div>
    </div>

    <div class="col-auto px-2">
        <strong class="fw-bold">
            @(CurrentDate.Date.ToString("dddd, d. MMMM yyyy", CultureInfo.CurrentCulture))
        </strong>
    </div>

    <div class="col-auto">
        <div class="hover pointer rounded-2 p-1" @onclick="Next">
            <i class="ti ti-chevron-right text-muted"></i>
        </div>
    </div>

    @if (DateTime.Today != CurrentDate.Date)
    {
        <div class="col-auto px-2">
            <div class="hover pointer rounded-2 p-1" @onclick="SetToday">
                <small class="text-muted">Heute</small>
            </div>
        </div>
    }

    @if (RelatedContent.HasContent())
    {
        @RelatedContent
    }

    <div class="col-auto ms-auto px-2">
        @* <AddArea ItemType="@ItemType" /> *@
    </div>
</div>

@if (Context != null && Context.Items != null)
{
    <div class="border overflow-auto" style="height: 720px;">
        <div class="row g-0 border-bottom bg-surface sticky-top" style="z-index: 10;">
            <div class="col-auto text-end pe-2 fw-bold text-muted border-end" style="width: 60px;"></div>

            <div class="col p-2 border-end ">
                <div class="d-inline-flex rounded align-items-center @(CurrentDate.Date == DateTime.Today ? "bg-light text-dark fw-bold" : "")">
                    <div class="fw-bold px-1">@CurrentDate.ToString("ddd", CultureInfo.CurrentCulture)</div>
                    <div class="fs-5 px-1">@CurrentDate.Day</div>
                </div>
            </div>

        </div>

        <div class="row g-0 position-relative">

            <div class="col-auto border-end d-grid grid-96-rows position-relative"
                 style="width: 60px; height: 1440px; display: grid !important;">
                @for (int hour = 0; hour < 24; hour++)
                {
                    int gridRow = (hour * 4) + 1;
                    <div class="text-end pe-2 text-muted small position-relative"
                         style="grid-row: @gridRow; top: -7px;">
                        @($"{hour:D2}:00")
                    </div>
                }
            </div>

            <CalendarWeekDayComp Day="CurrentDate"
                                 Items="@Items.Where(se => se["Date"].ToSecureDateTime().Date == CurrentDate.Date).ToList()" />
        </div>
    </div>
}

@code {

    [Parameter]
    public RenderFragment RelatedContent { get; set; }

    [Parameter]
    public DateTime CurrentDate { get; set; } = DateTime.Today;

    [Parameter]
    public List<IDTO> Items { get; set; } = new();

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (Context != null && Context.Items != null)
        {
            Items = Context.Items;
        }
    }

    [Parameter]
    public EventCallback<DateTime> OnNextMonth { get; set; }

    [Parameter]
    public EventCallback<DateTime> OnSetToday { get; set; }

    [Parameter]
    public EventCallback<DateTime> OnPreMonth { get; set; }

    private async Task Next()
    {
        CurrentDate = CurrentDate.AddDays(1);
        await OnNextMonth.InvokeAsync(CurrentDate);
    }

    private async Task Pre()
    {
        CurrentDate = CurrentDate.AddDays(-1);
        await OnPreMonth.InvokeAsync(CurrentDate);
    }

    private async Task SetToday()
    {
        CurrentDate = DateTime.Today;
        await OnSetToday.InvokeAsync(CurrentDate);
    }
}