@using theControls.Icons
@using theControls.Input
@inject ISqlDatabaseService sql


@if (Field != null)
{
    <div class="@( ((Border == true) ? " border " : "")) rounded-2 p-2 @CssClass ">

        @if (Field.Typ == FieldTyp.TextArea)
        {
            <TextArea Label="@Field.Title"
                      Description="@Field.Description"
                      Value="@( string.Empty )"
                      ValueChanged="@(async e => {  Value = e;  await ValueChanged.InvokeAsync(e);})"
                      Placeholder="@Field.Placeholder"
                      CssClass="@CssClass"
                      Rows="@Rows">
            </TextArea>
        }
        else if (Field.Typ == FieldTyp.DropDown ||
                 Field.Typ == FieldTyp.User ||
                 Field.Typ == FieldTyp.FieldTyp ||
                 Field.Typ == FieldTyp.ItemTypeTyp ||
                 Field.Typ == FieldTyp.Priority ||
                 Field.Typ == FieldTyp.Status ||
                 Field.Typ == FieldTyp.Progress)
        {
            <DropDown Label="@Field.Title"
                    Description="@Field.Description"
                    Items="@Items"
                    Value="@( string.Empty )"
                    ValueChanged="@(async e => { Value = e; await ValueChanged.InvokeAsync(e); })"
                    Placeholder="@Field.Placeholder"
                    CssClass="@CssClass">
            </DropDown>
        }
        else if (Field.Typ == FieldTyp.CheckBox)
        {
            <CheckBox Label="@Field.Title"
                      Description="@Field.Description"
                      Value="@( string.Empty )"
                      ValueChanged="@(async e => { Value = e; await ValueChanged.InvokeAsync(e); })"
                      CssClass="@CssClass" />
        }
        else if (Field.Typ == FieldTyp.Heading)
        {
            <Heading Label="@Field.Title" ShowLabel="false"
                     Description="@Field.Description"
                     Value="@( string.Empty )"
                     ValueChanged="@(async e =>{ Value = e; await ValueChanged.InvokeAsync(e); })"
                     CssClass="@CssClass">
 
            </Heading>
        }
        else
        {
            <TextBox Label="@Field.Title"
                     Description="@Field.Description"
                     Value="@( string.Empty )"
                     ValueChanged="@(async e =>{ Value = e; await ValueChanged.InvokeAsync(e); })"
                     Type="@Field.Typ"
                     Placeholder="@Field.Placeholder"
                     CssClass="@CssClass"
                     Min="@Min" Max="@Max" Step="@Step">
            </TextBox>
        }
    </div>

}

@code {

    [Parameter]
    public List<IDTO> Items { get; set; } = new();

    [Parameter]
    public IField Field { get; set; }

    [Parameter]
    public ValueBindingTyp Binding { get; set; } = ValueBindingTyp.Property;

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public string CssClass { get; set; } = " bg-body ";

    [Parameter]
    public bool Border { get; set; } = true;

    [Parameter]
    public bool ShowLabel { get; set; } = false;

    [Parameter]
    public string? Min { get; set; }

    [Parameter]
    public string? Max { get; set; }

    [Parameter]
    public string? Step { get; set; }
    [Parameter]
    public int Rows { get; set; } = 4;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await Init();
    }

       // Methods 
    public async Task Init()
    {
        this.Items = await Helper.InitDropDown(Field, sql);
    }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }


}