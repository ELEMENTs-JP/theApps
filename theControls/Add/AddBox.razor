@using theControls.Essentials
@using theControls.Icons
@using theControls.Input
@inject ISqlDatabaseService sql


@if (Field != null)
{
    <div class="@( ((Border == true) ? " border " : "")) rounded-2 p-2 @CssClass ">

        @if (Field.Typ == FieldTyp.TextArea)
        {
            <TextArea Label="@Field.Title"
                      Description="@Field.Description"
                      Value="@( DefaultText )"
                      ValueChanged="@(async e => {  Value = e;  await ValueChanged.InvokeAsync(e);})"
                      Placeholder="@Field.Placeholder"
                      CssClass="@CssClass"
                      Rows="@Rows">
            </TextArea>
        }
        else if (Field.Typ == FieldTyp.Select)
        {
            <Selection @key="@( "Select-" + ID + "-" + Field.Title)"
                       Label="@Field.Title" Description="@Field.Description" Value="@Value"
                       Item="@( new DTO() )" ItemType="@Field.ItemType"
                       Association="@Field.Association"
                       ItemAssigned="@(async e =>{   })"
                       ItemRemoved="@(async e =>{  })"
                       ItemChanged="@(async e =>{  })"
                       ItemsChanged="@(async e =>{ await ItemsChanged.InvokeAsync(e); })"
                       Placeholder="@Field.Placeholder"
                       CssClass="@CssClass"
                       IsEditable="@true">
            </Selection>
        }
        else if (Field.Typ == FieldTyp.DropDown ||
                 Field.Typ == FieldTyp.User ||
                 Field.Typ == FieldTyp.FieldTyp ||
                 Field.Typ == FieldTyp.ItemTypeTyp ||
                 Field.Typ == FieldTyp.Priority ||
                 Field.Typ == FieldTyp.Status ||
                 Field.Typ == FieldTyp.Progress)
        {
            <DropDown Label="@Field.Title"
                    Description="@Field.Description"
                    Items="@Items"
                      Value="@DefaultText"
                    ValueChanged="@(async e => { Value = e; await ValueChanged.InvokeAsync(e); })"
                    Placeholder="@Field.Placeholder"
                    CssClass="@CssClass">
                       <HeaderTemplate Context="headitem">
                    @if (Field.Typ == FieldTyp.Progress)
                    {
                        <ProgressBar Value="@headitem.Title.ToSecureString()" />
                    }
                    else if (Field.Typ == FieldTyp.Priority)
                    {
                        <PriorityBox ID="@headitem.ID" Value="@headitem.Title" />
                    }
                    else if (Field.Typ == FieldTyp.Status)
                    {
                        <StatusBox ID="@headitem.ID" Value="@headitem.Title" />
                    }
                    else
                    {
                        @headitem.Title.ToSecureString()
                    }
                </HeaderTemplate>
                <ItemTemplate Context="entry">
                    <div class="row g-0">

                        @if (Field.Typ == FieldTyp.Priority)
                        {
                            <PriorityBox ID="@entry.ID" Value="@entry.Title" />
                        }
                        else if (Field.Typ == FieldTyp.Status)
                        {
                            <StatusBox ID="@entry.ID" Value="@entry.Title" />
                        }
                        else
                        {
                            <div class="col px-1">
                                @entry.Title
                            </div>
                        }
                    </div>

                </ItemTemplate>
            </DropDown>
        }
        else if (Field.Typ == FieldTyp.CheckBox)
        {
            <CheckBox Label="@Field.Title"
                      Description="@Field.Description"
                      Value="@DefaultText"
                      ValueChanged="@(async e => { Value = e; await ValueChanged.InvokeAsync(e); })"
                      CssClass="@CssClass" />
        }
        else if (Field.Typ == FieldTyp.Heading)
        {
            <Heading Label="@Field.Title" ShowLabel="false"
                     Description="@Field.Description"
                     Value="@DefaultText"
                     ValueChanged="@(async e =>{ Value = e; await ValueChanged.InvokeAsync(e); })"
                     CssClass="@CssClass">
 
            </Heading>
        }
        else
        {
            <TextBox Label="@Field.Title"
                     Description="@Field.Description"
                     Value="@DefaultText"
                     ValueChanged="@(async e =>{ Value = e; await ValueChanged.InvokeAsync(e); })"
                     Type="@Field.Typ"
                     Placeholder="@Field.Placeholder"
                     CssClass="@CssClass"
                     Min="@Min" Max="@Max" Step="@Step">
            </TextBox>
        }
    </div>

}

@code {

    private string ID { get; set; } = Guid.NewGuid().ToSecureString();
    private string DefaultText { get; set; } = string.Empty;

    // Fields 
    List<IDTO> Items { get; set; } = new();

    // Parameter 
    [Parameter]
    public IField Field { get; set; }

    [Parameter]
    public ValueBindingTyp Binding { get; set; } = ValueBindingTyp.Property;

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public string CssClass { get; set; } = " bg-body ";

    [Parameter]
    public bool Border { get; set; } = true;

    [Parameter]
    public bool ShowLabel { get; set; } = false;

    [Parameter]
    public string? Min { get; set; }

    [Parameter]
    public string? Max { get; set; }

    [Parameter]
    public string? Step { get; set; }
    [Parameter]
    public int Rows { get; set; } = 4;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        await Init();
    }

    // Methods 
    public async Task Init()
    {
        this.Items = await Helper.InitDropDown(Field, sql);

        // if (Field.Typ == FieldTyp.CheckBox)
        // {
        //     DefaultText = "false";
        //     await ValueChanged.InvokeAsync(DefaultText);
        // }
        // if (Field.Typ == FieldTyp.Date)
        // {
        //     DefaultText = DateTime.Now.ToString("yyyy-MM-dd");
        //     await ValueChanged.InvokeAsync(DefaultText);
        // }
        // if (Field.Typ == FieldTyp.DateTime)
        // {
        //     DefaultText = DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
        //     await ValueChanged.InvokeAsync(DefaultText);
        // }
        // if (Field.Typ == FieldTyp.Time)
        // {
        //     DefaultText = DateTime.Now.ToString("HH:mm");
        //     await ValueChanged.InvokeAsync(DefaultText);
        // }

        await InvokeAsync(StateHasChanged);
    }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<List<IDTO>> ItemsChanged { get; set; }

}