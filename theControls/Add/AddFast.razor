@using theControls.Add
@using theControls.Icons
@using theControls.Input
@using theControls.Modal
@inject ISqlDatabaseService sqlService
@inject IAppService appService
@inject ISecurityService secService
@inject IMessagingBusService msg
@inject ILocalizationService loc
@inject ISearchService search
@inject IJSRuntime js
@implements IAsyncDisposable

@if (ItemType != null)
{

  
        @if (ItemType.Typ == ItemTypeTyp.Note || ItemType.Typ == ItemTypeTyp.Comment)
        {
            <div class="vstack">
                <TextArea Value="@Title"
                          Placeholder="@loc.GetLabel("hinzufügen...", "add...")"
                          ValueChanged="@(async e => { Title = e; })">
                      <Overlay>
                             @if (!string.IsNullOrEmpty(this.Title))
                {
                    <button type="button" class="btn btn-sm btn-primary"
                            @onclick="OnOK">
                        <SymbolIcon Symbol="Icon.Neu" />
                    </button>
                }
                      </Overlay>
                      </TextArea>

             

            </div>
        }
        else
        {
            <div class="input-group input-group-sm" style="max-width:21rem;">
                @*        <span class="input-group-text fw-bold px-2">
                @ItemType.Name
            </span> *@
                <input id="@ID" class="form-control form-control-sm" type="text" value="@Title"
                       placeholder="@loc.GetLabel("hinzufügen...", "add...")"
                       @oninput="@(  e => { Title = e.Value?.ToString() ?? string.Empty; })"
                       @onkeydown="HandleKeyDown" />

                @if (!string.IsNullOrEmpty(this.Title))
                {
                    <button type="button" class="btn btn-sm"
                            @onclick="OnOK">
                        <SymbolIcon Symbol="Icon.Neu" />
                    </button>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(Message))
        {
            <div class="p-2 px-3">
                <div class="alert alert-danger p-2 m-2">@Message</div>
            </div>
        }
   
}

@code {

    private string ID = $"add-fast-input-{Guid.NewGuid():N}";

    [Parameter]
    public IItemType ItemType { get; set; }

    [Parameter]
    public IDTO RelatedItem { get; set; }

    [Parameter]
    public AssociationTyp Association { get; set; } = AssociationTyp.Association;


    private IQueryContext Context { get; set; }

    // Fields
    private string Title { get; set; } = string.Empty;
    private string Message { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (ItemType != null)
        {
            Context = new QueryContext(sqlService, secService, this.ItemType);
        }
    }

    private async Task SearchForDuplicates()
    {
        Message = string.Empty;

        if (Context == null)
            return;

        //
        IFilterParameter filter = new FilterParameter();
        filter.Matchcode = this.Title;
        Context.Filter = filter;

        // Search 
        await Context.Search();

        IDTO? item = Context.Items.FirstOrDefault(se => se.Title == this.Title);
        if (item != null)
        {
            // Message
            Message = string.Format("Datensatz: {0} existiert bereits", this.Title);
        }

        await Task.CompletedTask;
    }

    private async Task OnOK()
    {
        if (string.IsNullOrEmpty(Title))
        {
            msg.Publish("Notwendige Felder", BusAction.Info, "Titel muss gesetzt sein.");
            return;
        }

        if (RelatedItem != null)
        {
            if (this.Association == AssociationTyp.NULL)
            {
                msg.Publish("Notwendige Felder", BusAction.Info, "Assoziation muss gesetzt sein.");
                return;
            }
        }

        if (Context == null)
            return;

        if (this.Association == AssociationTyp.NULL)
        {
            return;
        }

        // Erstellen
        Guid ID = await Context.Create(Title);

        // Laden
        await Context.Load(ID.ToSecureString());

        // Update
        await Context.Update(Context.Item);

        if (secService.Configuration.EventHandler == true)
        {
            // Event
            IItemEventArgs args = new ItemEventArgs(Context.Item, RelatedItem, sqlService, secService, appService);

            // Create Event
            Context.Item = await Context.ItemType.OnCreateItem(args);
        }

        // Related Item
        if (RelatedItem != null)
        {
            await sqlService.Assign(RelatedItem, Context.Item, Association);
        }

        // Clean
        Title = string.Empty;

        // Message
        AppMessage am = new AppMessage("ID", BusAction.Refresh, "Datensatz erzeugt");
        msg.Publish(am);

        // Search 
        await search.Init();

        // JSInterop: Fokus beim Laden direkt in die Textbox setzen
        await js.InvokeVoidAsync("setFocusById", ID);

        // Visual Update
        await InvokeAsync(this.StateHasChanged);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await OnOK();
        }
    }
 
    
    [Parameter]
    public EventCallback<IDTO> OnRelatedItemAdded { get; set; }

    [Parameter]
    public EventCallback<IDTO> OnItemAdded { get; set; }

    private async Task ItemAdd(IDTO dto)
    {
        if (OnItemAdded.HasDelegate)
        {
            await OnItemAdded.InvokeAsync(dto);
        }
    }

    private async Task RelatedItemAdd(IDTO dto)
    {
        if (OnRelatedItemAdded.HasDelegate)
        {
            await OnRelatedItemAdded.InvokeAsync(dto);
        }
    }
    
    
    
    public async ValueTask DisposeAsync()
    {
        try
        {
            ItemType = null;
            RelatedItem = null;

            if (Context != null)
            {
                ((IDisposable)Context).Dispose();
                Context = null;
            }

        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : DISPOSE : BoardComp : " + ex.Message);
        }
    }
}
