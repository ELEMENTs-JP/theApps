@using theControls.Input
@inject IMessagingBusService msg
@inject ISqlDatabaseService sql
@inject ISearchService search
@inject ILocalizationService loc
@inject ISecurityService sec

@if (sec.Configuration.AllowFileUploads)
{
    @if (ItemType != null)
    {
        <FileInputBox ItemType="@ItemType" OnFileUploaded="OnFileUpload" 
                  SizeMode="@SizeMode" Width="@Width" Height="@Height" CSS="@CSS" />
    }
}

@code {

    [Parameter]
    public string CSS { get; set; } = "";

    [Parameter]
    public IItemType ItemType { get; set; }

    [Parameter]
    public IDTO RelatedItem { get; set; } // Parent Item in RelatedItemsComp 

    [Parameter]
    public AssociationTyp Association { get; set; } = AssociationTyp.NULL;

    [Parameter]
    public FileInputBox.FileInputSizeMode SizeMode { get; set; } = FileInputBox.FileInputSizeMode.Fixed;

    [Parameter]
    public int Width { get; set; } = 24;

    [Parameter]
    public int Height { get; set; } = 24;

    private async Task OnFileUpload(FileNotification fn)
    {
        // Check 
        if (fn == null)
            return;

        // Allow File Uploads 
        if (sec.Configuration.AllowFileUploads == false)
            return;

        // Parameter 
        IQueryParameter qp = new QueryParameter();
        qp.GUID = fn.FileGUID;
        qp.MasterGUID = sql.MasterGUID;
        qp.Title = fn.OriginalFileName;
        qp.ItemType = ItemType.Name;
        qp.UserGUID = sec.User.GUID;
        qp.UserName = sec.User.Title;

        // Create 
        IQueryResult result = await sql.Create(qp);
        if (result == null)
            return;

        IQueryResult itemResult = await sql.GetItem(qp);
        if (itemResult == null)
            return;

        IDTO? item = itemResult.Items.FirstOrDefault();
        if (item == null)
            return;

        // Extension 
        item["FullFilePath"] = fn.FullFilePath;
        item["FileExtension"] = fn.FileExtension;

        // MimeType / Text-Binary
        item["MimeType"] = fn.MimeType;
        item["IsText"] = fn.IsText.ToSecureString();
        item["IsBinary"] = fn.IsBinary.ToSecureString();

        // Size 
        item["FileSizeInByte"] = fn.FileSizeInByte.ToSecureString();
        item["FileSizeInKB"] = fn.FileSizeInKB.ToSecureString();
        item["FileSizeInMB"] = fn.FileSizeInMB.ToSecureString();

        // Update 
        await sql.Update(item);

        if (RelatedItem != null)
        {
            await sql.Assign(RelatedItem, item, Association);
        }

        // Refresh 
        msg.Publish(new AppMessage("List", BusAction.Refresh));

        // Search
        await search.Init();

        if (OnFileUploaded.HasDelegate)
        {
            await OnFileUploaded.InvokeAsync(item);    
        }
    }

    [Parameter]
    public EventCallback<IDTO> OnFileUploaded { get; set; }

}
