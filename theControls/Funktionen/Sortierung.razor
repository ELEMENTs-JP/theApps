@if (Field != null && ItemType != null && Field?.Funktionen.IsSortable == true)
{
    @if (SortDirection == null)
    {
        <div class="hover rounded-2 p-05 pointer"
             @onclick="@( async e => { await SetDirection(ListSortDirection.Ascending); })">
            <SymbolIcon Symbol="Icon.Sort_NoSORT" />
        </div>
    }
    else if (SortDirection == ListSortDirection.Ascending)
    {
        <div class="hover rounded-2 p-05 pointer"
             @onclick="@( async e => { await SetDirection(ListSortDirection.Descending); })">
            <SymbolIcon Symbol="Icon.Sort_AZ" />
        </div>
    }
    else if (SortDirection == ListSortDirection.Descending)
    {
        <div class="hover rounded-2 p-05 pointer"
             @onclick="@( async e => { await SetDirection(null); })">
            <SymbolIcon Symbol="Icon.Sort_ZA" />
        </div>
    }
}


@code {

    [Parameter]
    public IItemType ItemType { get; set; }

    [Parameter]
    public IField Field { get; set; }

    public ListSortDirection? SortDirection { get; set; } = null;


    [Parameter]
    public EventCallback<(ListSortDirection?, IField)> OnSort { get; set; }

    private async Task SetDirection(ListSortDirection? dir)
    {
        SortDirection = dir;

        if (OnSort.HasDelegate)
        {
            await OnSort.InvokeAsync((this.SortDirection, this.Field));
        }
    }
}
