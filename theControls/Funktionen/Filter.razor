@inject IMessagingBusService msg
@inject ISearchService search

@if (ItemType != null)
{
    @if (Fields.Count() >= 1)
    {
        <div id="@( "frame_popup_" + ID )" class="@(" dropdown-center ") ">
            <div id="@( "link_popup_" + ID )" data-bs-toggle="dropdown"
                 class="@(" d-flex p-1 align-items-center text-reset " + ButtonCssClass)">
                <div id="@( "head_popup_" + ID )" class="rounded-2 hover pointer p-1">
                    <SymbolIcon Symbol="Icon.Filter" />
                </div>
            </div>

            <div id="@( "body_popup_" + ID )" class="@( "dropdown-menu " )" style="@MenuStyle">
                <div class="vstack">
                    <div class="dropdown-header">Filter</div>
                    <div class="px-2 mb-1 small text-muted text-truncate-2 overflow-hidden">@SubTitle</div>
                </div>

                <div class="dropdown-divider"></div>
                <div class="@( " px-2 " + " overflow-y-auto " )" style="@( ContentStyle + " " + MaxHeightCSS )">

                    @if (ItemType != null)
                    {
                        @foreach (IField field in Fields)
                        {
                            <small class="text-muted px-1 mt-2 fw-bold">@field.Title.ToSecureString()</small>

                            @foreach (string val in search.ValuesByColumn(this.ItemType.Name, field.Column))
                            {
                                <div class="row g-0 rounded-2 p-1 hover">
                                    <div class="col pe-1 border-end">
                                        @val.ToSecureString()
                                    </div>
                                    @if (IsConnected(field.Column, val))
                                    {
                                        <div class="col-2 p-05 text-center hover pointer rounded"
                                        @onclick="@( async e => { await Disconnect(field.Column, val); })">
                                            <SymbolIcon Symbol="Icon.Disconnect" Color="var(--tblr-red)" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-2 p-05 text-center hover pointer rounded"
                                            @onclick="@( async e => { await Connect(field.Column, val); })">
                                            <SymbolIcon Symbol="Icon.Connect" Color="var(--tblr-green)" />
                                        </div>
                                    }
                                </div>
                            }
                        }

                        <div class="border-top py-2 mt-2">
                            <div class="btn btn-sm btn-primary w-100" @onclick="ClearFilter">
                                Filter entfernen
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>
    }
}





@code {

    [Parameter]
    public IItemType ItemType { get; set; }

    [Parameter]
    public string ID { get; set; } = "" + Guid.NewGuid();

    [Parameter]
    public string MaxHeightCSS { get; set; } = "max-height:44rem;";

    [Parameter]
    public string ContentStyle { get; set; } = "  ";

    [Parameter]
    public string SubTitle { get; set; } = "Filtert das Ergebnis nach Auswahl";

    [Parameter]
    public string MenuStyle { get; set; } = "min-width:13rem;";

    [Parameter]
    public bool TextColorReset { get; set; } = true;

    [Parameter]
    public string ButtonCssClass { get; set; } = "  ";

    [Parameter]
    public IQueryContext Context { get; set; }

    List<IField> Fields { get; set; } = new();

    IFilterParameter Parameter { get; set; } = new FilterParameter();

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        Fields.Clear();
        if (ItemType != null)
        {
            Fields = await ItemType.GetFields();

            Fields = Fields.Where(se => se.Funktionen.IsFilterable == true).ToList();
        }
    }

    private async Task Connect(string column, string value)
    {
        if (Parameter != null && Parameter.Parameters != null)
        {
            Parameter.Parameters.Add(new KeyValuePair<string, string>(column, value));

            if (Context != null)
            {
                if (Context.Filter == null)
                {
                    Context.Filter = new FilterParameter();
                }

                // set Filter
                Context.Filter.Parameters = Parameter.Parameters;

                // run
                await FilterData();
            }
        }
    }
    private async Task Disconnect(string column, string value)
    {
        if (Parameter != null && Parameter.Parameters != null)
        {
            Parameter.Parameters.Remove(new KeyValuePair<string, string>(column, value));

            if (Context != null)
            {
                if (Context.Filter == null)
                {
                    Context.Filter = new FilterParameter();
                }

                // set Filter
                Context.Filter.Parameters = Parameter.Parameters;

                // run
                await FilterData();
            }
        }
    }
    private async Task ClearFilter()
    {
        if (Parameter != null && Parameter.Parameters != null)
        {
            Parameter.Parameters.Clear();

            if (Context != null)
            {
                if (Context.Filter == null)
                {
                    Context.Filter = new FilterParameter();
                }

                // set Filter
                Context.Filter.Parameters = Parameter.Parameters;

                // run
                await FilterData();
            }
        }
    }

    private bool IsConnected(string column, string value)
    {
        if (Parameter?.Parameters == null)
            return false;

        return Parameter.Parameters.Any(p => p.Key == column && p.Value == value);
    }

    [Parameter]
    public EventCallback<IFilterParameter> OnFilter { get; set; }
    private async Task FilterData()
    {
        if (OnFilter.HasDelegate)
        {
            if (Parameter != null)
            {
                await OnFilter.InvokeAsync(Parameter);
            }

            // Liste aktualisieren
            // msg.Publish("List", BusAction.Refresh);
        }
    }
}
