@using theControls.Essentials
@inject NavigationManager nm

@if (ItemType != null)
{

    <AssociationIcon Association="@Association" CSS="pe-2" />

    @if (ItemType != null)
    {
        @if (!Helper.NotNavigateableItemTypes().Contains(ItemType.Name))
        {
            <div class="p-1 hover rounded-2 pointer me-2" @onclick="@( e => { nm.NavToLibrary(ItemType.Name, ItemType.Typ); })">
                <SymbolIcon Symbol="Icon.Link" />
            </div>
        }
    }

    <div class="btn-group" role="group">

        @foreach (IItemType it in Items.FromTo<IItemType>(0, 2))
        {
            <div class="@( "btn btn-sm btn-compact " + ((it.Name == ItemType.Name) ? " btn-primary " : "") )"
                 @onclick="@( async e => { ItemType = it; await ButtonClick(it); })">
                @it.ToString()
            </div>
        }

        @if (Items.Count() >= 4)
        {
            <div class="btn-group" role="group">
                <div class="btn btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    ...
                </div>
                <div class="dropdown-menu" style="">

                    @foreach (IItemType it in Items.FromTo<IItemType>(3, Items.Count() + 1))
                    {
                        <div class="@( "dropdown-item" )"
                             @onclick="@( async e => { ItemType = it; await ButtonClick(it); })">
                            @it.ToString()
                        </div>
                    }

                </div>
            </div>
        }
    </div>
}

@code {


    [Parameter]
    public IItemType ItemType { get; set; }

    [Parameter]
    public List<IItemType> Items { get; set; } = new();

    [Parameter]
    public AssociationTyp Association { get; set; } = AssociationTyp.NULL;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (Items.Count() >= 1)
        {
            ItemType = Items.FirstOrDefault();
            await ButtonClick(ItemType);
        }
    }

    [Parameter]
    public EventCallback<IItemType> OnClick { get; set; }

    private async Task ButtonClick(IItemType it)
    {
        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(it);
        }
    }

}
