@using theControls.Audio
@using theControls.Icons
@using theControls.Video
@inject IAppService app

@inherits BaseRow

@if (Context != null)
{

    <div class="hover rounded-2 p-2 overflow-hidden m-1">

        @if (Context.ItemType.Typ == ItemTypeTyp.Video)
        {
            <VideoItem Item="@Item" />
        }
        else
        {
            @if (string.IsNullOrEmpty(this.Base64String))
            {
                <SymbolIcon Symbol="Icon.Empty" MaxWidth="120" MaxHeight="120" CSS="p-3 align-items-center" />
            }
            else
            {
                @* w-100 sorgt dafür, dass sich das Bild voll an den äußeren Container anpasst *@
                <div class="@( UserImageCSS + " w-100 mx-auto " + app.Configuration.GetRoundedCSS(4) )"
                     style="@(UserImageStyle + " " + BackgroundColor +
                                        " background-image: url(" + this.Base64String + "); " )"></div>
            }
        }
        

        <div class="row g-0 p-1">
            <div class="d-flex justify-content-between align-items-center">
                <span class="p-1 text-muted" title="@Item.GUID">@(Item.ID.ToSecureString())</span>

                @if (Context.ItemType.Typ == ItemTypeTyp.Audio)
                {
                    <span class="px-1">
                        <MiniAudioPlayer Item="@Item" />
                    </span>
                }
                @if (Context.ItemType.Typ == ItemTypeTyp.Video)
                {
                    <span class="p-1 hover pointer rounded" @onclick="DeleteItem">
                        <SymbolIcon Symbol="Icon.Delete" />
                    </span>
                }
            </div>
            <div class="col-12 p-1 fw-bold pointer text-truncate" title="@Item.Title.ToSecureString()"
                 @onclick="@( e => { nm.NavToItem(Context.ItemType.Name, Item.GUID); })">
                @(Item.Title.ToSecureString())
            </div>
         
            @if (IsRelated)
            {
                <div class="col-auto p-1">
                    <SymbolIcon Symbol="Icon.Disconnect" CSS="pointer hover"
                                OnClick="@( async  e => { await Disconnect(); })" />
                </div>
            }
        </div>
    </div>

}

@code {

    // Image
    private string Base64String { get; set; } = "";

    public string UserImageCSS { get; set; } = "  ";
    public string UserImageStyle { get; set; } =
    "aspect-ratio: 1 / 1; " +
    "max-width: 100%; " +
    // "border-radius: 50%; " +
    "border: 3px solid #ffffff; " +
    "background-size: cover; " +
    "background-position: center center; " +
    "background-repeat: no-repeat;";
    public string MinStyle { get; set; } = "min-height: 32px; min-width:32px;";

    string BackgroundColor { get; set; } = "  ";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();


        string ext = Item["FileExtension"].ToSecureString();
        this.Base64String = string.Empty;
        if (Helper.IsValidImageExtension(ext) == true)
        {
            this.Base64String = await Helper.ToBase64String(this.Item, true);
        }

    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
    }

    [Parameter]
    public EventCallback<IDTO> OnItemDelete { get; set; }

    private async Task DeleteItem()
    {
        if (Item == null)
            return;

        if (OnItemDelete.HasDelegate)
        {
            await OnItemDelete.InvokeAsync(Item);    
        }
    }

}
