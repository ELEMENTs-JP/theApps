@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@if (Item != null)
{
    <div class="video-card-container rounded overflow-hidden position-relative">
        <video id="@PlayerId"
               class="video-js vjs-fluid netflix-preview-player"
               muted
               preload="auto"
               playsinline
               controls
               data-setup='{
                    "controlBar": {
                    "playToggle": true,
                    "volumePanel": false,
                    "fullscreenToggle": false,
                    "pictureInPictureToggle": false }
                    }'>
            <source src="@VideoUrl" type="video/mp4" />
        </video>
    </div>
}

@code {
    [Parameter]
    public IDTO Item { get; set; }

    private string PlayerId { get; set; } = $"video-{Guid.NewGuid():N}";
    private string VideoUrl { get; set; } = string.Empty;
    private bool isInitialized = false;

    protected override void OnParametersSet()
    {
        if (Item != null)
        {
            string fileGUID = Item.GUID.ToSecureString();
            string fileEXT = Item["FileExtension"].ToSecureString();

            VideoUrl = $"/stream/{fileGUID}.{fileEXT}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Item != null)
        {
            // await JSRuntime.InvokeVoidAsync("netflixPlayer.init", PlayerId);
            isInitialized = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (isInitialized)
        {
            try
            {
                // await JSRuntime.InvokeVoidAsync("netflixPlayer.dispose", PlayerId);
            }
            catch (JSDisconnectedException)
            {
                // Circuit getrennt
            }
        }
    }
}