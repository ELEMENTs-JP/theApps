@using theControls.Add
@inherits BaseList

@inject NavigationManager nm

@if (Context != null && ItemType != null)
{
    @if (Context.ItemType != null)
    {
        <div class="table-responsive">
            <div class="row g-0">

                <div class="col-2 p-3">
                    <FileUploadComp SizeMode="FileInputBox.FileInputSizeMode.Maximized" Width="96" Height="96" />
                </div>

                @foreach (IDTO item in Context.Items)
                {
                    <div class="col-2">
                        <FileItem @key="@( "file-image-" + item.GUID)"
                                  Context="@Context" Item="@item"
                                  IsRelated="@( (RelatedItem != null))" />
                    </div>
                }
            </div>
        </div>
    }
}


@code {

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }

}
