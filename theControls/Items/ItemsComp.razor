

@inject ISqlDatabaseService sql
@inject ISecurityService sec

@if (ItemType != null)
{
    @if (IsSecure)
    {
        <Frame Border="true">
            <Header>
                <ControlHeader PreTitle="List" Title="@Title" PostTitle="@ItemType.Description" />
            </Header>
            <Controls>
                <div class="d-flex align-items-center">

                    <Gruppierung ItemType="@ItemType" Context="@Context"
                                 OnGroup="@( async e => { await Context.Search(); })" />
                    <Filter ItemType="@ItemType" Context="@Context"
                            OnFilter="@( async e => { await Context.Search(); })" />

                    @if (this.ItemType.Typ == ItemTypeTyp.Appointment)
                    {
                        <ButtonSelectionBox Value="@View" ItemChanged="@(e => { View = e.ID; })"
                                        Items="@(new List<IDTO>() {
                                            new DTO() { ID = "Monat", Title = "Monat" },
                                            new DTO() { ID = "Woche", Title = "Woche" },
                                                new DTO() { ID = "Tag", Title = "Tag" } } )" />
                    }
                </div>
            </Controls>
            <Search>
                <LocalSearchComp OnSearch="@( e => { Matchcode = e.ToSecureString(); })"
                                 ItemType="@this.ItemType" />
            </Search>
            <Related>
                @if (this.ItemType.Name != "Trash")
                {
                    <ListSetting ItemType="@this.ItemType" CSS="mx-2" 
                        OnSettingChanged="@( async e => {  })" />
                    <div class="vr"></div>

                    @if (Helper.FileBoxVisibility(this.ItemType.Typ))
                    {
                        <ClipboardCopyPaste ItemType="@this.ItemType" />
                        <FileUploadComp ItemType="@this.ItemType" />
                    }
                    else
                    {
                        <AddArea ItemType="@ItemType" CSS="me-2" />
                    }
                }
            </Related>
            <Content>

                @if (this.ItemType.Typ == ItemTypeTyp.Item ||
                        this.ItemType.Typ == ItemTypeTyp.User ||
                        this.ItemType.Typ == ItemTypeTyp.Note ||
                        this.ItemType.Typ == ItemTypeTyp.Link ||
                        this.ItemType.Typ == ItemTypeTyp.Information ||
                        this.ItemType.Typ == ItemTypeTyp.Comment ||
                            this.ItemType.Typ == ItemTypeTyp.Audio)
                {
                    <DataTable ItemType="@this.ItemType" Matchcode="@this.Matchcode" Context="@Context">
                        <Empty>
                            <QuickAdd ItemType="@this.ItemType" OnAdd="@( e => { })" />
                        </Empty>
                    </DataTable>
                }
                else if (this.ItemType.Typ == ItemTypeTyp.File ||
                            this.ItemType.Typ == ItemTypeTyp.Video ||
                            this.ItemType.Typ == ItemTypeTyp.Image)
                {
                    <FileList ItemType="@ItemType" Matchcode="@this.Matchcode" Context="@Context" />
                }
                else if (this.ItemType.Typ == ItemTypeTyp.Appointment)
                {
                    @if (View == "Monat")
                    {
                        <CalendarMonthComp ItemType="@ItemType" Context="@Context" />
                    }
                    else if (View == "Woche")
                    {
                        <CalendarWeekComp ItemType="@ItemType" Context="@Context" />
                    }
                    else if (View == "Tag")
                    {
                        <CalendarDayComp ItemType="@ItemType" Context="@Context" />
                    }

                }

                
            </Content>
            <Bottom>
             

                @if (Helper.FileBoxVisibility(this.ItemType.Typ))
                {
                   
                }
                else
                {
                    <AddFast ItemType="@ItemType" OnItemAdded="@( e => {  })" />
                }

            </Bottom>
        </Frame>
    }
    else
    {
        <div class="row g-0 p-2 align-items-center">
            <div class="col-auto p-2">
                <SymbolIcon Symbol="Icon.Invariant" />
            </div>
            <div class="col p-2">
                <h1 class="h1">Dieser ItemType ist nicht einsehbar.</h1>
            </div>
        </div>
    }
}


@code {

    [Parameter]
    public IItemType ItemType { get; set; }

    private string Title { get; set; } = string.Empty;
    private bool IsSecure { get; set; } = false;
    private string View { get; set; } = "Monat";

    private IQueryContext Context { get; set; }
    private string Matchcode { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (ItemType != null)
        {
            // Falls bereits vorhanden, erst alt aufräumen
            if (Context is IDisposable disposable)
            {
                disposable.Dispose();
            }

            // Kontext für den neuen ItemType frisch instanziieren
            Context = new QueryContext(sql, sec, ItemType);

            // Title 
            Title = await Helper.GetSettingValue(sql, "Title", ItemType.Name);
            Title = Title.IsEmpty() ? ItemType.Name : Title;

            IsSecure = Helper.ValidateVisibility(SecuredFeature.List, ItemType, sec.User);
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            // this.StateHasChanged();
        }
    }

 

}
