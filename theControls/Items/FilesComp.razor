@using theControls.Folder
@inject IAppService app
@inject ISqlDatabaseService sql
@inject ISecurityService sec
@inject IMessagingBusService msg
@inject ISearchService search
@inject INotificationService notify

@inject NavigationManager nm

@if (ItemType != null)
{
    @if (IsSecure)
    {
        <Frame Border="true">
            <Header>
                <ControlHeader PreTitle="List" Title="@Title"
                               SubTitle="@("Typ " + ItemType.Typ.ToSecureString())"
                               Description="@ItemType.Description" />
            </Header>
            <Controls>
                <div class="d-flex align-items-center">

                    <Gruppierung ItemType="@ItemType" Context="@Context"
                                 OnGroup="@( async e => { await Context.Search(); })" />
                    <Filter ItemType="@ItemType" Context="@Context"
                            OnFilter="@( async e => { await Context.Search(); })" />

                </div>
            </Controls>
            <Search>
                <LocalSearchComp OnSearch="@( e => { Matchcode = e.ToSecureString(); })"
                                 ItemType="@this.ItemType" />
            </Search>
            <Related>
                @if (this.ItemType.Name != "Trash")
                {
                    <ListSetting ItemType="@this.ItemType" CSS="mx-2"
                                 OnSettingChanged="@( async e => {  })" />
                    <div class="vr"></div>

                    <ClipboardCopyPaste ItemType="@this.ItemType" />
                    <FileUploadComp ItemType="@this.ItemType" />
                }
            </Related>
            <Content>

                @if (this.ItemType.Typ == ItemTypeTyp.Audio)
                {
                    <DataTable ItemType="@this.ItemType" Matchcode="@this.Matchcode" Items="@Context.Items"
                               OnSort="@( async e => { await Context.Search(); } )">
                        <Empty>
                            <QuickAdd ItemType="@this.ItemType" OnAdd="@( e => { })" />
                        </Empty>
                    </DataTable>


                }
                else if (this.ItemType.Typ == ItemTypeTyp.File ||
                            this.ItemType.Typ == ItemTypeTyp.Video ||
                            this.ItemType.Typ == ItemTypeTyp.Image)
                {
                    <FileList ItemType="@ItemType" Matchcode="@this.Matchcode" 
                        Items="@Context.Items" OnItemDelete="@( e => {  })" />
                }

            </Content>

        </Frame>
    }
    else
    {
        <div class="row g-0 p-2 align-items-center">
            <div class="col-auto p-2">
                <SymbolIcon Symbol="Icon.Invariant" />
            </div>
            <div class="col p-2">
                <h1 class="h1">Dieser ItemType ist nicht einsehbar.</h1>
            </div>
        </div>
    }
}


@code {

    [Parameter]
    public IItemType ItemType { get; set; }

    private string Title { get; set; } = string.Empty;
    private bool IsSecure { get; set; } = false;
    private string View { get; set; } = "Monat";

    private IQueryContext Context { get; set; }
    private string Matchcode { get; set; } = string.Empty;
    private List<IField> Fields { get; set; } = new();

    private string dateColumn = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        dateColumn = await ItemType.GetRelevantPropertyName(RelevantPropertyType.Date);

        if (Context == null)
        {
            Context = new QueryContext(sql, sec, ItemType);
        }
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();


        if (ItemType == null)
            return;

        // Items 
        Fields = await ItemType.GetFields();
        Context.ItemType = ItemType;
        await Context.Search();

        // Title 
        Title = await Helper.GetSettingValue(sql, "Title", ItemType.Name);
        Title = Title.IsEmpty() ? ItemType.Name : Title;

        IsSecure = Helper.ValidateVisibility(SecuredFeature.List, ItemType, sec.User);

    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            // this.StateHasChanged();
        }
    }

    // Helper
    private async Task CreateRedirect()
    {
        IQueryParameter qp = QueryParameter.Default("neuer Termin");
        qp.ItemType = "Appointment";
        qp.MasterGUID = sql.MasterGUID;

        await sql.Create(qp);

        IQueryResult result = await sql.GetItem(qp);
        IDTO newItem = result.Items.FirstOrDefault();
        if (newItem != null)
        {
            nm.NavToItem(qp.ItemType, qp.GUID);

            if (sec.Configuration.EventHandler == true)
            {
                // Event
                IItemEventArgs args = new ItemEventArgs(newItem, null, sql, sec, app);

                // Create Event
                IItemType it = await new Factory(sql).BuildItemType(qp.ItemType);
                newItem = await it.OnCreateItem(args);
            }

            // Message
            AppMessage am = new AppMessage("ID", BusAction.Refresh, "Datensatz erzeugt");
            msg.Publish(am);

            // Search
            await search.Init();
        }
    }
    private async Task ItemDelete(IDTO dto)
    {
        try
        {
            if (dto == null)
                return;

            await Context.Delete(dto);
            await Context.Search();

            msg.Publish("", BusAction.Refresh);
            msg.Publish("", BusAction.Info, "Item wurde gelöscht");

            // Notification Service
            notify.NotifyChanged(Context.Item, NotificationType.Update, sec.User);

        }
        catch (Exception ex)
        {

        }

    }
}
