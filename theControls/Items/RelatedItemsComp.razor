

@inject ISqlDatabaseService sql

@if (RelatedItem != null && ItemType != null)
{
    <Frame Border="true" CSS="@CSS" ContentCSS=" " BottomBorderCSS=" " HeadBorderCSS=" ">
        <Header>
            @if (ItemType != null)
            {
                <div class="d-flex flex-row align-items-center">

                    @if (!string.IsNullOrEmpty(Title))
                    {
                        <div class="fw-bold pe-2 me-2">@Title</div>
                    }
                    <ItemTypeSelector Items="@ItemTypes" Association="@this.Association" 
                                        OnClick="@( e => { ItemType = e; })" />
                </div>
            }
        </Header>
        <Related>
            <div class="hstack align-items-center">
                <ConnectComp ItemType="@ItemType" RelatedItem="@RelatedItem" Association="@this.Association" ButtonTitle="" />
                <div class="vr mx-1"></div>
                <AddArea ItemType="@ItemType" RelatedItem="@RelatedItem" Association="@this.Association" ButtonTitle=""  />
            </div>
        </Related>
        <Content>
            <ItemsList ItemType="@ItemType" RelatedItem="@RelatedItem" Association="@this.Association" />
        </Content>
        <Bottom>
            <AddFast ItemType="@ItemType" RelatedItem="@RelatedItem" Association="@this.Association" 
                     OnItemAdded="@( e => {  })" OnRelatedItemAdded="@( e => {  })" />
        </Bottom>
    </Frame>
}

@code {

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string CSS { get; set; } = string.Empty;

    IItemType ItemType { get; set; }  // Related ItemType // Parent ItemType 

    [Parameter]
    public IDTO RelatedItem { get; set; } // Related DTO 

    [Parameter]
    public List<IItemType> ItemTypes { get; set; } = new();

    [Parameter]
    public AssociationTyp Association { get; set; } = AssociationTyp.Association;


    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (ItemTypes.Count() >= 1)
        {
            ItemType = ItemTypes.FirstOrDefault();
        }
        else
        {
            ItemType = null;    
        }

    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            // this.StateHasChanged();
        }
    }
}
