@inject IAppService app
@inject ISqlDatabaseService sql
@inject ISecurityService sec
@inject IMessagingBusService msg
@inject ISearchService search
@inject INotificationService notify
@inject ILocalizationService loc

@inject NavigationManager nm

@if (ItemType != null)
{
    @if (IsSecure)
    {
        <Frame Border="true">
            <Header>
                <ControlHeader PreTitle="Calendar" Title="@Title"
                               SubTitle="@("Typ " + ItemType.Typ.ToSecureString())"
                               Description="@ItemType.Description" />
            </Header>
            <Controls>
                <div class="d-flex align-items-center">

                    <Gruppierung ItemType="@ItemType" Context="@Context"
                                 OnGroup="@( async e => { await Context.Search(); })" />
                    <Filter ItemType="@ItemType" Context="@Context"
                            OnFilter="@( async e => { await Context.Search(); })" />

                 
                    <ButtonSelectionBox Value="@View" ItemChanged="@(e => { View = e.ID; })"
                                        Items="@(new List<IDTO>() {
                                            new DTO() { ID = "Monat", Title = "Monat" },
                                            new DTO() { ID = "Woche", Title = "Woche" },
                                                new DTO() { ID = "Tag", Title = "Tag" } } )" />

                </div>
            </Controls>
            <Search>
                <LocalSearchComp ItemType="@this.ItemType"
                                 OnSearch="@( async e => { Context.Filter.Matchcode = e.ToSecureString();  await Context.Search(); })" />
            </Search>
            <Related>
                @if (this.ItemType.Name != "Trash")
                {
                    <ListSetting ItemType="@this.ItemType" CSS="mx-2"
                                 OnSettingChanged="@( async e => {  })" />
                    <div class="vr"></div>

                  
                    <AddArea ItemType="@ItemType" CSS="me-2"
                             OnItemAdded="@( async e => { await Context.Search(); })" />

                }
            </Related>
            <Content>

                @if (View == "Monat")
                {
                    <CalendarMonthComp TItem="IDTO"
                                       Items="@Context.Items"
                                       DateSelector="@(dto => dto[dateColumn].ToSecureString().ToSecureDateTime())"
                                       TitleSelector="@(dto => dto.Title.ToSecureString())"
                                       OnItemClick="@(dto => nm.NavigateTo(Helper.GetItemUrl(dto)))"
                                       OnItemDeleted="@(async dto => await ItemDelete(dto))" />

                }
                else if (View == "Woche")
                {
                    <CalendarWeekComp TItem="IDTO"
                                      Items="@Context.Items"
                                      ShowWeekend="@showWeekendSetting"
                                      DateSelector="@(item => item[dateColumn].ToSecureDateTime())"
                                      StartSelector="@(item => item["Start"].ToSecureDateTime().TimeOfDay)"
                                      EndSelector="@(item => item["Ende"].ToSecureDateTime().TimeOfDay)"
                                      TitleSelector="@(item => item.Title)"
                                      OnItemClick="@(item => nm.NavToItem(item.ItemType, item.GUID))"
                                      OnCreateAppointment="@CreateRedirect" />
                }
                else if (View == "Tag")
                {
                    <CalendarDayComp TItem="IDTO" 
                                     Items="@Context.Items" CurrentDate="@CurrentDate"
                                     DateSelector="@(item => item[dateColumn].ToSecureDateTime().Date)"
                                     StartSelector="@(item => item["Start"].ToSecureDateTime().TimeOfDay)"
                                     EndSelector="@(item => item["Ende"].ToSecureDateTime().TimeOfDay)"
                                     TitleSelector="@(item => item.Title)"
                                     OnItemClick="@(item => nm.NavToItem(item.ItemType, item.GUID))"
                                     OnCreateAppointment="@CreateRedirect" />
                }

            </Content>
            <Bottom>

                @if (Helper.FileBoxVisibility(this.ItemType.Typ))
                {

                }
                else
                {
                    <AddFast ItemType="@ItemType" OnItemAdded="@( async e => { await Context.Search(); })" />
                }

                @if (IsPersonalizedView)
                {
                    <div class="d-inline-flex align-items-center">
                        <div class="bg-secondary rounded-circle me-2"
                             style="width: 8px; height: 8px; border:1px solid #fff; flex-shrink: 0;"></div>
                        <small class="text-muted small me-2">
                            @loc.GetLabel("Personalisierte Ansicht", "Personalized View")
                        </small>
                    </div>
                }

            </Bottom>
        </Frame>
    }
    else
    {
        <div class="row g-0 p-2 align-items-center">
            <div class="col-auto p-2">
                <SymbolIcon Symbol="Icon.Invariant" />
            </div>
            <div class="col p-2">
                <h1 class="h1">Dieser ItemType ist nicht einsehbar.</h1>
            </div>
        </div>
    }
}


@code {

    [Parameter]
    public IItemType ItemType { get; set; }

    [Parameter]
    public string View { get; set; } = "Monat";

    [Parameter]
    public string Date { get; set; } = "";
    private DateTime CurrentDate { get; set; } = DateTime.Now.Date;

    private string Title { get; set; } = string.Empty;
    private bool IsSecure { get; set; } = false;
    private bool showWeekendSetting = true;
    private bool IsPersonalizedView { get; set; } = false;

    private IQueryContext Context { get; set; }

    private List<IField> Fields { get; set; } = new();

    private string dateColumn = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        dateColumn = await ItemType.GetRelevantPropertyName(RelevantPropertyType.Date);
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        var setting = await Helper.GetSettingValue(sql, "ShowWeekend", ItemType.Name);
        showWeekendSetting = (setting == "true");

        if (!string.IsNullOrEmpty(Date))
        {
            CurrentDate = Date.ToSecureDateTime().Date;
        }

        if (ItemType != null)
        {
            // Personalisierte Ansicht
            IsPersonalizedView = ItemType.IsPersonalizedItemType();

            Fields = await ItemType.GetFields();

            Context = new QueryContext(sql, sec, ItemType);
            await Context.Search();

            // Title
            Title = await Helper.GetSettingValue(sql, "Title", ItemType.Name);
            Title = Title.IsEmpty() ? ItemType.Name : Title;

            IsSecure = Helper.ValidateVisibility(SecuredFeature.List, ItemType, sec.User);
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            // this.StateHasChanged();
        }
    }

    // Helper
    private async Task ItemsReload()
    {
        await Context.Search();
    }

    private async Task CreateRedirect()
    {
        IQueryParameter qp = QueryParameter.Default("neuer:e " + this.ItemType.Name);
        qp.ItemType = this.ItemType.Name;
        qp.MasterGUID = sql.MasterGUID;

        await sql.Create(qp);

        IQueryResult result = await sql.GetItem(qp);
        IDTO newItem = result.Items.FirstOrDefault();
        if (newItem != null)
        {
            nm.NavToItem(qp.ItemType, qp.GUID);

            if (sec.Configuration.EventHandler == true)
            {
                // Event
                IItemEventArgs args = new ItemEventArgs(newItem, null, sql, sec, app);

                // Create Event
                IItemType it = await new Factory(sql).BuildItemType(qp.ItemType);
                newItem = await it.OnCreateItem(args);
            }

            // Message
            AppMessage am = new AppMessage("ID", BusAction.Refresh, "Datensatz erzeugt");
            msg.Publish(am);

            // Search
            await search.Init();
        }
    }
    private async Task ItemDelete(IDTO dto)
    {
        try
        {
            if (dto == null)
                return;

            await Context.Delete(dto);
            await Context.Search();

            msg.Publish("", BusAction.Refresh);
            msg.Publish("", BusAction.Info, "Item wurde gelöscht");

            // Notification Service
            notify.NotifyChanged(Context.Item, NotificationType.Update, sec.User);

        }
        catch (Exception ex)
        {

        }

    }
}
