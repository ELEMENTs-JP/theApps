@using theControls.Audio
@using theControls.Detail
@using theControls.Video

@inject ISqlDatabaseService sql
@inject ISecurityService sec

@if (ItemType != null)
{
    @if (Context != null)
    {
        @if (IsSecure)
        {
            <div class="row g-0">
                <div class="col-12 col-lg-7 p-2">
                    <EditArea ItemType="@this.ItemType" ID="@ID" />

                    <RelatedItemsComp CSS="mb-3 mt-3" ItemTypes="@( ItemTypes.FirstOrDefault(se => se.Key == AssociationTyp.Children).Value ?? new List<IItemType>())"
                                      RelatedItem="@RelatedItem" Association="AssociationTyp.Children" />

                    <RelatedItemsComp CSS="mb-3" ItemTypes="@( ItemTypes.FirstOrDefault(se => se.Key == AssociationTyp.Default).Value ?? new List<IItemType>())"
                                      RelatedItem="@RelatedItem" Association="AssociationTyp.Default" />
                </div>
                <div class="col-12 col-lg-5 p-2">

                    <theControls.Hilfe.HelpByItemType ItemType="@this.ItemType" />

                    <ItemAssignments  Context="@Context"/>

                    <PdfViewer File="@RelatedItem" />
                    <ImagePreview Image="@RelatedItem" />
                    <AudioPlayer Item="@RelatedItem" />
                    <VideoPlayer Item="@RelatedItem" />

                    <RelatedItemsComp CSS="mb-3" ItemTypes="@(ItemTypes.FirstOrDefault(se => se.Key == AssociationTyp.Parents).Value ?? new List<IItemType>())"
                                      RelatedItem="@RelatedItem" Association="AssociationTyp.Parents" />

                    <RelatedItemsComp CSS="mb-3" ItemTypes="@( ItemTypes.FirstOrDefault(se => se.Key == AssociationTyp.Parallels).Value ?? new List<IItemType>())"
                                      RelatedItem="@RelatedItem" Association="AssociationTyp.Parallels" />

                    <RelatedItemsComp CSS="mb-3" ItemTypes="@( ItemTypes.FirstOrDefault(se => se.Key == AssociationTyp.Related).Value ?? new List<IItemType>())"
                                      RelatedItem="@RelatedItem" Association="AssociationTyp.Related" />


                </div>
            </div>
        }
        else
        {
            <div class="row g-0 p-2 align-items-center">
                <div class="col-auto p-2">
                    <SymbolIcon Symbol="Icon.Invariant" />
                </div>
                <div class="col p-2">
                    <h1 class="h1">Dieser ItemType / Datensatz ist nicht einsehbar.</h1>
                </div>
            </div>
        }
    }
}

@code {

    [Parameter]
    public string ID { get; set; } = string.Empty;

    private bool IsSecure { get; set; } = false;


    [Parameter]
    public IItemType ItemType { get; set; } = null;

    private IDTO RelatedItem { get; set; }
    private List<KeyValuePair<AssociationTyp, List<IItemType>>> ItemTypes { get; set; } = new();
    private List<string> ItemTypeGroups { get; set; } = new();

    private IQueryContext Context { get; set; } = null;
    private IQueryContext RelatedContext { get; set; } = null;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (ItemType != null)
        {
            // Clear
            ItemTypes.Clear();

            var types = new[]
              {
                AssociationTyp.Default,
                AssociationTyp.Children,
                AssociationTyp.Parallels,
                AssociationTyp.Parents,
                AssociationTyp.Related
            };

            foreach (var type in types)
            {
                var its = await ItemType.GetItemTypes(type);
                if (its?.Count > 0)
                {
                    ItemTypes.Add(new KeyValuePair<AssociationTyp, List<IItemType>>(type, its));
                }
            }

            if (!string.IsNullOrEmpty(this.ID))
            {
                Context = new QueryContext(sql, sec);
                Context.ItemType = ItemType;
                await Context.Load(this.ID);

                RelatedItem = Context.Item;
            }

            // Security
            IsSecure = Helper.ValidateVisibility(SecuredFeature.Item, ItemType, sec.User);
        }

   
    }
}
