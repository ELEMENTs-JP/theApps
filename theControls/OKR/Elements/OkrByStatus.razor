@inject IJSRuntime JS
@implements IAsyncDisposable
@inherits BaseCtl

<div class="border rounded p-2 bg-surface overflow-hidden">

    <h3 class="h3">Objectives by Status</h3>
    <div class="border-bottom text-muted small p-1">
        Der Status von Objectives zeigt die Zielerreichung, Risiken und Handlungsbedarf transparent auf und stützt Entscheidungen.
    </div>

    <div class="d-flex my-2 rounded overflow-hidden align-items-center">
        @foreach (var kpi in Values)
        {
            var percentage = totalCount > 0 ? ((double)kpi.Value / totalCount * 100).ToString(System.Globalization.CultureInfo.InvariantCulture) : "0";
            <div class="" style="width:@percentage%; height:1rem;
            margin-left:1px !important; margin-right:1px !important;
            background-color:@Status.ColorByStatusValue(kpi.Title)"></div>
        }
    </div>

    <div class="d-flex my-2 ps-1 align-items-center">
        @foreach (var kpi in Values)
        {
            <div class="legend-dot me-1" style="border:1px solid #fff !important; background-color:@Status.ColorByStatusValue(kpi.Title)"></div>
             <div class="me-2 text-truncate" style="max-width:7rem;">@kpi.Title</div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string Id { get; set; } = "comp-" + Guid.NewGuid().ToString("N");

    [Parameter]
    public IDTO TimeFrame { get; set; }

    List<KpiValue> Values { get; set; } = new();
    private int totalCount;

    private IJSObjectReference? jsModule;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        Values.Clear();

        List<IDTO> items = searchService.Store.Where(se => se.ItemType == "Objective").ToList();
        totalCount = items.Count;

        List<string> status = items
            .Select(se => se["Status"].ToSecureString())
            .Where(s => !string.IsNullOrEmpty(s))
            .Distinct()
            .ToList();

        foreach (string s in status)
        {
            var val = new KpiValue();
            val.Title = s;
            val.Value = items.Where(se => se["Status"].ToSecureString() == s).Count();

            Values.Add(val);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var type = this.GetType();

            var jsPath = $"./_content/{type.Assembly.GetName().Name}/OKR/Elements/{type.Name}.razor.js";

            jsModule = await JS.InvokeAsync<IJSObjectReference>("import", jsPath);
            await jsModule.InvokeVoidAsync("init", DotNetObjectReference.Create(this), "Initialisierungswert");
        }
    }

    public new async ValueTask DisposeAsync()
    {
        if (jsModule is not null)
        {
            await jsModule.DisposeAsync();
        }
    }
}