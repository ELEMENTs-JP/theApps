@using theControls.Icons
@using theControls.Input
@using theControls.Modal

@inject ISqlDatabaseService sql
@inject IMessagingBusService msg
@inject ISecurityService sec

@implements IAsyncDisposable

@if (ItemType != null)
{
    <ModalForm @key="@(new Guid().ToSecureString())" Title="einen Eintrag verbinden"
               ShowTitleInButton="false"
               ButtonText="@ButtonTitle" Value=""
               OnOKClicked="@( async e => { await OnOK(); } )">
               <Icon>
            <SymbolIcon Symbol="Icon.Connect" CSS="" />
               </Icon>
        <ChildContent>
            <div class="d-flex flex-row border-bottom mb-3">
                <div class="vstack p-2 px-3">
                    <div class="text-secondary fw-bold">@ItemType.Name</div>
                    <small class="text-muted small">Verbindet einen Eintrag</small>
                </div>

                @if (RelatedItem != null)
                {
                    <div class="vr"></div>
                    <div class="vstack p-2 px-3">
                        <div class="text-secondary fw-bold">@RelatedItem.Title</div>
                        <small class="text-muted small">Verbundener Eintrag vom Typ: @RelatedItem.ItemType</small>
                    </div>

                    <div class="vr"></div>
                    <div class="vstack p-2 px-3">
                        <div class="text-secondary fw-bold">Verbindung</div>
                        <small class="text-muted small">Typ: @Association.ToSecureEnumString()</small>
                    </div>
                }

                @if (SelectedItem != null)
                {
                    <div class="vr"></div>
                    <div class="vstack p-2 px-3">
                        <div class="text-secondary fw-bold">@SelectedItem.Title</div>
                        <small class="text-muted small">zu verbindender Eintrag vom Typ: @SelectedItem.ItemType</small>
                    </div>
                }

                <div class="flex-fill vstack p-2 px-3">
                </div>
            </div>

    

            <div class="d-flex justify-content-center">
                <TextBox Type="FieldTyp.Search" Placeholder="nach Einträgen suchen"
                         ValueChanged="@( async e => { Matchcode = e; await Search(); })" />
            </div>

            @foreach (IDTO item in Context.Items)
            {
                <div class="row g-0 hover pointer rounded-2 p-1 my-2" @onclick="@( async e => { SelectedItem = item; })">
                    <div class="col-12 p-1">
                        @item.Title.ToSecureString()
                    </div>
                </div>
            }

      

        </ChildContent>
    </ModalForm>
}

@code {

    [Parameter]
    public IItemType ItemType { get; set; }

    [Parameter]
    public IDTO RelatedItem { get; set; }

    [Parameter]
    public string ButtonTitle { get; set; } = "Connect";

    private IDTO SelectedItem { get; set; }

    private IQueryContext Context { get; set; }

    // Fields
    private string Matchcode { get; set; } = string.Empty;

    [Parameter]
    public AssociationTyp Association { get; set; } = AssociationTyp.Association;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (ItemType != null)
        {
            Context = new QueryContext(sql, sec);
            Context.ItemType = this.ItemType;
        }
    }

    private async Task Search()
    {
        // Context
        if (Context == null)
        {
            return;
        }

        if (string.IsNullOrEmpty(this.Matchcode))
        {
            Context.Items.Clear();
            return;
        }

        IFilterParameter filter = new FilterParameter();
        filter.Matchcode = this.Matchcode;
        Context.Filter = filter;

        // Search 
        await Context.Search();
    }

    private async Task OnOK()
    {
        if (Context == null)
            return;

         if (RelatedItem == null)
            return;

        if (SelectedItem == null)
            return;

        if (RelatedItem != null)
        {
            if (this.Association == AssociationTyp.NULL)
            {
                return;    
            }
        }

        // Assign 
    
        await sql.Assign(this.RelatedItem, this.SelectedItem, this.Association);

        SelectedItem = null;

        // Message 
        AppMessage am = new AppMessage("ID", BusAction.Refresh, "Datensatz verbunden");
        msg.Publish(am);

        // Visual Update 
        await InvokeAsync(this.StateHasChanged);

    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            ItemType = null;
            RelatedItem = null;

            if (Context != null)
            {
                ((IDisposable)Context).Dispose();
                Context = null;
            }

        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : DISPOSE : BoardComp : " + ex.Message);
        }
    }
}
