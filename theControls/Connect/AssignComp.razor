@using theControls.Icons
@using theControls.Input
@using theControls.Modal

@inject ISqlDatabaseService sql
@inject IMessagingBusService msg
@inject ISecurityService sec
@inject ISearchService search

@implements IAsyncDisposable

@if (Item != null)
{
    <ModalForm @key="@(new Guid().ToSecureString())" Title="einen Eintrag verbinden"
               ShowTitleInButton="false"
               ButtonText="@ButtonTitle" Value=""
               OnOKClicked="@( async e => { await OnOK(); } )">
        <Icon>
            <SymbolIcon Symbol="Icon.Connect" CSS="" />
        </Icon>
        <ChildContent>
            <div class="d-flex flex-row border-bottom mb-3">

                @if (Item != null)
                {
                    <div class="vstack p-2 px-3">
                        <div class="text-secondary fw-bold">@Item.Title</div>
                        <small class="text-muted small">Verbundener Eintrag vom Typ: @Item.ItemType</small>
                    </div>

                    <div class="vr"></div>
                    <div class="vstack p-2 px-3">
                        <div class="text-secondary fw-bold">Verbindung</div>
                        <small class="text-muted small">Typ: @Association.ToSecureEnumString()</small>
                    </div>
                }

                @if (SelectedItem != null)
                {
                    <div class="vr"></div>
                    <div class="vstack p-2 px-3">
                        <div class="text-secondary fw-bold">@SelectedItem.Title</div>
                        <small class="text-muted small">zu verbindender Eintrag vom Typ: @SelectedItem.ItemType</small>
                    </div>
                }

                <div class="flex-fill vstack p-2 px-3">
                </div>
            </div>

            <div class="d-flex justify-content-center">
                <TextBox Type="FieldTyp.Search" Placeholder="nach Einträgen suchen"
                         ValueChanged="@( async e => { Matchcode = e; await Search(); })" />
            </div>

              @foreach (string it in Items.Select(se => se.ItemType).Distinct())
            {
                <div class="border-bottom fw-bold small text-secondary mt-2">
                    @it
                </div>

                @foreach (IDTO item in Items.Where(se => se.ItemType == it))
                {
                <div class="row g-0 hover pointer rounded-2 p-1 my-2" @onclick="@( async e => { SelectedItem = item; })">
                    <div class="col-1 p-1 text-muted small">
                        @item.ID
                    </div>
                    <div class="col p-1 fw-bold px-2">
                        @item.Title
                    </div>
                    <div class="col-2 p-1 small text-muted text-end">
                        @item.ItemType
                    </div>
                </div>
                }
            }

    

      

        </ChildContent>
    </ModalForm>
}

@code {

    [Parameter]
    public IDTO Item { get; set; }

    [Parameter]
    public string ButtonTitle { get; set; } = "Connect";

    private IDTO SelectedItem { get; set; }

    private List<IDTO> Items { get; set; } = new();

    // Fields
    private string Matchcode { get; set; } = string.Empty;

    [Parameter]
    public AssociationTyp Association { get; set; } = AssociationTyp.Connection;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

    }

    private async Task Search()
    {
        this.Items = await search.Search(this.Matchcode);
    }

    private async Task OnOK()
    {
        if (Item == null)
            return;

        if (SelectedItem == null)
            return;

        if (Item != null)
        {
            if (this.Association == AssociationTyp.NULL)
            {
                return;
            }
        }

        // Assign 
        await sql.Assign(this.Item, this.SelectedItem, this.Association);

        if (OnConnected.HasDelegate)
        {
            await OnConnected.InvokeAsync(this.SelectedItem);
        }

        SelectedItem = null;

        // Message
        AppMessage am = new AppMessage("ID", BusAction.Refresh, "Datensatz verbunden");
        msg.Publish(am);

        // Visual Update
        await InvokeAsync(this.StateHasChanged);

    }

    [Parameter]
    public EventCallback<IDTO> OnConnected { get; set; }


    public async ValueTask DisposeAsync()
    {
        try
        {
            Item = null;
            Items.Clear();

        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine("FAIL : DISPOSE : BoardComp : " + ex.Message);
        }
    }
}

