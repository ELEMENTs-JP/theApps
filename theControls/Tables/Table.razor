@using theControls.Icons
@using theInfrastructure
@inject IMessagingBusService bus

@inject NavigationManager nm

@if (Context != null)
{
    @if (Context.IsLoading == true)
    {
        <h1 class="placeholder-glow">
            <span class="placeholder col-12"></span>
        </h1>
    }
    else if (!Context.Items.Any())
    {
        <div class="text-center my-5 text-secondary">
            <SymbolIcon Symbol="Icon.Empty" />
        </div>
    }
    else
    {
        @if (Context.ItemType != null && Context.ItemType.Fields != null)
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <TableHeader Context="@Context" />
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (IDTO item in Context.Items)
                        {
                            <TableRow Context="@Context" Item="@item" />
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div>Context, ItemType oder Fields are empty</div>
        }
    }
}


@code {

    [Parameter]
    public IQueryContext Context { get; set; }

    protected override async Task OnInitializedAsync()
    {
        bus.OnMessage += OnMessageIncome;
    }

    private void OnMessageIncome(AppMessage msg)
    {
        if (msg.Action == BusAction.Selected)
        {
            // Logik: Prüfen ob Wechsel erlaubt...
            bool canChange = true;

            if (canChange)
            {
                // Wir nutzen den Reply-Kanal des Senders für eine Antwort-Message
                msg.Reply?.Invoke(new AppMessage(msg.Id, BusAction.ResponseOk));

                // Jetzt eigene Daten laden basierend auf msg.Id
                // ... LoadDetails(msg.Id);
            }
        }
    }
}
