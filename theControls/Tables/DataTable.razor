@inherits BaseList
@inject ILogger<Index> Logger
@inject NavigationManager nm

@if (Context != null && ItemType != null)
{
    @if (Context.ItemType != null && Context.ItemType.GetFields().Result != null)
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <TableHeader Context="@Context"
                                     OnSort="@( async e => { await Context.Search(); } )"
                                     IsRelated="@( (RelatedItem != null))" />
                    </tr>
                </thead>
                <tbody>
                    @if (Context.Items != null)
                    {
                        <Virtualize Items="Context.Items" Context="item" SpacerElement="tr" ItemSize="48">
                            <ItemContent>

                                @if (!string.IsNullOrEmpty(item["GroupName"]))
                                {
                                    <tr @key="@( "group_header_" + item["GroupName"])" 
                                        class="fw-bold text-secondary">
                                        <td colspan="100" class="p-2 border-bottom">
                                            <div class="d-flex align-items-center">
                                                <div class="pe-1">
                                                    <SymbolIcon Symbol="Icon.Gruppierung" />
                                                </div>
                                                <div class="px-1 flex-fill">
                                                    @item["GroupName"].ToSecureString()
                                                </div>
                                                <div class="px-1">

                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    <TableRow @key="@( "item_entry_" + item.GUID)"
                                              Context="@Context"
                                              Item="@item"
                                              IsRelated="@( (RelatedItem != null))" />
                                }

                            </ItemContent>
                            <Placeholder>
                                <tr>
                                    <td colspan="100" class="text-muted p-2">Lade Daten...</td>
                                </tr>
                            </Placeholder>
                        </Virtualize>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Empty.HasContent())
    {
        @if (!HasItems)
        {
            @Empty
        }
    }
}

@code {

    [Parameter]
    public RenderFragment Empty { get; set; }

    [Parameter]
    public string Matchcode { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }
}