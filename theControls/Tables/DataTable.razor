

@inherits BaseList
@inject ILogger<Index> Logger

@inject NavigationManager nm

@if (Context != null && ItemType != null)
{
    @if (Context.ItemType != null && Context.ItemType.GetFields().Result != null)
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <TableHeader Context="@Context" 
                            OnSort="@( async e => { await Context.Search();  } )"
                            IsRelated="@( (RelatedItem != null))"  />
                    </tr>
                </thead>
                <tbody>
                    @foreach (IDTO item in Context.Items)
                    {
                        <TableRow @key="@( "item_entry_" + item.GUID)" Context="@Context" Item="@item" IsRelated="@( (RelatedItem != null))" />
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Empty.HasContent())
    {
        @if (!HasItems)
        {
            @Empty
        }
    }
}


