@inject ILogger<Index> Logger
@inject NavigationManager nm

@if (ItemType != null)
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <TableHeader ItemType="@ItemType" OnSort="Sort" IsRelated="false" />
                </tr>
            </thead>
            <tbody>
                <Virtualize  Items="@Items" Context="item" SpacerElement="tr" ItemSize="48">
                    <ItemContent>

                        @if (!string.IsNullOrEmpty(item["GroupName"]))
                        {
                            <tr @key="@( "group_header_" + item["GroupName"])"
                                class="fw-bold text-secondary">
                                <td colspan="100" class="p-2 border-bottom">
                                    <div class="d-flex align-items-center">
                                        <div class="pe-1">
                                            <SymbolIcon Symbol="Icon.Gruppierung" />
                                        </div>
                                        <div class="px-1 flex-fill">
                                            @item["GroupName"].ToSecureString()
                                        </div>
                                        <div class="px-1">
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <TableRow @key="@( "item_entry_" + item.GUID)"
                                      OnConnect="@( async e => { await OnConnect.InvokeAsync(e); })" 
                                      OnDelete="@( async e => { await OnDelete.InvokeAsync(e); })" 
                                      OnUpdate="@( async e => { await OnUpdate.InvokeAsync(e); })" 
                                      OnDisconnect="@( async e => { await OnDisconnect.InvokeAsync(e); })"
                                      ItemType="@ItemType" Item="@item" IsRelated="false" />
                        }

                    </ItemContent>
                    <Placeholder>
                        <tr>
                            <td colspan="100" class="text-muted p-2">Lade Daten...</td>
                        </tr>
                    </Placeholder>
                </Virtualize>
            </tbody>
        </table>
    </div>

    @if (Empty.HasContent())
    {
        @if (Items.Count == 0)
        {
            @Empty
        }
    }
}

@code {

    [Parameter]
    public RenderFragment Empty { get; set; }

    [Parameter]
    public string Matchcode { get; set; } = string.Empty;

    [Parameter]
    public List<IDTO> Items { get; set; } = new();

    [Parameter]
    public IItemType ItemType { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }

    private async Task Sort()
    {
        if (OnSort.HasDelegate)
        {
            await OnSort.InvokeAsync("");
        }
    }

    [Parameter]
    public EventCallback<string> OnSort { get; set; }

    
    [Parameter]
    public EventCallback<IDTO> OnUpdate { get; set; }

    [Parameter]
    public EventCallback<IDTO> OnDisconnect { get; set; }

    [Parameter]
    public EventCallback<IDTO> OnConnect { get; set; }

    [Parameter]
    public EventCallback<IDTO> OnDelete { get; set; }
}