

@inherits BaseList
@inject ILogger<Index> Logger

@inject NavigationManager nm

@if (Context != null && ItemType != null)
{
    @if (Context.ItemType != null && Context.ItemType.GetFields().Result != null)
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <TableHeader Context="@Context" IsRelated="@( (RelatedItem != null))"  />
                    </tr>
                </thead>
                <tbody>
                    @foreach (IDTO item in Context.Items)
                    {
                        <TableRow Context="@Context" Item="@item" IsRelated="@( (RelatedItem != null))"  />
                    }
                </tbody>
            </table>
        </div>
    }
}


@code {

    [Parameter]
    public string Matchcode { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await Filter();
    }

    public async Task Filter()
    {
        await Context.Filter(this.Matchcode);
    }

}
