@using theControls.Essentials
@inject ILocalizationService loc
@inject ISqlDatabaseService sql

@if (Field != null)
{
    @if (Field.Typ == FieldTyp.Progress)
    {
        <ProgressBar Value="@Value" />
    }
    else if (Field.Typ == FieldTyp.Status)
    {
        <StatusBox Value="@Value" />
    }
    else if (Field.Typ == FieldTyp.Priority)
    {
        <PriorityBox Value="@Value" />
    }
    else if (Field.Typ == FieldTyp.CheckBox)
    {
        <BooleanBox Value="@Value" Field="@Field" />
    }
    else if (Field.Typ == FieldTyp.Select)
    {
        if (isLoading)
        {
            <div class="placeholder-glow">
                <span class="placeholder col-7"></span>
            </div>
        }
        else
        {

            @foreach (IDTO dto in this.Items)
            {
                <a class="px-1 text-nowrap text-truncate"
                   style="max-width:5rem;"
                   title="@dto.Title"
                   href="@( "/Item/" + dto.ItemType + "/" + dto.GUID )">
                    @(dto.Title.ToSecureString())
                </a>
            }
        }
    }
    else if (Field.Typ == FieldTyp.Password)
    {
        @("...")
    }
    else
    {
        @Text.ToFormat(this.Field.Formatierung)
    }
}

@code {

    [Parameter]
    public string Value { get; set; } = string.Empty;

    private string Text { get; set; } = string.Empty;

    [Parameter]
    public IField Field { get; set; }

    [Parameter]
    public IDTO Item { get; set; }

    List<IDTO> Items { get; set; } = new();

    bool isLoading { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        await Convert();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            await LoadBySelect();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadBySelect()
    {
        if (Field.Typ == FieldTyp.Select)
        {
            IQueryResult result = await sql.GetRelatedItems(Item, Field.ItemType, Field.Association);
            Items = result.Items;
        }

        isLoading = false;
    }

    public async Task Convert()
    {
        if (string.IsNullOrEmpty(Value))
        {
            Text = string.Empty;
            return;
        }

        switch (this.Field.Typ)
        {
            case FieldTyp.Date:
                {

                    Text = Value.ToSecureDateTime().ToString("dddd, dd. MMMM yyyy");
                    break;
                }
            case FieldTyp.DateTime:
                {
                    Text = Value.ToSecureDateTime().ToString("dddd, dd. MMMM yyyy - HH:mm");
                    break;
                }
            case FieldTyp.Time:
                {
                    Text = Value.ToSecureDateTime().ToString("HH:mm");
                    break;
                }
            case FieldTyp.CheckBox:
                {
                    break;
                }
            default:
                {
                    Text = Value.ToSecureString();
                    break;
                }
        }

        await Task.CompletedTask;
    }
}
