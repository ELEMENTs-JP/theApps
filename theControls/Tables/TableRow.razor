@using theControls.Icons


@inherits BaseRow

@if (Context != null)
{
    <tr class="row-hover" style="border-left:1px solid transparent;">
        <td class="text-muted" title="@Item.GUID">@(Item.ID.ToSecureString())</td>
        
        <td class="text-truncate" title="@Item.ItemType" style="max-width:15rem;">
            <a class="fw-bold pointer" 
                href="@( "/Item/" + Context.ItemType.Name + "/" + Item.GUID )">
                @(Item.Title.ToSecureString())</a>
        </td>

        @foreach (IField col in Context.ItemType.GetFields().Result.Where(f => f.Typ != FieldTyp.HR && f.OnTable == true))
        {
            <td class="@Helper.GetClassByDevice(col) align-items-center">
                <TableCell Value="@(Item[col.Column].ToSecureString())" Field="@col" />
            </td>
        }

        @if (IsRelated)
        {
            <td>
                <SymbolIcon Symbol="Icon.Disconnect" CSS="pointer hover"
                            OnClick="@( async  e => { await Disconnect(); })" />
            </td>
        }
    </tr>
}

