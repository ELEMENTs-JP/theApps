@inject NavigationManager nm

@if (Context != null)
{
    <tr class="pointer"
        @onclick="@( e => { nm.NavigateTo("/EditBox/Task/" + Item.GUID, false); })">

            <td class="text-muted">@(Item.ID.ToSecureString())</td>
            <td class="fw-bold">@(Item.Title.ToSecureString())</td>
        
            @foreach (IField col in Context.ItemType.Fields.Where(f => f.Typ != FieldTyp.HR))
        {
            <td class="@( Helper.GetClassByDevice(col) )">@(Item[col.Column].ToSecureString())</td>
        }
    </tr>
}

@code {

    [Parameter]
    public IQueryContext Context { get; set; }

    [Parameter]
    public IDTO Item { get; set; }

}
