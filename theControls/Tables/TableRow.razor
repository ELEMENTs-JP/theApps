@using theControls.Audio
@using theControls.Icons
@using theControls.Image
@inherits BaseRow

@if (Item != null)
{
    <tr class="row-hover" style="border-left:1px solid transparent;">
        
        
        <td class="text-muted text-nowrap" title="@Item.GUID">@(Item.ID.ToSecureString())</td>

        @if (ItemType.Typ == ItemTypeTyp.User)
        {
            <td>
                <MinUserProfileImg @key="@Item.GUID" User="@Item" />
            </td>
        }
        @if (ItemType.Typ == ItemTypeTyp.Audio)
        {
            <td>
                <MiniAudioPlayer @key="@Item.GUID" Item="@Item" />
            </td>
        }

        @if (ItemType.Typ == ItemTypeTyp.Checklist)
        {
            <td>
            <CheckBox Value="@Item["IsChecked"]"
                      ValueChanged="@( async e => {  Item["IsChecked"] = e; await base.Update();  } )" />
            </td>
        }

        <td class="text-truncate" title="@Item.ItemType" style="max-width:15rem;">
            <div class="d-flex align-items-center gap-2">

                <a class="fw-bold pointer text-truncate flex-grow-1"
                   href="@( "/Item/" + ItemType.Name + "/" + Item.GUID )">
                    @(Item.Title.ToSecureString())
                </a>
         
            
            </div>
        </td>

        @foreach (IField col in ItemType.GetFields().Result.Where(f => f.Typ != FieldTyp.HR && f.OnDisplay.Table == true))
        {
            <td class="@Helper.GetClassByDevice(col) align-items-center">
                <TableCell @key="@( Item.GUID + col.Column + col.ItemType  )" 
                    Value="@(Item[col.Column].ToSecureString())" Field="@col" Item="@Item" />
            </td>
        }

        @if (IsRelated)
        {
            <td>
                <SymbolIcon Symbol="Icon.Disconnect" CSS="pointer hover"
                            OnClick="@( async  e => { await Disconnect(); })" />
            </td>
        }
    </tr>
}

@code {

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }

}
