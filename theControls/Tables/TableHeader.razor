@inject NavigationManager nm

@if (ItemType != null)
{
    <th scope="col" class="col-050">ID</th>

    @if (ItemType.Typ == ItemTypeTyp.User)
    {
        <th scope="col" class="col-050"></th>
    }
    @if (ItemType.Typ == ItemTypeTyp.Audio)
    {
        <th scope="col" class="col-050"></th>
    }
    @if (ItemType.Typ == ItemTypeTyp.Checklist)
    {
        <th scope="col" class="col-050"></th>
    }
    <th scope="col">Title</th>

    @foreach (IField col in ItemType.GetFields().Result.Where(f => f.Typ != FieldTyp.HR && f.OnDisplay.Table == true))
    {
        <th scope="col" class="@( Helper.GetClassByDevice(col) + " " )">

            <div class="d-flex align-items-center gap-2">
                @( col.Title)
                <Sortierung Field="@col" ItemType="@ItemType"
                            OnSort="@( async e => { await SortByColumn(e.Item1, e.Item2); })" />
            </div>

        
        </th>
    }

    @if (IsRelated)
    {
        <th class="min-col"></th>
    }
}

@code {

    [Parameter]
    public IItemType ItemType { get; set; }

    [Parameter]
    public bool IsRelated { get; set; } = false;

    [Parameter]
    public EventCallback<(ListSortDirection?, IField)> OnSort { get; set; }

    private async Task SortByColumn(ListSortDirection? dir, IField field)
    {
        // if (Context != null && Context.Filter != null)
        // {
        //     Context.Filter.Direction = dir;
        //     Context.Filter.SortColumn = field.Column;
        // }

        if (OnSort.HasDelegate)
        {
            await OnSort.InvokeAsync((dir, field));
        }

    }

}
