@inject NavigationManager nm

@if (Context != null)
{
    <th scope="col-050">ID</th>
    <th scope="col">Title</th>

    @foreach (IField col in Context.ItemType.Fields.Where(f => f.Typ != FieldTyp.HR))
    {
        <th scope="col" class="@(  Helper.GetClassByDevice(col) )">@( col.Title)</th>
    }

    @if (IsRelated)
    {
        <th class="min-col"></th>
    }
}

@code {

    [Parameter]
    public IQueryContext Context { get; set; }

    [Parameter]
    public bool IsRelated { get; set; } = false;


}
