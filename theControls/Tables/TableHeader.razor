@inject NavigationManager nm

@if (Context != null)
{
    <th scope="col-050">ID</th>

    @if (Context.ItemType.Typ == ItemTypeTyp.User)
    {
        <th scope="col"></th>
    }
    @if (Context.ItemType.Typ == ItemTypeTyp.Audio)
    {
        <th scope="col-050"></th>
    }

    <th scope="col">Title</th>

    @foreach (IField col in Context.ItemType.GetFields().Result.Where(f => f.Typ != FieldTyp.HR && f.OnDisplay.Table == true))
    {
        <th scope="col" class="@(  Helper.GetClassByDevice(col) )">@( col.Title)</th>
    }

    @if (IsRelated)
    {
        <th class="min-col"></th>
    }
}

@code {

    [Parameter]
    public IQueryContext Context { get; set; }

    [Parameter]
    public bool IsRelated { get; set; } = false;




}
