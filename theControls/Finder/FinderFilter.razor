@inject ILocalizationService loc
@inherits BaseCtl

@* --- FILTER DROP DOWN --- *@
<div class="w-100 dropdown-center my-1">
    <div class="@(" p-2 hover rounded-2 pointer align-items-center ")"
         data-bs-toggle="dropdown">
        <div class="d-flex">
            <div class="px-1">
                <SymbolIcon Symbol="Icon.Filter" />
            </div>
            <div class="flex-fill fw-bold px-1">
                Parameter
            </div>
        </div>
        <div class="text-muted small ps-4 ms-1">
            Parameter wählen...
        </div>
    </div>

    <div class="@( "dropdown-menu w-100")">

        <div class="d-flex align-items-center border-bottom">
            <div class="p-2">
                <SymbolIcon Symbol="Icon.Filter" />
            </div>
            <div class="flex-fill p-2 fw-bold">
                Properties
            </div>
        </div>

        @* --- App List --- *@
        <div class="overflow-y-auto" style="max-height:40rem;">

            @* Es geht um folgende TextBox *@
            <div class="p-2" @onclick:stopPropagation="true">
                <input type="text"
                       class="form-control form-control-sm"
                       placeholder="@loc.GetLabel("Suchen...", "find...")"
                       @bind="searchTerm"
                       @bind:event="oninput" />
            </div>

            <div class="px-2">

            @foreach (IField field in Fields)
            {
                <div class="d-flex p-1 hover pointer rounded-2 align-items-center">
                    <div class="flex-fill p-1">
                        @field.Title
                    </div>
                    <div class="p-1 px-2 text-muted">
                        @field.Typ.ToSecureString()
                    </div>
                    <div class="p-1 px-2 hover rounded pointer" @onclick="@( async e => { await Assign(field); })">
                        <SymbolIcon Symbol="Icon.Connect" />
                    </div>
                    <div class="p-1 px-2 hover rounded pointer" @onclick="@( async e => { await Remove(field); })">
                        <SymbolIcon Symbol="Icon.Disconnect" />
                    </div>
                </div>
            }
            </div>

        </div>
    </div>
</div>



@code {

    private string searchTerm = string.Empty;

    List<IField> Fields { get; set; } = new();


    [Parameter]
    public IQueryContext Context { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (Context != null && Context.Item != null)
        {
            IDTO item = Context.Item;
            string it = item["ItemType"].ToSecureString();
            if (!string.IsNullOrEmpty(it))
            {
                IItemType itemType = await new Factory(sql).BuildItemType(it);
                if (itemType != null)
                {
                    Fields = await itemType.GetFields();
                }
            }
        }
    }

    private async Task Assign(IField field)
    {
        IDTO Query = Context.Item;

        IQueryParameter qp = QueryParameter.Default(field.Title);
        qp.MasterGUID = sql.MasterGUID;
        qp.ItemType = "SearchFilter";

        IQueryResult result = await sql.Create(qp);
        IDTO filter = result.Items.FirstOrDefault();

        await sql.Assign(Query, filter, AssociationTyp.Children);

    }
    private async Task Remove(IField field)
    {
   
    }

}
