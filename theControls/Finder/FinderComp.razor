@inherits BaseCtl
@implements IDisposable

@if (Item != null && Context != null && Context.Item != null)
{

    <Frame>
        <Header>
            <ControlHeader PreTitle="Search" Title="FINDits" PostTitle="@Item.Title" />
        </Header>
        <Search>
            <FinderSearchComp OnSearch="@( async e => {  await Search(e); })" />
        </Search>
        <Content>

            <div class="row g-0" style="height:36rem;">
                <div class="col-3 px-2">

                    <EditBox Context="@Context" Border="false"
                        Field="@( Context.Fields.Find(se => se.Column == "Matchcode"))" />
                    <EditBox Context="@Context" Border="false"
                        Field="@( Context.Fields.Find(se => se.Typ == FieldTyp.ItemTypeList))" />

                    <FinderFilter Context="@Context" />

                    <FilterArea Context="@Context" />

                </div>
                <div class="col-6 px-2 border-start border-end overflow-y-auto h-100">
                    <div>
                        @foreach (IDTO Item in Items)
                        {
                            <div class="d-flex p-1 hover rounded" >
                                <div class="p-1 small text-muted">
                                    @Item.ID
                                </div>
                                <div class="py-1 px-2 flex-fill fw-bold hover rounded pointer" 
                                @onclick="@( e => { nm.NavToItem(Item.ItemType, Item.GUID);  })">
                                    @Item.Title
                                </div>
                                <div class="py-1 px-2 hover pointer rounded" 
                                    @onclick="@( e => { nm.NavToLibrary(Item.ItemType);  })">
                                    @Item.ItemType
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-3 px-2">
                </div>
            </div>

          

        </Content>
        <Bottom>
            <div class="row g-0">
                <div class="col-auto">

                </div>
                <div class="col">

                </div>
                <div class="col-auto">
                    <div class="btn btn-sm" @onclick="@( e => { nm.NavigateTo( "/Items/Query"); } )">
                        Suchanfragen verwalten...
                    </div>
                </div>
            </div>
        </Bottom>
    </Frame>

}


@code {

    [Parameter]
    public IDTO Item { get; set; }

    IQueryContext Context { get; set; }

    List<IDTO> Items { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        msg.OnMessage += OnMessageIncome;
    }
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        Context = new QueryContext(sql, sec, new ItemType_Query(), Item);

        await Init();
    }

    private async void OnMessageIncome(AppMessage message)
    {
        if (message.Id == "EditBox" && message.Action == BusAction.Refresh)
        {
            await Query();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task Init()
    {
        if (Context == null)
            return;

        if (Context.Item == null)
            return;

        await Query();
    }

    private async Task Search(string matchcode)
    {
        if (Context == null)
            return;

        if (Context.Item == null)
            return;

        // Query 
        Context.Item["Matchcode"] = matchcode.ToSecureString(); 
        await Context.Update(Context.Item);

        await Query();

    }

    private async Task Query()
    {
        IQueryParameter qp = QueryParameter.Default(".");
        qp.MasterGUID = sql.MasterGUID;
        qp.ItemType = Context.Item["ItemType"].ToSecureString();
        qp.Matchcode = Context.Item["Matchcode"].ToSecureString();

        IQueryResult result = await sql.GetItems(qp);
        this.Items = result.Items;

        // Filter
        List<IDTO> multipleFilter = await Context.Item.GetRelatedItems(sql, "SearchFilter");

        foreach (IDTO filter in multipleFilter)
        {
            string column = filter["Column"].ToSecureString();
            string typ = filter["Typ"].ToSecureString();
            string value = Context.Item[column].ToSecureString();

            if (typ == "Text")
            {
                this.Items = this.Items.Where(se => se[column].ToSecureString() == value).ToList();
            }
        }
    }

    public void Dispose()
    {
        try
        {
            msg.OnMessage -= OnMessageIncome;
        }
        catch (Exception ex)
        {

        }
    }
}
