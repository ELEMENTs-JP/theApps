@inherits BaseCtl



@foreach (IDTO prop in PropertyList.Where(se =>
    Helper.IsAllowedFieldTyp(se["Typ"].ToSecureString()) == true))
{
    <div class="border-bottom my-2"></div>
    <EditBox Context="@Context" Field="@(GetField(prop))" Border="false" />
}


@code {

    [Parameter]
    public IQueryContext Context { get; set; }

    List<IField> Fields { get; set; } = new();
    List<IDTO> PropertyList { get; set; } = new();

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        if (Context != null && Context.Item != null)
        {
            IDTO item = Context.Item;
            string it = item["ItemType"].ToSecureString();
            if (!string.IsNullOrEmpty(it))
            {
                IItemType itemType = await new Factory(sql).BuildItemType(it);
                if (itemType != null)
                {
                    // Fields fürs hinzufügen
                    Fields = await itemType.GetFields();

                    // hinzugefügte Felder für die Filterung
                    PropertyList = await item.GetRelatedItems(sql, "SearchFilter");
                }
            }
        }
    }

    private IField? GetField(IDTO dto)
    {
        string typ = dto["Typ"].ToSecureString();
        if (!string.IsNullOrEmpty(typ))
        {

            IField field = new Factory(sql).BuildField(typ);
            field.Title = dto.Title;
            field.Column = dto["Column"].ToString();

            return field;
        }
        return null;
    }
}
