@inject ILocalizationService loc
@inject NavigationManager nm
@inherits BaseCtl

@* --- FILTER DROP DOWN --- *@
<div class="w-100 dropdown-center my-1">
    <div class="@(" p-2 hover rounded-2 pointer align-items-center ")"
         data-bs-toggle="dropdown">
        <div class="d-flex">
            <div class="px-1">
                <SymbolIcon Symbol="Icon.Filter" />
            </div>
            <div class="flex-fill fw-bold px-1">
                FINDits
            </div>
        </div>
    </div>

    <div class="@( "dropdown-menu w-100 overflow-hidden")" style="min-width:18rem;">

        <div class="d-flex align-items-center border-bottom">
            <div class="flex-fill p-2 fw-bold">
                <div>
                    FINDits
                </div>
                <div class="small text-muted text-truncate text-nowrap">
                    Mit FINDits nach allem suchen und die Abfrage speichern
                </div>
            </div>
        </div>

        @* --- List --- *@
        <div class="overflow-y-auto p-1" style="max-height:40rem;">

            @* Es geht um folgende TextBox *@
            <div class="p-1" @onclick:stopPropagation="true">
                <input type="text"
                       class="form-control form-control-sm"
                       placeholder="@loc.GetLabel("Suchen...", "find...")"
                       @bind="searchTerm"
                       @bind:event="oninput" />
            </div>

            <div class="border-bottom border-top h-100 py-2 px-1">

                @foreach (IDTO item in Items)
                {
                    <div class="d-flex hover pointer rounded-2 py-1 px-2" 
                            @onclick="@( async e => { nm.NavigateTo($"/FINDits/{item.GUID}"); })">
                        <div class="flex-fill">
                            @item.Title
                        </div>
                    </div>    
                }

            </div>

            <div class="btn btn-sm btn-primary w-100"
                 @onclick="@( async e => { await CreateNewQuery();  })">
                neuen Filter erstellen
            </div>

        </div>
    </div>
</div>




@code {
    private string searchTerm = string.Empty;

    List<IDTO> Items { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await LoadItems();
    }

    private async Task LoadItems()
    {
        IQueryParameter qp = QueryParameter.Default(".");
        qp.MasterGUID = sql.MasterGUID;
        qp.ItemType = "Query";

        IQueryResult result = await sql.GetItems(qp);
        Items = result.Items;
    }

    private async Task CreateNewQuery()
    {
        IQueryParameter qp = QueryParameter.Default("neue Query");
        qp.MasterGUID = sql.MasterGUID;
        qp.ItemType = "Query";

        IQueryResult result = await sql.Create(qp);
        
        await LoadItems();

        nm.NavigateTo($"/FINDits/{qp.GUID}");
    }
}
