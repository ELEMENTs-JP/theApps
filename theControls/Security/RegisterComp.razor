@using Microsoft.AspNetCore.Components.Forms
@using theControls.Layout
@inject NavigationManager nm
@inject ISecurityService sec
@inject IJSRuntime js


<div class="container mt-5">
    <div class="card mx-auto" style="max-width: 400px;">
        <div class="card-body">
            <h2 class="h2 text-center fw-bold">Registrierung</h2>
            <div class="hr-text">Geschäftsaccount</div>
            <form action="/api/auth/register" method="post">
                <AntiforgeryToken />
                <div class="mb-3">
                    <label class="form-label">Mail</label>
                    <input id="input_txt_username" type="text" name="username" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Passwort</label>
                    <input type="password" name="password" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary w-100">Registrierung</button>
            </form>

            @if (nm.Uri.Contains("error"))
            {
                <div class="alert alert-danger mt-3">Zugriff verweigert!</div>
            }
        </div>
    </div>
</div>



@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            if (sec.Configuration.FocusOnLogin)
            {
                await js.InvokeVoidAsync("setFocusById", "input_txt_username");
            }
        }
    }
}
