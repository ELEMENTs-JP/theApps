@inject IMessagingBusService msg
@inject ILocalizationService loc
@inject ISecurityService sec
@inject ISqlDatabaseService sql

@if (Item != null)
{
    <ModalForm @key="@(new Guid().ToSecureString())"
               Title="@loc.GetLabel("Passwort setzen", "Set Password")"
               ShowTitleInButton="false" Mode="@Mode"
               ButtonText="@loc.GetLabel("Passwort setzen", "Set Password")" Size="ModalFormSize.Small"
               OnOKClicked="@( async e => { await SetPassword(); } )">
        <Icon>
            <SymbolIcon Symbol="Icon.Password" CSS="me-2 float-start" />
        </Icon>
        <ChildContent>

            @if (Mode == ModalRenderMode.Modal)
            {
                <div class="d-flex flex-row border-bottom mb-3">
                    <div class="vstack p-1">
                        <div class="text-secondary fw-bold">@Item.Title</div>
                        <small class="text-muted small">
                            @loc.GetLabel("Setzt das Passwort eines Nutzers", "Sets a user's password")
                        </small>
                    </div>

                    <div class="flex-fill vstack p-2 px-3">
                    </div>
                </div>
            }

            <div class="row g-0">

                @if (!string.IsNullOrEmpty(Message))
                {
                    <div class="col-12">
                        <div class="alert alert-danger my-2">@Message</div>
                    </div>
                }

                <div class="col-12">
                    <TextBox Label="@loc.GetLabel("neues Passwort", "new Password")" Value="@Pwd" Type="FieldTyp.Password"
                             ValueChanged="@( async e => { Pwd = e; Message = string.Empty; })"
                             Description="@loc.GetLabel("neues Passwort hier setzen", "Set a new password here")" />
                </div>

          
                @if (Mode == ModalRenderMode.Inline)
                {
                    <div class="row g-0">
                        <div class="col-auto p-2 ms-auto">
                            <div class="btn btn-sm btn-primary" @onclick="SetPassword">
                                Passwort jetzt setzen...
                            </div>
                        </div>
                    </div>
                }

            </div>
        </ChildContent>
    </ModalForm>
}


@code {


    // Fields
    private string Pwd { get; set; } = string.Empty;
    private string Message { get; set; } = string.Empty;

    [Parameter]
    public ModalRenderMode Mode { get; set; } = ModalRenderMode.Modal;

    [Parameter]
    public IDTO Item { get; set; } // Injection


    private async Task SetPassword()
    {
        Message = string.Empty;

        if (string.IsNullOrEmpty(Pwd))
        {
            Message = "Kein Passwort vergeben.";
            return;
        }

        if (Pwd.Length < sec.Configuration.PasswordSize)
        {
            Message = $"Passwort zu kurz. Mind. {sec.Configuration.PasswordSize} Zeichen";
            return;
        }


        if (Item == null)
            return;

        string hash = Encryption.HashPassword(Pwd);

        // Set Value
        Item["Password"] = hash;

        // Update
        await sql.Update(Item);

        // Info
        msg.Publish("", BusAction.Refresh, "Passwort geändert");
    }
}
