@page "/EditBox"



<div class="container">

    
    <div class="row">


        @foreach (FieldTyp field in Enum.GetValues(typeof(FieldTyp)))
        {
            <div class="col-12 col-md-6 col-lg-4 p-2">
                <EditBox Label="@field.ToString()" Type="@field"
                     Description="Hier steht eine kleine Beschreibung die einfach nur Text darstellen soll um zu sehen ob es ordentlich dargestellt wird." />
            </div>
        }

       
    </div>

</div>


